/* adc28 0.2 -- the RNL package of the ADC-12b-100M project, in RNL 0.4.
   Every netlist of RNL 0.4 in design/ and tb/ uses it in its header record:
     @USE-PACKAGE(name="adc28", version="0.2", path="<relative>/design/rnl/0.4/adc28.rnl")
   Netlists of RNL 0.3 use adc28 0.1, design/rnl/adc28.rnl, which has the same devices, rules
   and styles; keep the two in step until the last file of 0.3 is gone (docs/workflow.md).
   It brings the standard collection, the generated block / Verilog-A symbols, the terminal
   names and polarity of the 28 nm HPC+ devices (the model cards are not in the repository, so
   RNL cannot read them from there), the symbol rules of those devices and the project styles. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="adc28", version="0.2");
  @USE-PACKAGE(name="rnl-std-all", version="0.4");
  @USE-PACKAGE(name="adc28-blocks", version="0.2", path="adc28_blocks.rnl");
  @USE-PACKAGE(name="adc28-va", version="0.2", path="adc28_va.rnl");
  /* thin-oxide core MOS (0.9 V) */
  @DEVICE(name="*", model="nch_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_lvt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_ulvt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_hvt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_uhvt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_ehvt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_avt_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="nch_na_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="pch_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="pch_lvt_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="pch_ulvt_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="pch_hvt_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="pch_uhvt_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="pch_ehvt_mac", terminals=["d", "g", "s", "b"], type="pmos");
  /* thick-oxide 1.8 V MOS (reference driver only) */
  @DEVICE(name="*", model="nch_18_mac", terminals=["d", "g", "s", "b"], type="nmos");
  @DEVICE(name="*", model="pch_18_mac", terminals=["d", "g", "s", "b"], type="pmos");
  @DEVICE(name="*", model="nch_na18_mac", terminals=["d", "g", "s", "b"], type="nmos");
  /* passives */
  @DEVICE(name="*", model="cfmom_2t", terminals=["p", "n"]);
  @DEVICE(name="*", model="nmoscap", terminals=["p", "n"]);
  @DEVICE(name="*", model="nmoscap_18", terminals=["p", "n"]);
  @DEVICE(name="*", model="pmoscap", terminals=["p", "n"]);
  @DEVICE(name="*", model="pmoscap_18", terminals=["p", "n"])
}

@RNL {
  /* ---- supply and ground ports: every netlist of the project draws its supplies and grounds
     ($SUPPLY / $GROUND and the stubs), so the fill gives their port nets no port tag, as in
     RNL 0.3 ---- */
  $SUPPLY_NET_SET @REMOVE-FROM $PORT_FILL_SET;
  $GROUND_NET_SET @REMOVE-FROM $PORT_FILL_SET;

  /* ---- symbols of the PDK devices ---- */
  # @SELECT-INSTANCE(model="nch*_mac", recursive=true) => @SET-SYMBOL $NMOS_4TERM;
  # @SELECT-INSTANCE(model="pch*_mac", recursive=true) => @SET-SYMBOL $PMOS_4TERM;
  # @SELECT-INSTANCE(model="cfmom*", recursive=true) => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(model="*moscap*", recursive=true) => @SET-SYMBOL $CAPACITOR;

  /* ---- bus port: one port tag for a group of port nets, such as D13 .. D0 drawn as D<13:0>.
     Applied on the point of its pin: %bp = (x, y)(p) {&D13 ... &D0}(nets) @AS $BUS_PORT, and
     wired as {&D13 ... &D0} @WIRE {... %bp:p}. Its nets get no port tag of their own from
     rnl-std-fill. The tag shows the text with the key name: write the bus name there,
     %bp @TEXT("D<13:0>", key="name"), else it lists the nets. ---- */
  $BUS_PORT = @DEFINE(roles=[["p", "point"], ["{nets}", "net"]]) { ?nets @REMOVE-FROM $PORT_FILL_SET };
  $BUS_PORT_SYMBOL = @DEFINE-SYMBOL(box=[-1.4, -0.7, 0, 0.7]) {
    (0, 0) @PIN(terminal="p", direction="right");
    (-0.8, 0) @CIRCLE(radius=0.32, linewidth=0.24);
    @LINE(linewidth=0.32) {(0, 0) (-0.48, 0)};
    ? @TEXT("${nets}", key="name", halign="end", valign="middle") => @PLACE(-1.35, 0)
  };
  # @SELECT-USAGE(recursive=true) $BUS_PORT => @SET-SYMBOL $BUS_PORT_SYMBOL;

  /* ---- styles ---- */
  $title_style = @DEFINE-STYLE(textcolor="#1a365d", size=1.1, bold=true) {};
  $note_style = @DEFINE-STYLE(textcolor="#4a5568", size=0.75, italic=true) {};
  $param_style = @DEFINE-STYLE(textcolor="#4a5568", size=0.65) {};
  $table_style = @DEFINE-STYLE(linecolor="#a0aec0", textcolor="#2d3748", size=0.55) {};
  $analog_style = @DEFINE-STYLE(linecolor="#2b6cb0", textcolor="#2c5282") {};
  $digital_style = @DEFINE-STYLE(linecolor="#2f855a", textcolor="#276749") {};
  $clock_style = @DEFINE-STYLE(linecolor="#b7791f", textcolor="#975a16") {};
  $tb_style = @DEFINE-STYLE(linecolor="#718096", textcolor="#4a5568", linestyle="dashed") {};

  /* blocks by domain; the * also takes their Verilog-A views (adc_comp_va, adc_cdac_sw_va) */
  # @SELECT-INSTANCE(model="adc_cdac*", recursive=true) => @SET-STYLE $analog_style;
  # @SELECT-INSTANCE(model="adc_comp*", recursive=true) => @SET-STYLE $analog_style;
  # @SELECT-INSTANCE(model="adc_bootstrap*", recursive=true) => @SET-STYLE $analog_style;
  # @SELECT-INSTANCE(model="adc_ref*", recursive=true) => @SET-STYLE $analog_style;
  # @SELECT-INSTANCE(model="adc_ktc*", recursive=true) => @SET-STYLE $analog_style;
  # @SELECT-INSTANCE(model="adc_sarlogic*", recursive=true) => @SET-STYLE $digital_style;
  # @SELECT-INSTANCE(model="adc_clkgen*", recursive=true) => @SET-STYLE $clock_style;
  # @SELECT-INSTANCE(model="tb_*", recursive=true) => @SET-STYLE $tb_style
}
