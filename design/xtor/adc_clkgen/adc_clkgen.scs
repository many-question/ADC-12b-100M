// adc_clkgen transistor view: static CMOS, loaded-output interlocks.
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../rnl/adc28.rnl");
// }
simulator lang=spectre

// Sizes are total channel widths; each device's finger count is explicit.
// Primitive-cell schematics and top-level routing below are manually authored.
subckt adc_clkgen_inv (A Y VDD VSS)
parameters wn=400n wp=600n ln=30n lp=30n nn=2 np=2
MN (Y A VSS VSS) nch_ulvt_mac w=wn l=ln nf=nn
MP (Y A VDD VDD) pch_ulvt_mac w=wp l=lp nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MN #MP} @GROUP;
//   #MP @PLACE(0,4) => @ORIENT("R0");
//   #MN @PLACE(0,-4) => @ORIENT("R0");
//   %ga=(-6,0); %out=(0,0); %vp=(0,10); %vn=(0,-10);
//   $JUNCTION @ATTACH %ga; $JUNCTION @ATTACH %out;
//   %a=$IO_PORT @ATTACH &A => @PLACE(-12,0) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(9,0) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,12);
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-12);
//   &A @WIRE {%a:p %ga};
//   &A @WIRE {#MP:g (-6,4) %ga (-6,-4) #MN:g};
//   &Y @WIRE {#MP:d %out #MN:d};
//   &Y @WIRE {%out %y:p};
//   &VDD @WIRE {#MP:s %vp %v:p};
//   &VDD @WIRE {#MP:b (4,4) (4,10) %vp};
//   &VSS @WIRE {#MN:s %vn %g:p};
//   &VSS @WIRE {#MN:b (4,-4) (4,-10) %vn};
//   {#MN #MP} @TEXT("W=${w}, L=${l}, nf=${nf}", key="size", dx=6, dy=1, size=0.55);
//   (-12,16) @TEXT("Static CMOS inverter; explicit bulk ties", halign="start") => @SET-STYLE $title_style;
// }
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
//     @RECTANGLE {(-3.5,-2.5) (3.5,2.5)};
//     (-5,0) @PIN(terminal="A", direction="left");
//     @LINE {(-5,0) (-3.5,0)};
//     (5,0) @PIN(terminal="Y", direction="right");
//     @LINE {(3.5,0) (5,0)};
//     (0,4) @PIN(terminal="VDD", direction="up");
//     @LINE {(0,2.5) (0,4)};
//     (0,-4) @PIN(terminal="VSS", direction="down");
//     @LINE {(0,-2.5) (0,-4)};
//     (0,0.8) @TEXT("INV", size=0.65, halign="middle");
//     ? @TEXT("${wn}/${wp}", key="sizes", size=0.5, halign="middle") => @PLACE(0,-1.4);
//     ? @TEXT("${name}", key="name", size=0.6, halign="start") => @PLACE(-4,4.8);
//   };
//   # @SET-SYMBOL %symbol;
// }
ends adc_clkgen_inv

subckt adc_clkgen_nand2 (A B Y VDD VSS)
parameters wn=800n wp=600n nn=2 np=2
MNA (Y B nx VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (nx A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MNA #MNB} @AS $MATCHED;
//   {#MPA #MPB} @AS $MATCHED;
//   {#MNA #MNB #MPA #MPB} @GROUP;
//   #MPA @PLACE(-4,6) => @ORIENT("R0");
//   #MPB @PLACE(6,6) => @ORIENT("R0");
//   #MNA @PLACE(0,-2) => @ORIENT("R0");
//   #MNB @PLACE(0,-10) => @ORIENT("R0");
//   %a=$IO_PORT @ATTACH &A => @PLACE(-17,6) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-17,-2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(16,4) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,16);
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-18);
//   %a1=(-10,6); %b1=(-12,-2); %y1=(0,4); %v1=(-4,13); %v2=(6,13); %g1=(0,-16); %g2=(10,-10);
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %y1;
//   &A @WIRE {%a:p %a1 #MPA:g};
//   &A @WIRE {%a1 (-10,-10) #MNB:g};
//   &B @WIRE {%b:p %b1 #MNA:g};
//   &B @WIRE {%b1 (-12,11) (3,11) #MPB:g};
//   &Y @WIRE {#MPA:d %y1 #MPB:d %y:p};
//   &Y @WIRE {%y1 #MNA:d};
//   &nx @WIRE {#MNA:s #MNB:d};
//   &VDD @WIRE {#MPA:s %v1 (0,13) %v:p};
//   &VDD @WIRE {%v1 %v2 #MPB:s};
//   &VDD @WIRE {#MPA:b (-1,6) (-1,13) %v1};
//   &VDD @WIRE {#MPB:b (10,6) (10,13) %v2};
//   &VSS @WIRE {#MNB:s %g1 %g:p};
//   &VSS @WIRE {#MNA:b (10,-2) %g2 (10,-16) %g1};
//   &VSS @WIRE {#MNB:b %g2};
//   {#MNA #MNB #MPA #MPB} @TEXT("", key="model");
//   (-18,-22) @TEXT("MPA/MPB: pch_ulvt_mac, W=wp, L=30n, nf=np", halign="start", size=0.6);
//   (-18,-24) @TEXT("MNA/MNB: nch_ulvt_mac, W=wn, L=30n, nf=nn", halign="start", size=0.6);
//   (-18,20) @TEXT("NAND: immediate sample-off, conversion-off interlock", halign="start") => @SET-STYLE $title_style;
// }
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
//     @RECTANGLE {(-3.5,-2.5) (3.5,2.5)};
//     (-5,1) @PIN(terminal="A", direction="left");
//     @LINE {(-5,1) (-3.5,1)};
//     (-5,-1) @PIN(terminal="B", direction="left");
//     @LINE {(-5,-1) (-3.5,-1)};
//     (5,0) @PIN(terminal="Y", direction="right");
//     @LINE {(3.5,0) (5,0)};
//     (0,4) @PIN(terminal="VDD", direction="up");
//     @LINE {(0,2.5) (0,4)};
//     (0,-4) @PIN(terminal="VSS", direction="down");
//     @LINE {(0,-2.5) (0,-4)};
//     (0,0.8) @TEXT("NAND", size=0.65, halign="middle");
//     ? @TEXT("${wn}/${wp}", key="sizes", size=0.5, halign="middle") => @PLACE(0,-1.4);
//     ? @TEXT("${name}", key="name", size=0.6, halign="start") => @PLACE(-4,4.8);
//   };
//   # @SET-SYMBOL %symbol;
// }
ends adc_clkgen_nand2

subckt adc_clkgen_nor2 (A B Y VDD VSS)
parameters wn=1.2u wp=3.6u nn=2 np=4
MNA (Y A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (Y B VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (px A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (Y B px VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MNA #MNB} @AS $MATCHED;
//   {#MPA #MPB} @AS $MATCHED;
//   {#MNA #MNB #MPA #MPB} @GROUP;
//   #MPA @PLACE(0,10) => @ORIENT("R0");
//   #MPB @PLACE(0,2) => @ORIENT("R0");
//   #MNA @PLACE(-5,-6) => @ORIENT("R0");
//   #MNB @PLACE(5,-6) => @ORIENT("MY");
//   %a=$IO_PORT @ATTACH &A => @PLACE(-18,10) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-18,2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(12,-2) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,18);
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-17);
//   %a1=(-12,10); %b1=(-6,2); %y1=(0,-2); %v1=(0,16); %pb=(8,10); %g1=(-5,-12); %g2=(5,-12); %ng=(0,-12);
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %y1;
//   &A @WIRE {%a:p %a1 #MPA:g};
//   &A @WIRE {%a1 (-12,-6) #MNA:g};
//   &B @WIRE {%b:p %b1 #MPB:g};
//   &B @WIRE {%b1 (-6,22) (16,22) (16,-6) #MNB:g};
//   &px @WIRE {#MPA:d #MPB:s};
//   &Y @WIRE {#MPB:d %y1 %y:p};
//   &Y @WIRE {#MNA:d (-5,-2) %y1 (5,-2) #MNB:d};
//   &VDD @WIRE {#MPA:s %v1 %v:p};
//   &VDD @WIRE {#MPB:b (8,2) %pb (8,16) %v1};
//   &VDD @WIRE {#MPA:b %pb};
//   &VSS @WIRE {#MNA:s %g1 %ng %g2 #MNB:s};
//   &VSS @WIRE {%ng %g:p};
//   &VSS @WIRE {#MNA:b (-2,-6) (-2,-12) %g1};
//   &VSS @WIRE {#MNB:b (2,-6) (2,-12) %g2};
//   {#MNA #MNB #MPA #MPB} @TEXT("", key="model");
//   (-18,-22) @TEXT("MPA/MPB: pch_ulvt_mac, W=wp, L=30n, nf=np", halign="start", size=0.6);
//   (-18,-24) @TEXT("MNA/MNB: nch_ulvt_mac, W=wn, L=30n, nf=nn", halign="start", size=0.6);
//   (-18,26) @TEXT("NOR: CLK or PHI_B high forces conversion off", halign="start") => @SET-STYLE $title_style;
// }
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
//     @RECTANGLE {(-3.5,-2.5) (3.5,2.5)};
//     (-5,1) @PIN(terminal="A", direction="left");
//     @LINE {(-5,1) (-3.5,1)};
//     (-5,-1) @PIN(terminal="B", direction="left");
//     @LINE {(-5,-1) (-3.5,-1)};
//     (5,0) @PIN(terminal="Y", direction="right");
//     @LINE {(3.5,0) (5,0)};
//     (0,4) @PIN(terminal="VDD", direction="up");
//     @LINE {(0,2.5) (0,4)};
//     (0,-4) @PIN(terminal="VSS", direction="down");
//     @LINE {(0,-2.5) (0,-4)};
//     (0,0.8) @TEXT("NOR", size=0.65, halign="middle");
//     ? @TEXT("${wn}/${wp}", key="sizes", size=0.5, halign="middle") => @PLACE(0,-1.4);
//     ? @TEXT("${name}", key="name", size=0.6, halign="start") => @PLACE(-4,4.8);
//   };
//   # @SET-SYMBOL %symbol;
// }
ends adc_clkgen_nor2

subckt adc_clkgen_gatecap (A VDD VSS)
parameters wn=2u wp=3u ln=90n lp=90n nn=4 np=4
MN (VSS A VSS VSS) nch_ulvt_mac w=wn l=ln nf=nn
MP (VDD A VDD VDD) pch_ulvt_mac w=wp l=lp nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MN #MP} @GROUP;
//   #MP @PLACE(0,6) => @ORIENT("R0");
//   #MN @PLACE(0,-6) => @ORIENT("R0");
//   %a=$IO_PORT @ATTACH &A => @PLACE(-12,0) => @ORIENT("R0");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,15);
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-15);
//   %ga=(-6,0); %vp=(0,12); %vn=(0,-12);
//   $JUNCTION @ATTACH %ga; $JUNCTION @ATTACH %vp; $JUNCTION @ATTACH %vn;
//   &A @WIRE {%a:p %ga};
//   &A @WIRE {#MP:g (-6,6) %ga (-6,-6) #MN:g};
//   &VDD @WIRE {#MP:s %vp %v:p};
//   &VDD @WIRE {#MP:d (5,4) (5,12) %vp};
//   &VDD @WIRE {#MP:b (5,6)};
//   &VSS @WIRE {#MN:s %vn %g:p};
//   &VSS @WIRE {#MN:d (5,-4) (5,-12) %vn};
//   &VSS @WIRE {#MN:b (5,-6)};
//   {#MN #MP} @TEXT("", key="model");
//   (-12,20) @TEXT("Complementary MOS gate load; source, drain and body tied to rails", halign="start") => @SET-STYLE $title_style;
//   (-12,-19) @TEXT("MP: pch_ulvt_mac, W=wp, L=lp, nf=np", halign="start", size=0.6);
//   (-12,-21) @TEXT("MN: nch_ulvt_mac, W=wn, L=ln, nf=nn", halign="start", size=0.6);
// }
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
//     @RECTANGLE {(-3.5,-2.5) (3.5,2.5)};
//     (-5,0) @PIN(terminal="A", direction="left");
//     @LINE {(-5,0) (-3.5,0)};
//     (0,4) @PIN(terminal="VDD", direction="up");
//     @LINE {(0,2.5) (0,4)};
//     (0,-4) @PIN(terminal="VSS", direction="down");
//     @LINE {(0,-2.5) (0,-4)};
//     (0,0.8) @TEXT("LOAD", size=0.65, halign="middle");
//     ? @TEXT("${wn}/${wp}", key="sizes", size=0.5, halign="middle") => @PLACE(0,-1.4);
//     ? @TEXT("${name}", key="name", size=0.6, halign="start") => @PLACE(-4,4.8);
//   };
//   # @SET-SYMBOL %symbol;
// }
ends adc_clkgen_gatecap

subckt adc_clkgen (CLK PHI_S PHI_SB PHI_B PHI_BB CONV AVDD VSS)
// Sampling is inhibited until the loaded CONV output is low.
// Conversion is inhibited until both CLK and the loaded PHI_B output are low.
// Four physical inverter stages delay PHI_B relative to the loaded PHI_S.
// MOS gate loads slow internal edges without long-channel series resistance.
// CLK controls the lower NAND pull-down device to keep its internal node bounded.
XOFF (CONV coff AVDD VSS) adc_clkgen_inv wn=1.2u wp=1.8u nn=2 np=2
XSG (CLK coff sbar AVDD VSS) adc_clkgen_nand2 wn=800n wp=600n nn=2 np=2
XS1 (sbar s1 AVDD VSS) adc_clkgen_inv wn=1.2u wp=1.8u nn=2 np=2
XS2 (s1 s2 AVDD VSS) adc_clkgen_inv wn=2u wp=3u nn=4 np=4
XS3 (s2 PHI_S AVDD VSS) adc_clkgen_inv wn=8u wp=12u nn=8 np=12
XSB1 (sbar sb1 AVDD VSS) adc_clkgen_inv wn=600n wp=900n nn=2 np=2
XSB2 (sb1 PHI_SB AVDD VSS) adc_clkgen_inv wn=8u wp=12u nn=8 np=12
XB1 (PHI_S b1 AVDD VSS) adc_clkgen_inv wn=400n wp=600n nn=2 np=2
XB2 (b1 b2 AVDD VSS) adc_clkgen_inv wn=400n wp=600n nn=2 np=2
XB3 (b2 b3 AVDD VSS) adc_clkgen_inv wn=400n wp=600n nn=2 np=2
XB4 (b3 PHI_B AVDD VSS) adc_clkgen_inv wn=8u wp=4.8u nn=8 np=4
XBB1 (b3 bb1 AVDD VSS) adc_clkgen_inv wn=800n wp=1.2u nn=2 np=2
XBB2 (bb1 PHI_BB AVDD VSS) adc_clkgen_inv wn=2.4u wp=3.6u nn=4 np=4
XCG (CLK PHI_B ce AVDD VSS) adc_clkgen_nor2 wn=600n wp=1.8u nn=2 np=2
XC1 (ce cb AVDD VSS) adc_clkgen_inv wn=1.2u wp=1.8u nn=2 np=2
XC2 (cb CONV AVDD VSS) adc_clkgen_inv wn=2.4u wp=3.6u nn=4 np=4
XCS1 (s1 AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCS2 (s1 AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCS3 (s1 AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCB1 (b1 AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCB2 (b2 AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCC1 (cb AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCC2 (cb AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCE1 (ce AVDD VSS) adc_clkgen_gatecap wn=2u wp=3u nn=4 np=4
XCS4 (s1 AVDD VSS) adc_clkgen_gatecap wn=400n wp=600n nn=2 np=2
XCO1 (coff AVDD VSS) adc_clkgen_gatecap wn=400n wp=600n nn=2 np=2
XCO2 (coff AVDD VSS) adc_clkgen_gatecap wn=400n wp=600n nn=2 np=2
XCE2 (ce AVDD VSS) adc_clkgen_gatecap wn=400n wp=600n nn=2 np=2
// @RNL {
//   &AVDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#XS1 #XS2 #XS3 #XSB1 #XSB2} @GROUP;
//   {#XB1 #XB2 #XB3 #XB4 #XBB1 #XBB2} @GROUP;
//   {#XCG #XC1 #XC2 #XOFF #XSG} @GROUP;
//   {#XCB1 #XCB2 #XCS1 #XCS2 #XCS3 #XCC1 #XCC2 #XCE1 #XCS4 #XCO1 #XCO2 #XCE2} @GROUP;
//   {#XS3 #XSB2} @AS $MATCHED;
//   #XOFF @PLACE(0,40) => @ORIENT("R0");
//   %v0=$SUPPLY @ATTACH &AVDD => @PLACE(0,48);
//   &AVDD @WIRE {#XOFF:VDD %v0:p};
//   %g0=$GROUND @ATTACH &VSS => @PLACE(0,32);
//   &VSS @WIRE {#XOFF:VSS %g0:p};
//   #XSG @PLACE(0,15) => @ORIENT("R0");
//   %v1=$SUPPLY @ATTACH &AVDD => @PLACE(0,23);
//   &AVDD @WIRE {#XSG:VDD %v1:p};
//   %g1=$GROUND @ATTACH &VSS => @PLACE(0,7);
//   &VSS @WIRE {#XSG:VSS %g1:p};
//   #XS1 @PLACE(20,15) => @ORIENT("R0");
//   %v2=$SUPPLY @ATTACH &AVDD => @PLACE(20,23);
//   &AVDD @WIRE {#XS1:VDD %v2:p};
//   %g2=$GROUND @ATTACH &VSS => @PLACE(20,7);
//   &VSS @WIRE {#XS1:VSS %g2:p};
//   #XS2 @PLACE(40,15) => @ORIENT("R0");
//   %v3=$SUPPLY @ATTACH &AVDD => @PLACE(40,23);
//   &AVDD @WIRE {#XS2:VDD %v3:p};
//   %g3=$GROUND @ATTACH &VSS => @PLACE(40,7);
//   &VSS @WIRE {#XS2:VSS %g3:p};
//   #XS3 @PLACE(60,15) => @ORIENT("R0");
//   %v4=$SUPPLY @ATTACH &AVDD => @PLACE(60,23);
//   &AVDD @WIRE {#XS3:VDD %v4:p};
//   %g4=$GROUND @ATTACH &VSS => @PLACE(60,7);
//   &VSS @WIRE {#XS3:VSS %g4:p};
//   #XSB1 @PLACE(20,-15) => @ORIENT("R0");
//   %v5=$SUPPLY @ATTACH &AVDD => @PLACE(20,-7);
//   &AVDD @WIRE {#XSB1:VDD %v5:p};
//   %g5=$GROUND @ATTACH &VSS => @PLACE(20,-23);
//   &VSS @WIRE {#XSB1:VSS %g5:p};
//   #XSB2 @PLACE(60,-15) => @ORIENT("R0");
//   %v6=$SUPPLY @ATTACH &AVDD => @PLACE(60,-7);
//   &AVDD @WIRE {#XSB2:VDD %v6:p};
//   %g6=$GROUND @ATTACH &VSS => @PLACE(60,-23);
//   &VSS @WIRE {#XSB2:VSS %g6:p};
//   #XB1 @PLACE(90,15) => @ORIENT("R0");
//   %v7=$SUPPLY @ATTACH &AVDD => @PLACE(90,23);
//   &AVDD @WIRE {#XB1:VDD %v7:p};
//   %g7=$GROUND @ATTACH &VSS => @PLACE(90,7);
//   &VSS @WIRE {#XB1:VSS %g7:p};
//   #XB2 @PLACE(110,15) => @ORIENT("R0");
//   %v8=$SUPPLY @ATTACH &AVDD => @PLACE(110,23);
//   &AVDD @WIRE {#XB2:VDD %v8:p};
//   %g8=$GROUND @ATTACH &VSS => @PLACE(110,7);
//   &VSS @WIRE {#XB2:VSS %g8:p};
//   #XB3 @PLACE(130,15) => @ORIENT("R0");
//   %v9=$SUPPLY @ATTACH &AVDD => @PLACE(130,23);
//   &AVDD @WIRE {#XB3:VDD %v9:p};
//   %g9=$GROUND @ATTACH &VSS => @PLACE(130,7);
//   &VSS @WIRE {#XB3:VSS %g9:p};
//   #XB4 @PLACE(150,15) => @ORIENT("R0");
//   %v10=$SUPPLY @ATTACH &AVDD => @PLACE(150,23);
//   &AVDD @WIRE {#XB4:VDD %v10:p};
//   %g10=$GROUND @ATTACH &VSS => @PLACE(150,7);
//   &VSS @WIRE {#XB4:VSS %g10:p};
//   #XBB1 @PLACE(130,-15) => @ORIENT("R0");
//   %v11=$SUPPLY @ATTACH &AVDD => @PLACE(130,-7);
//   &AVDD @WIRE {#XBB1:VDD %v11:p};
//   %g11=$GROUND @ATTACH &VSS => @PLACE(130,-23);
//   &VSS @WIRE {#XBB1:VSS %g11:p};
//   #XBB2 @PLACE(150,-15) => @ORIENT("R0");
//   %v12=$SUPPLY @ATTACH &AVDD => @PLACE(150,-7);
//   &AVDD @WIRE {#XBB2:VDD %v12:p};
//   %g12=$GROUND @ATTACH &VSS => @PLACE(150,-23);
