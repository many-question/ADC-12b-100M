subckt mq_cdac_ctl_l (IN HIB DVDD VREFN VSS)
M0N (HIB IN VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M0P (HIB IN DVDD DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
// @RNL {
//   {&IN &HIB &DVDD &VREFN &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   &VREFN @ADD-TO $GROUND_NET_SET;
