//   #XHCTL:HI @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &VREFP => @PLACE(-70, 31.2);
//   &VREFP @WIRE {#XHCTL:VREFP (-70, 28) %v1:p};
//   %g2 = $GROUND @ATTACH &VREFN => @PLACE(-72, 16.8);
//   &VREFN @WIRE {#XHCTL:VREFN (-72, 20) %g2:p};
//   %g3 = $GROUND @ATTACH &VSS => @PLACE(-68, 16.8);
//   &VSS @WIRE {#XHCTL:VSS (-68, 20) %g3:p};
//   #XLCTL @PLACE(-70, -26);
//   #XLCTL @ORIENT("R0");
//   #XLCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XLCTL:HI @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v4 = $SUPPLY @ATTACH &VREFP => @PLACE(-70, -18.8);
//   &VREFP @WIRE {#XLCTL:VREFP (-70, -22) %v4:p};
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(-72, -33.2);
//   &VREFN @WIRE {#XLCTL:VREFN (-72, -30) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(-68, -33.2);
//   &VSS @WIRE {#XLCTL:VSS (-68, -30) %g6:p};
//   #XDH @PLACE(-34, 24);
//   #XDH @ORIENT("R0");
//   #XDH:HI @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:EN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:ENB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:BP @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &VREFP => @PLACE(-34, 32.2);
