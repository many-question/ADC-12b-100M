//   %g8 = $GROUND @ATTACH &VREFN => @PLACE(-36, 15.8);
//   &VREFN @WIRE {#XDH:VREFN (-36, 19) %g8:p};
//   %g9 = $GROUND @ATTACH &VSS => @PLACE(-32, 15.8);
//   &VSS @WIRE {#XDH:VSS (-32, 19) %g9:p};
//   #CH @PLACE(14, 24) => @ORIENT("R270");
//   #CH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #CH:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #CPH @PLACE(60, 20);
//   #CPH @ORIENT("R0");
//   #CPH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   %g10 = $GROUND @ATTACH &VSS => @PLACE(60, 14.8);
//   &VSS @WIRE {#CPH:2 (60, 18) %g10:p};
//   #MSH @PLACE(2, 8);
//   #MSH @ORIENT("R0");
//   #MSH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #MSH:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
