//   %v10 = $SUPPLY @ATTACH &DVDD => @PLACE(-32, 32.2);
//   &DVDD @WIRE {#XDH:DVDD (-32, 29) %v10:p};
//   #CH @PLACE(14, 24) => @ORIENT("R270");
//   #CH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #CH:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
