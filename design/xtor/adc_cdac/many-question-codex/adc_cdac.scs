// Matched half-capacitor pair j=10
subckt mq_cdac_bit10 (VIN VG DH RL EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
// APGATE PMOS assist connects each bottom plate to VIN.
// Additional ENB NMOS sharing retains a common EQBUS.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv10
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=159
CPH (BH VSS) capacitor c=7.9682055e-15
MSH (BH VG VIN VSS) nch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv10
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=159
CPL (BL VSS) capacitor c=7.9682055e-15
MSL (BL VG VIN VSS) nch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
MEQ1 (BH APGATE VIN VREFP) pch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
MEQ2 (BL APGATE VIN VREFP) pch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
MSHAREH (BH ENB EQBUS VSS) nch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
MSHAREL (BL ENB EQBUS VSS) nch_ulvt_mac w=3.71e-06 l=3e-08 nf=2
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &VREFP @ADD-TO $SUPPLY_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   {#CH #CL} @AS $MATCHED;
