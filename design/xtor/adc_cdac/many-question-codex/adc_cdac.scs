//   &AN2 @WIRE {#MNA1:3 #MNA2:1};
//   &BP1 @WIRE {#MPB0:1 #MPB1:3};
//   &BP2 @WIRE {#MPB1:1 #MPB2:3};
//   %gn_bus = (64, -6);
//   $JUNCTION @ATTACH %gn_bus;
//   &GN @WIRE {#MNB0:1 (48, -6) %gn_bus (80, -6) #MNB2:1};
//   &GN @WIRE {#MNB1:1 %gn_bus #MPB2:1};
