// Matched half-capacitor pair j=9
subckt mq_cdac_bit9 (DH RL EN ENB TOP VREFP VREFN VSS DVDD)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv9
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=90
CPH (BH VSS) capacitor c=4.5103050e-15
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv9
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=90
CPL (BL VSS) capacitor c=4.5103050e-15
// @RNL {
//   {&DH &RL &EN &ENB &TOP &VREFP &VREFN &VSS &DVDD} @REMOVE-FROM $PORT_FILL_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
