//   &PON @WIRE {#MFPN:1 #MFPP:1};
//   &GP @WIRE {#MFPN:2 (131, 12) (131, 22) #MFPP:2};
//   %gp_bus = (16, 22);
//   $JUNCTION @ATTACH %gp_bus;
//   &GP @WIRE {#MPA0:1 (0, 22) %gp_bus (32, 22) #MPA2:1};
