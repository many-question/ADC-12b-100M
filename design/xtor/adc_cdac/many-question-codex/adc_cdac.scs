//   #XLCTL @PLACE(0, -18) => @ORIENT("R0");
//   #XDL @PLACE(19, -20) => @ORIENT("R0");
//   &LHIB @WIRE {#XLCTL:2 #XDL:1};
//   %j6 = (115, -18);
//   %j7 = (38, -18);
//   %j8 = (52, -18);
//   %j9 = (66, -18);
