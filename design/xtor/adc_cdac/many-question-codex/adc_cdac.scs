//   #M2N @ORIENT("R0");
//   #M2N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M2N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g9 = $GROUND @ATTACH &VREFN => @PLACE(48, -5.2);
//   &VREFN @WIRE {#M2N:3 (48, -2) %g9:p};
//   %g10 = $GROUND @ATTACH &VSS => @PLACE(51, -3.2);
//   &VSS @WIRE {#M2N:4 (51, 0) %g10:p};
//   #M2P @PLACE(48, 10);
//   #M2P @ORIENT("R0");
//   #M2P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M2P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
