// Matched half-capacitor pair j=8, weight 102
subckt mq_cdac_bit8 (VIN VG DH RL EN ENB TOP VREFP VREFN VSS)
// CP*: user-specified pre-layout estimate, 5% of each physical MOM unit to VSS.
// The second MOM terminal is its bottom plate; parallel multipliers are aggregated.
// Series tails add one unit parasitic at MID and one at B, not 5% of the equivalent half unit.
XHCTL (DH HHI VREFP VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHI VREFP VREFN VSS) mq_cdac_ctl_l
XDH (HHI EN ENB BH VREFP VREFN VSS) mq_cdac_drv8
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=51
CPH (BH VSS) capacitor c=2.5558395e-15
MSH (BH VG VIN VSS) nch_ulvt_mac w=1.19e-06 l=3e-08 nf=1
XDL (LHI EN ENB BL VREFP VREFN VSS) mq_cdac_drv8
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=51
CPL (BL VSS) capacitor c=2.5558395e-15
MSL (BL VG VIN VSS) nch_ulvt_mac w=1.19e-06 l=3e-08 nf=1
