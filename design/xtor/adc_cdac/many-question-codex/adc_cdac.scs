// Matched half-capacitor pair j=6
subckt mq_cdac_bit6 (DH RL EN ENB TOP VREFP VREFN VSS DVDD)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv6
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=16
CPH (BH VSS) capacitor c=8.018320e-16
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv6
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=16
CPL (BL VSS) capacitor c=8.018320e-16
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &VREFP @ADD-TO $SUPPLY_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   {#CH #CL} @AS $MATCHED;
//   {#XDH #XDL} @AS $MATCHED;
//   #XHCTL @PLACE(-70, 24);
//   #XHCTL @ORIENT("R0");
//   #XHCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XHCTL:HIB @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &DVDD => @PLACE(-70, 31.2);
//   &DVDD @WIRE {#XHCTL:DVDD (-70, 28) %v1:p};
//   %g2 = $GROUND @ATTACH &VREFN => @PLACE(-72, 16.8);
//   &VREFN @WIRE {#XHCTL:VREFN (-72, 20) %g2:p};
//   %g3 = $GROUND @ATTACH &VSS => @PLACE(-68, 16.8);
//   &VSS @WIRE {#XHCTL:VSS (-68, 20) %g3:p};
//   #XLCTL @PLACE(-70, -26);
//   #XLCTL @ORIENT("R0");
//   #XLCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XLCTL:HIB @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v4 = $SUPPLY @ATTACH &DVDD => @PLACE(-70, -18.8);
//   &DVDD @WIRE {#XLCTL:DVDD (-70, -22) %v4:p};
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(-72, -33.2);
//   &VREFN @WIRE {#XLCTL:VREFN (-72, -30) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(-68, -33.2);
//   &VSS @WIRE {#XLCTL:VSS (-68, -30) %g6:p};
//   #XDH @PLACE(-34, 24);
//   #XDH @ORIENT("R0");
//   #XDH:HIB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:EN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:ENB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
