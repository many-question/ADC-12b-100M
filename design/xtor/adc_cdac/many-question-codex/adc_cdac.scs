//   {&PHI_S &PHI_SB &AGATE &DVDD &VREFN &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   &VREFN @ADD-TO $GROUND_NET_SET;
//   #M0N @PLACE(8, 7) => @ORIENT("R0");
//   #M0N @SET-SYMBOL $NMOS;
//   #M0N @TEXT("ULVT 0.4u", key="model", size=1.05, dx=1.5, dy=-1);
//   #M0N @TEXT("M0N", key="name", size=1.1, dx=1.5, dy=1);
//   #M0P @PLACE(8, 21) => @ORIENT("R0");
