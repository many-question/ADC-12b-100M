//   %g6 = $GROUND @ATTACH &VSS => @PLACE(-68, -33.2);
//   &VSS @WIRE {#XLCTL:VSS (-68, -30) %g6:p};
//   #XDH @PLACE(-34, 24);
//   #XDH @ORIENT("R0");
//   #XDH:HIB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:EN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:ENB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDH:BP @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &VREFP => @PLACE(-36, 32.2);
//   &VREFP @WIRE {#XDH:VREFP (-36, 29) %v7:p};
//   %g8 = $GROUND @ATTACH &VREFN => @PLACE(-36, 15.8);
//   &VREFN @WIRE {#XDH:VREFN (-36, 19) %g8:p};
//   %g9 = $GROUND @ATTACH &VSS => @PLACE(-32, 15.8);
//   &VSS @WIRE {#XDH:VSS (-32, 19) %g9:p};
//   %v10 = $SUPPLY @ATTACH &DVDD => @PLACE(-32, 32.2);
//   &DVDD @WIRE {#XDH:DVDD (-32, 29) %v10:p};
//   #CH @PLACE(14, 24) => @ORIENT("R270");
//   #CH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #CH:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #CPH @PLACE(60, 20);
//   #CPH @ORIENT("R0");
//   #CPH:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
