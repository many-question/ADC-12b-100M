//   %j1 = (10, 0);
//   %j2 = (5, 0);
//   &HIB @WIRE {#M0N:1 %j1 #M0P:1};
//   &IN @WIRE {#M0N:2 (5, -7) %j2 (5, 7) #M0P:2};
//   &IN @WIRE {%j2 (-2, 0)};
//   &HIB @WIRE {%j1 (18, 0)};
//   (-2, 1) @TEXT("IN", size=1.05);
//   (18, 1) @TEXT("HIB", size=1.05);
//   %t3 = $GROUND @ATTACH &VREFN => @PLACE(10, -11);
//   &VREFN @WIRE {#M0N:3 %t3:p};
