// Reference-rail output driver j=11
subckt mq_cdac_drv11 (HIB EN ENB BP VREFP VREFN VSS DVDD)
// DVDD prelogic: PCOND = NOR(ENB,HIB); NOFF = NAND(EN,HIB).
// Reference-powered final inverters restore GP and GN to VREFP/VREFN.
// Actual current overlap, settling and device stress require measurement.
MPA0 (AP ENB DVDD DVDD) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MPA1 (PCOND HIB AP DVDD) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MNA0 (PCOND ENB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNA1 (PCOND HIB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB0 (NOFF EN DVDD DVDD) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB1 (NOFF HIB DVDD DVDD) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNB0 (NOFF EN BN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNB1 (BN HIB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MGPN (GP PCOND VREFN VSS) nch_mac w=4.575e-06 l=3e-08 nf=3
MGPP (GP PCOND VREFP VREFP) pch_mac w=6.86e-06 l=3e-08 nf=4
MGNN (GN NOFF VREFN VSS) nch_mac w=4.575e-06 l=3e-08 nf=3
MGNP (GN NOFF VREFP VREFP) pch_mac w=2.29e-06 l=3e-08 nf=2
MNOUT (BP GN VREFN VSS) nch_mac w=8.58e-06 l=3e-08 nf=6
MPOUT (BP GP VREFP VREFP) pch_mac w=1.716e-05 l=3e-08 nf=12
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &VREFP @ADD-TO $SUPPLY_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   {#MPA0 #MPA1 #MNA0 #MNA1} @GROUP;
//   {#MPB0 #MPB1 #MNB0 #MNB1} @GROUP;
//   {#MGPN #MGPP} @GROUP;
//   {#MGNN #MGNP} @GROUP;
//   {#MNOUT #MPOUT} @GROUP;
//   #MPA0 @PLACE(12, 40);
//   #MPA0 @ORIENT("R0");
//   #MPA0:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #MPA0:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &DVDD => @PLACE(12, 45.2);
//   &DVDD @WIRE {#MPA0:3 (12, 42) %v1:p};
//   %v2 = $SUPPLY @ATTACH &DVDD => @PLACE(15, 43.2);
//   &DVDD @WIRE {#MPA0:4 (15, 40) %v2:p};
//   #MPA1 @PLACE(12, 26);
//   #MPA1 @ORIENT("R0");
//   #MPA1:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #MPA1:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #MPA1:3 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   %v3 = $SUPPLY @ATTACH &DVDD => @PLACE(15, 29.2);
//   &DVDD @WIRE {#MPA1:4 (15, 26) %v3:p};
//   #MNA0 @PLACE(0, 2);
//   #MNA0 @ORIENT("R0");
//   #MNA0:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #MNA0:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g4 = $GROUND @ATTACH &VREFN => @PLACE(0, -3.2);
//   &VREFN @WIRE {#MNA0:3 (0, 0) %g4:p};
//   %g5 = $GROUND @ATTACH &VSS => @PLACE(3, -1.2);
//   &VSS @WIRE {#MNA0:4 (3, 2) %g5:p};
//   #MNA1 @PLACE(24, 2);
//   #MNA1 @ORIENT("R0");
//   #MNA1:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #MNA1:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g6 = $GROUND @ATTACH &VREFN => @PLACE(24, -3.2);
//   &VREFN @WIRE {#MNA1:3 (24, 0) %g6:p};
