//   &VREFP @WIRE {#M2P:3 (48, 12) %v11:p};
//   %v12 = $SUPPLY @ATTACH &VREFP => @PLACE(51, 13.2);
//   &VREFP @WIRE {#M2P:4 (51, 10) %v12:p};
//   &I0 @WIRE {#M0N:1 #M0P:1};
//   &IN @WIRE {#M0N:2 (-5, 0) (-5, 10) #M0P:2};
//   &I1 @WIRE {#M1N:1 #M1P:1};
//   &I0 @WIRE {#M1N:2 (19, 0) (19, 10) #M1P:2};
//   &HI @WIRE {#M2N:1 #M2P:1};
//   &I1 @WIRE {#M2N:2 (43, 0) (43, 10) #M2P:2};
//   %p_in = $IO_PORT @ATTACH &IN => @PLACE(-7, 0) => @ORIENT("R0");
//   &IN @WIRE {%p_in:p #M0N:2};
//   %p_hi = $IO_PORT @ATTACH &HI => @PLACE(48, 6) => @ORIENT("R270");
//   &HI @WIRE {%p_hi:p #M2N:1};
//   (-10, 32) @TEXT("Reference-domain command buffer H") => @SET-STYLE $title_style
// }
ends mq_cdac_ctl_h

// Conversion-enable buffer
subckt mq_cdac_enable (IN EN ENB VREFP VREFN VSS)
M0N (ENB IN VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
M0P (ENB IN VREFP VREFP) pch_mac w=8e-06 l=3e-08 nf=4
M1N (EN ENB VREFN VSS) nch_ulvt_mac w=2.4e-05 l=3e-08 nf=12
M1P (EN ENB VREFP VREFP) pch_ulvt_mac w=4.8e-05 l=3e-08 nf=24
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET; &VREFP @ADD-TO $SUPPLY_NET_SET;
//   {#M0N #M0P} @GROUP;
//   {#M1N #M1P} @GROUP;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g1 = $GROUND @ATTACH &VREFN => @PLACE(0, -5.2);
//   &VREFN @WIRE {#M0N:3 (0, -2) %g1:p};
//   %g2 = $GROUND @ATTACH &VSS => @PLACE(3, -3.2);
//   &VSS @WIRE {#M0N:4 (3, 0) %g2:p};
//   #M0P @PLACE(0, 10);
//   #M0P @ORIENT("R0");
//   #M0P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &VREFP => @PLACE(0, 15.2);
//   &VREFP @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &VREFP => @PLACE(3, 13.2);
//   &VREFP @WIRE {#M0P:4 (3, 10) %v4:p};
//   #M1N @PLACE(26, 0);
//   #M1N @ORIENT("R0");
//   #M1N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M1N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(26, -5.2);
//   &VREFN @WIRE {#M1N:3 (26, -2) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(29, -3.2);
//   &VSS @WIRE {#M1N:4 (29, 0) %g6:p};
//   #M1P @PLACE(26, 10);
//   #M1P @ORIENT("R0");
//   #M1P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M1P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &VREFP => @PLACE(26, 15.2);
//   &VREFP @WIRE {#M1P:3 (26, 12) %v7:p};
//   %v8 = $SUPPLY @ATTACH &VREFP => @PLACE(29, 13.2);
//   &VREFP @WIRE {#M1P:4 (29, 10) %v8:p};
//   &ENB @WIRE {#M0N:1 #M0P:1};
//   &IN @WIRE {#M0N:2 (-5, 0) (-5, 10) #M0P:2};
//   &EN @WIRE {#M1N:1 #M1P:1};
//   &ENB @WIRE {#M1N:2 (21, 0) (21, 10) #M1P:2};
//   %p_in = $IO_PORT @ATTACH &IN => @PLACE(-7, 0) => @ORIENT("R0");
//   &IN @WIRE {%p_in:p #M0N:2};
//   %p_en = $IO_PORT @ATTACH &EN => @PLACE(26, 6) => @ORIENT("R270");
//   &EN @WIRE {%p_en:p #M1N:1};
//   %p_enb = $IO_PORT @ATTACH &ENB => @PLACE(0, 6) => @ORIENT("R270");
//   &ENB @WIRE {%p_enb:p #M0N:1};
//   (-10, 32) @TEXT("Conversion-enable buffer") => @SET-STYLE $title_style
