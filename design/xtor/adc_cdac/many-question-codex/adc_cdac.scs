// Reference-domain command buffer L
subckt mq_cdac_ctl_l (IN HI VREFP VREFN VSS)
// The first PMOS uses a higher threshold than the output logic for the low-DVDD/high-reference condition.
M0N (I0 IN VREFN VSS) nch_ulvt_mac w=4e-07 l=3e-08 nf=1
M0P (I0 IN VREFP VREFP) pch_mac w=8e-07 l=3e-08 nf=1
M1N (HI I0 VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M1P (HI I0 VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET; &VREFP @ADD-TO $SUPPLY_NET_SET;
//   {#M0N #M0P} @GROUP;
//   {#M1N #M1P} @GROUP;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g1 = $GROUND @ATTACH &VREFN => @PLACE(0, -5.2);
//   &VREFN @WIRE {#M0N:3 (0, -2) %g1:p};
//   %g2 = $GROUND @ATTACH &VSS => @PLACE(3, -3.2);
//   &VSS @WIRE {#M0N:4 (3, 0) %g2:p};
//   #M0P @PLACE(0, 10);
//   #M0P @ORIENT("R0");
//   #M0P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &VREFP => @PLACE(0, 15.2);
//   &VREFP @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &VREFP => @PLACE(3, 13.2);
//   &VREFP @WIRE {#M0P:4 (3, 10) %v4:p};
//   #M1N @PLACE(24, 0);
//   #M1N @ORIENT("R0");
//   #M1N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M1N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(24, -5.2);
//   &VREFN @WIRE {#M1N:3 (24, -2) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(27, -3.2);
//   &VSS @WIRE {#M1N:4 (27, 0) %g6:p};
//   #M1P @PLACE(24, 10);
//   #M1P @ORIENT("R0");
//   #M1P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M1P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &VREFP => @PLACE(24, 15.2);
//   &VREFP @WIRE {#M1P:3 (24, 12) %v7:p};
//   %v8 = $SUPPLY @ATTACH &VREFP => @PLACE(27, 13.2);
//   &VREFP @WIRE {#M1P:4 (27, 10) %v8:p};
//   &I0 @WIRE {#M0N:1 #M0P:1};
//   &IN @WIRE {#M0N:2 (-5, 0) (-5, 10) #M0P:2};
//   &HI @WIRE {#M1N:1 #M1P:1};
//   &I0 @WIRE {#M1N:2 (19, 0) (19, 10) #M1P:2};
//   %p_in = $IO_PORT @ATTACH &IN => @PLACE(-7, 0) => @ORIENT("R0");
//   &IN @WIRE {%p_in:p #M0N:2};
//   %p_hi = $IO_PORT @ATTACH &HI => @PLACE(24, 6) => @ORIENT("R270");
//   &HI @WIRE {%p_hi:p #M1N:1};
//   (-10, 32) @TEXT("Reference-domain command buffer L") => @SET-STYLE $title_style
// }
ends mq_cdac_ctl_l

// Reference-domain command buffer H
subckt mq_cdac_ctl_h (IN HI VREFP VREFN VSS)
// The first PMOS uses a higher threshold than the output logic for the low-DVDD/high-reference condition.
M0N (I0 IN VREFN VSS) nch_ulvt_mac w=4e-07 l=3e-08 nf=1
M0P (I0 IN VREFP VREFP) pch_mac w=8e-07 l=3e-08 nf=1
M1N (I1 I0 VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M1P (I1 I0 VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
M2N (HI I1 VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M2P (HI I1 VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET; &VREFP @ADD-TO $SUPPLY_NET_SET;
//   {#M0N #M0P} @GROUP;
//   {#M1N #M1P} @GROUP;
//   {#M2N #M2P} @GROUP;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
