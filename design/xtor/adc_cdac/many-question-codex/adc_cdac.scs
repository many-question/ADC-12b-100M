// Matched half-capacitor pair j=3, weight 6
subckt mq_cdac_bit3 (VIN VG DH RL EN ENB TOP VREFP VREFN VSS)
// CP*: user-specified pre-layout estimate, 5% of each physical MOM unit to VSS.
// The second MOM terminal is its bottom plate; parallel multipliers are aggregated.
// Series tails add one unit parasitic at MID and one at B, not 5% of the equivalent half unit.
XHCTL (DH HHI VREFP VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHI VREFP VREFN VSS) mq_cdac_ctl_l
XDH (HHI EN ENB BH VREFP VREFN VSS) mq_cdac_drv3
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=3
CPH (BH VSS) capacitor c=1.503435e-16
MSH (BH VG VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
XDL (LHI EN ENB BL VREFP VREFN VSS) mq_cdac_drv3
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=3
CPL (BL VSS) capacitor c=1.503435e-16
MSL (BL VG VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET; &VREFP @ADD-TO $SUPPLY_NET_SET;
//   {#CH #CL} @AS $MATCHED;
//   {#MSH #MSL} @AS $MATCHED;
//   {#XDH #XDL} @AS $MATCHED;
//   #XHCTL @PLACE(-70, 24);
//   #XHCTL @ORIENT("R0");
//   #XHCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XHCTL:HI @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &VREFP => @PLACE(-70, 31.2);
//   &VREFP @WIRE {#XHCTL:VREFP (-70, 28) %v1:p};
//   %g2 = $GROUND @ATTACH &VREFN => @PLACE(-72, 16.8);
//   &VREFN @WIRE {#XHCTL:VREFN (-72, 20) %g2:p};
//   %g3 = $GROUND @ATTACH &VSS => @PLACE(-68, 16.8);
//   &VSS @WIRE {#XHCTL:VSS (-68, 20) %g3:p};
//   #XLCTL @PLACE(-70, -26);
//   #XLCTL @ORIENT("R0");
//   #XLCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
