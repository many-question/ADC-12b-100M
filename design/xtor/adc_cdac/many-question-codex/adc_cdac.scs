// Matched half-capacitor pair j=6
subckt mq_cdac_bit6 (DH RL EN ENB TOP VREFP VREFN VSS DVDD)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv6
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=16
CPH (BH VSS) capacitor c=8.018320e-16
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv6
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=16
CPL (BL VSS) capacitor c=8.018320e-16
