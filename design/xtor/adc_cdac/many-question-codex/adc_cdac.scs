subckt mq_cdac_cap_array (TOP BPH12 BPL12 BPH11 BPL11 BPH10 BPL10 BPH9 BPL9 BPH8 BPL8 BPH7 BPL7 BPH6 BPL6 BPH5 BPL5 BPH4 BPL4 BPH3 BPL3 BPH2 BPL2 BPH1 BPL1 BPH0 BPL0 MIDH7 MIDL7 MIDH2 MIDL2 MIDH0 MIDL0 VSS)
B12_CH (TOP BPH12) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=490
B12_CPH (BPH12 VSS) capacitor c=2.45561050e-14
B12_CL (TOP BPL12) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=490
B12_CPL (BPL12 VSS) capacitor c=2.45561050e-14
B11_CH (TOP BPH11) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=280
B11_CPH (BPH11 VSS) capacitor c=1.40320600e-14
B11_CL (TOP BPL11) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=280
B11_CPL (BPL11 VSS) capacitor c=1.40320600e-14
B10_CH (TOP BPH10) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=159
B10_CPH (BPH10 VSS) capacitor c=7.9682055e-15
B10_CL (TOP BPL10) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=159
B10_CPL (BPL10 VSS) capacitor c=7.9682055e-15
