// Reference-rail output driver j=11
subckt mq_cdac_drv11 (HIB EN ENB BP VREFP VREFN VSS DVDD)
// DVDD prelogic: PCOND = NOR(ENB,HIB); NOFF = NAND(EN,HIB).
// Reference-powered final inverters restore GP and GN to VREFP/VREFN.
// Actual current overlap, settling and device stress require measurement.
MPA0 (AP ENB DVDD DVDD) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MPA1 (PCOND HIB AP DVDD) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MNA0 (PCOND ENB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNA1 (PCOND HIB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB0 (NOFF EN DVDD DVDD) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB1 (NOFF HIB DVDD DVDD) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNB0 (NOFF EN BN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNB1 (BN HIB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MGPN (GP PCOND VREFN VSS) nch_mac w=4.575e-06 l=3e-08 nf=3
MGPP (GP PCOND VREFP VREFP) pch_mac w=6.86e-06 l=3e-08 nf=4
MGNN (GN NOFF VREFN VSS) nch_mac w=4.575e-06 l=3e-08 nf=3
MGNP (GN NOFF VREFP VREFP) pch_mac w=2.29e-06 l=3e-08 nf=2
MNOUT (BP GN VREFN VSS) nch_mac w=8.58e-06 l=3e-08 nf=6
MPOUT (BP GP VREFP VREFP) pch_mac w=1.716e-05 l=3e-08 nf=12
// @RNL {
//   {&HIB &EN &ENB &BP &VREFP &VREFN &VSS &DVDD} @REMOVE-FROM $PORT_FILL_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   &VREFN @ADD-TO $GROUND_NET_SET;
//   #MPA0 @PLACE(8, 32) => @ORIENT("R0");
