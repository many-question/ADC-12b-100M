// DVDD command buffer L
subckt mq_cdac_ctl_l (IN HIB DVDD VREFN VSS)
M0N (HIB IN VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M0P (HIB IN DVDD DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g1 = $GROUND @ATTACH &VREFN => @PLACE(0, -5.2);
//   &VREFN @WIRE {#M0N:3 (0, -2) %g1:p};
//   %g2 = $GROUND @ATTACH &VSS => @PLACE(3, -3.2);
//   &VSS @WIRE {#M0N:4 (3, 0) %g2:p};
//   #M0P @PLACE(0, 10);
//   #M0P @ORIENT("R0");
//   #M0P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &DVDD => @PLACE(0, 15.2);
//   &DVDD @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &DVDD => @PLACE(3, 13.2);
//   &DVDD @WIRE {#M0P:4 (3, 10) %v4:p};
//   &HIB @WIRE {#M0N:1 #M0P:1};
//   &IN @WIRE {#M0N:2 (-5, 0) (-5, 10) #M0P:2};
//   %p_in = $IO_PORT @ATTACH &IN => @PLACE(-7, 0) => @ORIENT("R0");
//   &IN @WIRE {%p_in:p #M0N:2};
//   %p_hib = $IO_PORT @ATTACH &HIB => @PLACE(0, 6) => @ORIENT("R270");
//   &HIB @WIRE {%p_hib:p #M0N:1};
//   (-10, 32) @TEXT("DVDD command buffer L") => @SET-STYLE $title_style
// }
ends mq_cdac_ctl_l

// DVDD command buffer H
subckt mq_cdac_ctl_h (IN HIB DVDD VREFN VSS)
M0N (I0 IN VREFN VSS) nch_ulvt_mac w=4e-07 l=3e-08 nf=1
M0P (I0 IN DVDD DVDD) pch_mac w=8e-07 l=3e-08 nf=1
M1N (HIB I0 VREFN VSS) nch_ulvt_mac w=2e-06 l=3e-08 nf=1
M1P (HIB I0 DVDD DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g1 = $GROUND @ATTACH &VREFN => @PLACE(0, -5.2);
//   &VREFN @WIRE {#M0N:3 (0, -2) %g1:p};
//   %g2 = $GROUND @ATTACH &VSS => @PLACE(3, -3.2);
//   &VSS @WIRE {#M0N:4 (3, 0) %g2:p};
//   #M0P @PLACE(0, 10);
//   #M0P @ORIENT("R0");
//   #M0P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &DVDD => @PLACE(0, 15.2);
//   &DVDD @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &DVDD => @PLACE(3, 13.2);
//   &DVDD @WIRE {#M0P:4 (3, 10) %v4:p};
//   #M1N @PLACE(26, 0);
//   #M1N @ORIENT("R0");
//   #M1N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M1N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(26, -5.2);
//   &VREFN @WIRE {#M1N:3 (26, -2) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(29, -3.2);
//   &VSS @WIRE {#M1N:4 (29, 0) %g6:p};
//   #M1P @PLACE(26, 10);
//   #M1P @ORIENT("R0");
//   #M1P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M1P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &DVDD => @PLACE(26, 15.2);
//   &DVDD @WIRE {#M1P:3 (26, 12) %v7:p};
//   %v8 = $SUPPLY @ATTACH &DVDD => @PLACE(29, 13.2);
//   &DVDD @WIRE {#M1P:4 (29, 10) %v8:p};
//   &I0 @WIRE {#M0N:1 #M0P:1};
//   &IN @WIRE {#M0N:2 (-5, 0) (-5, 10) #M0P:2};
//   &HIB @WIRE {#M1N:1 #M1P:1};
//   &I0 @WIRE {#M1N:2 (21, 0) (21, 10) #M1P:2};
//   %p_in = $IO_PORT @ATTACH &IN => @PLACE(-7, 0) => @ORIENT("R0");
//   &IN @WIRE {%p_in:p #M0N:2};
//   %p_hib = $IO_PORT @ATTACH &HIB => @PLACE(26, 6) => @ORIENT("R270");
//   &HIB @WIRE {%p_hib:p #M1N:1};
//   (-10, 32) @TEXT("DVDD command buffer H") => @SET-STYLE $title_style
// }
ends mq_cdac_ctl_h

// DVDD conversion-enable buffer
subckt mq_cdac_enable (IN EN ENB DVDD VREFN VSS)
M0N (ENB IN VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
M0P (ENB IN DVDD DVDD) pch_mac w=8e-06 l=3e-08 nf=4
M1N (EN ENB VREFN VSS) nch_ulvt_mac w=2.4e-05 l=3e-08 nf=12
M1P (EN ENB DVDD DVDD) pch_ulvt_mac w=4.8e-05 l=3e-08 nf=24
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   #M0N @PLACE(0, 0);
//   #M0N @ORIENT("R0");
//   #M0N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M0N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g1 = $GROUND @ATTACH &VREFN => @PLACE(0, -5.2);
//   &VREFN @WIRE {#M0N:3 (0, -2) %g1:p};
//   %g2 = $GROUND @ATTACH &VSS => @PLACE(3, -3.2);
//   &VSS @WIRE {#M0N:4 (3, 0) %g2:p};
//   #M0P @PLACE(0, 10);
//   #M0P @ORIENT("R0");
//   #M0P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &DVDD => @PLACE(0, 15.2);
//   &DVDD @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &DVDD => @PLACE(3, 13.2);
//   &DVDD @WIRE {#M0P:4 (3, 10) %v4:p};
//   #M1N @PLACE(26, 0);
//   #M1N @ORIENT("R0");
//   #M1N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M1N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(26, -5.2);
//   &VREFN @WIRE {#M1N:3 (26, -2) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(29, -3.2);
//   &VSS @WIRE {#M1N:4 (29, 0) %g6:p};
//   #M1P @PLACE(26, 10);
//   #M1P @ORIENT("R0");
//   #M1P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M1P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v7 = $SUPPLY @ATTACH &DVDD => @PLACE(26, 15.2);
//   &DVDD @WIRE {#M1P:3 (26, 12) %v7:p};
//   %v8 = $SUPPLY @ATTACH &DVDD => @PLACE(29, 13.2);
//   &DVDD @WIRE {#M1P:4 (29, 10) %v8:p};
//   &ENB @WIRE {#M0N:1 #M0P:1};
