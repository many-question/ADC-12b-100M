subckt mq_cdac_drv9 (HIB EN ENB BP VREFP VREFN VSS DVDD)
// DVDD prelogic: PCOND = NOR(ENB,HIB); NOFF = NAND(EN,HIB).
// Reference-powered final inverters restore GP and GN to VREFP/VREFN.
// Actual current overlap, settling and device stress require measurement.
MPA0 (AP ENB DVDD DVDD) pch_ulvt_mac w=1.47e-06 l=3e-08 nf=1
MPA1 (PCOND HIB AP DVDD) pch_ulvt_mac w=1.47e-06 l=3e-08 nf=1
MNA0 (PCOND ENB VREFN VSS) nch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MNA1 (PCOND HIB VREFN VSS) nch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MPB0 (NOFF EN DVDD DVDD) pch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MPB1 (NOFF HIB DVDD DVDD) pch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MNB0 (NOFF EN BN VSS) nch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MNB1 (BN HIB VREFN VSS) nch_ulvt_mac w=7.35e-07 l=3e-08 nf=1
MGPN (GP PCOND VREFN VSS) nch_mac w=1.47e-06 l=3e-08 nf=1
MGPP (GP PCOND VREFP VREFP) pch_mac w=2.2e-06 l=3e-08 nf=2
MGNN (GN NOFF VREFN VSS) nch_mac w=1.47e-06 l=3e-08 nf=1
MGNP (GN NOFF VREFP VREFP) pch_mac w=7.35e-07 l=3e-08 nf=1
MNOUT (BP GN VREFN VSS) nch_mac w=8.25e-06 l=3e-08 nf=6
MPOUT (BP GP VREFP VREFP) pch_mac w=1.65e-05 l=3e-08 nf=12
