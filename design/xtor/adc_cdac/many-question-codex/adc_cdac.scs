ends mq_cdac_enable

// Tristate nonoverlap driver j=12
subckt mq_cdac_drv12 (HI EN ENB BP VREFP VREFN VSS)
// GP = NAND(EN, HI, NOT(GN)); GN = NOR(ENB, HI, NOT(GP)).
// Feedback senses the opposite output-device gate; each turn-on waits for the opposite turn-off.
MPA0 (GP EN VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNA0 (GP EN AN1 VSS) nch_ulvt_mac w=8e-06 l=3e-08 nf=4
MPA1 (GP HI VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNA1 (AN1 HI AN2 VSS) nch_ulvt_mac w=8e-06 l=3e-08 nf=4
MPA2 (GP NOFF VREFP VREFP) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNA2 (AN2 NOFF VREFN VSS) nch_ulvt_mac w=8e-06 l=3e-08 nf=4
MPB0 (BP1 ENB VREFP VREFP) pch_ulvt_mac w=1.2e-05 l=3e-08 nf=6
MNB0 (GN ENB VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MPB1 (BP2 HI BP1 VREFP) pch_ulvt_mac w=1.2e-05 l=3e-08 nf=6
MNB1 (GN HI VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MPB2 (GN PON BP2 VREFP) pch_ulvt_mac w=1.2e-05 l=3e-08 nf=6
MNB2 (GN PON VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MFNN (NOFF GN VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MFNP (NOFF GN VREFP VREFP) pch_ulvt_mac w=8e-06 l=3e-08 nf=4
MFPN (PON GP VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MFPP (PON GP VREFP VREFP) pch_ulvt_mac w=8e-06 l=3e-08 nf=4
MNOUT (BP GN VREFN VSS) nch_ulvt_mac w=2e-05 l=3e-08 nf=10
MPOUT (BP GP VREFP VREFP) pch_ulvt_mac w=4e-05 l=3e-08 nf=20
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
