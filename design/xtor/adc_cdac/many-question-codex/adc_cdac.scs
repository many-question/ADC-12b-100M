// Tristate nonoverlap driver j=10
subckt mq_cdac_drv10 (HI EN ENB BP VREFP VREFN VSS)
// GP = NAND(EN, HI, NOT(GN)); GN = NOR(ENB, HI, NOT(GP)).
// Feedback senses the opposite output-device gate; each turn-on waits for the opposite turn-off.
MPA0 (GP EN VREFP VREFP) pch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MNA0 (GP EN AN1 VSS) nch_ulvt_mac w=2.6e-06 l=3e-08 nf=2
MPA1 (GP HI VREFP VREFP) pch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MNA1 (AN1 HI AN2 VSS) nch_ulvt_mac w=2.6e-06 l=3e-08 nf=2
MPA2 (GP NOFF VREFP VREFP) pch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MNA2 (AN2 NOFF VREFN VSS) nch_ulvt_mac w=2.6e-06 l=3e-08 nf=2
MPB0 (BP1 ENB VREFP VREFP) pch_ulvt_mac w=3.89e-06 l=3e-08 nf=2
MNB0 (GN ENB VREFN VSS) nch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MPB1 (BP2 HI BP1 VREFP) pch_ulvt_mac w=3.89e-06 l=3e-08 nf=2
MNB1 (GN HI VREFN VSS) nch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MPB2 (GN PON BP2 VREFP) pch_ulvt_mac w=3.89e-06 l=3e-08 nf=2
MNB2 (GN PON VREFN VSS) nch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MFNN (NOFF GN VREFN VSS) nch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MFNP (NOFF GN VREFP VREFP) pch_ulvt_mac w=2.6e-06 l=3e-08 nf=2
MFPN (PON GP VREFN VSS) nch_ulvt_mac w=1.3e-06 l=3e-08 nf=1
MFPP (PON GP VREFP VREFP) pch_ulvt_mac w=2.6e-06 l=3e-08 nf=2
MNOUT (BP GN VREFN VSS) nch_ulvt_mac w=6.48e-06 l=3e-08 nf=4
MPOUT (BP GP VREFP VREFP) pch_ulvt_mac w=1.2985e-05 l=3e-08 nf=7
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET; &VREFP @ADD-TO $SUPPLY_NET_SET;
//   {#MFNN #MFNP} @GROUP;
//   {#MFPN #MFPP} @GROUP;
//   {#MPA0 #MPA1 #MPA2 #MNA0 #MNA1 #MNA2} @GROUP;
//   {#MPB0 #MPB1 #MPB2 #MNB0 #MNB1 #MNB2} @GROUP;
//   {#MNOUT #MPOUT} @GROUP;
//   #MPA0 @PLACE(0, 26);
//   #MPA0 @ORIENT("R0");
//   #MPA0:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #MPA0:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &VREFP => @PLACE(0, 31.2);
