// Tristate nonoverlap driver j=6
subckt mq_cdac_drv6 (HI EN ENB BP VREFP VREFN VSS)
// GP = NAND(EN, HI, NOT(GN)); GN = NOR(ENB, HI, NOT(GP)).
// Feedback senses the opposite output-device gate; each turn-on waits for the opposite turn-off.
MPA0 (GP EN VREFP VREFP) pch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MNA0 (GP EN AN1 VSS) nch_ulvt_mac w=2.6e-07 l=3e-08 nf=1
MPA1 (GP HI VREFP VREFP) pch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MNA1 (AN1 HI AN2 VSS) nch_ulvt_mac w=2.6e-07 l=3e-08 nf=1
MPA2 (GP NOFF VREFP VREFP) pch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MNA2 (AN2 NOFF VREFN VSS) nch_ulvt_mac w=2.6e-07 l=3e-08 nf=1
MPB0 (BP1 ENB VREFP VREFP) pch_ulvt_mac w=3.9e-07 l=3e-08 nf=1
MNB0 (GN ENB VREFN VSS) nch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MPB1 (BP2 HI BP1 VREFP) pch_ulvt_mac w=3.9e-07 l=3e-08 nf=1
MNB1 (GN HI VREFN VSS) nch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MPB2 (GN PON BP2 VREFP) pch_ulvt_mac w=3.9e-07 l=3e-08 nf=1
MNB2 (GN PON VREFN VSS) nch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MFNN (NOFF GN VREFN VSS) nch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MFNP (NOFF GN VREFP VREFP) pch_ulvt_mac w=2.6e-07 l=3e-08 nf=1
MFPN (PON GP VREFN VSS) nch_ulvt_mac w=1.3e-07 l=3e-08 nf=1
MFPP (PON GP VREFP VREFP) pch_ulvt_mac w=2.6e-07 l=3e-08 nf=1
MNOUT (BP GN VREFN VSS) nch_ulvt_mac w=6.55e-07 l=3e-08 nf=1
MPOUT (BP GP VREFP VREFP) pch_ulvt_mac w=1.305e-06 l=3e-08 nf=1
