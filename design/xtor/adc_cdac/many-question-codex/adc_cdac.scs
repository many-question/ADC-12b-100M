//   #MNA1 @SET-SYMBOL $NMOS;
//   #MNA1 @TEXT("ULVT 1.3u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MNA1 @TEXT("MNA1", key="name", size=1.1, dx=1.5, dy=1);
//   #MPB0 @PLACE(0, -8) => @ORIENT("R0");
//   #MPB0 @SET-SYMBOL $PMOS;
//   #MPB0 @TEXT("ULVT 1.3u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MPB0 @TEXT("MPB0", key="name", size=1.1, dx=1.5, dy=1);
//   #MPB1 @PLACE(16, -8) => @ORIENT("R0");
//   #MPB1 @SET-SYMBOL $PMOS;
//   #MPB1 @TEXT("ULVT 1.3u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MPB1 @TEXT("MPB1", key="name", size=1.1, dx=1.5, dy=1);
//   #MNB0 @PLACE(8, -24) => @ORIENT("R0");
//   #MNB0 @SET-SYMBOL $NMOS;
//   #MNB0 @TEXT("ULVT 1.3u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MNB0 @TEXT("MNB0", key="name", size=1.1, dx=1.5, dy=1);
//   #MNB1 @PLACE(8, -32) => @ORIENT("R0");
//   #MNB1 @SET-SYMBOL $NMOS;
//   #MNB1 @TEXT("ULVT 1.3u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MNB1 @TEXT("MNB1", key="name", size=1.1, dx=1.5, dy=1);
