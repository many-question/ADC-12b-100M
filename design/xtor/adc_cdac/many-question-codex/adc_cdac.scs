// Reference-rail output driver j=12
subckt mq_cdac_drv12 (HIB EN ENB BP VREFP VREFN VSS DVDD)
// DVDD prelogic: PCOND = NOR(ENB,HIB); NOFF = NAND(EN,HIB).
// Reference-powered final inverters restore GP and GN to VREFP/VREFN.
// Actual current overlap, settling and device stress require measurement.
MPA0 (AP ENB DVDD DVDD) pch_ulvt_mac w=8e-06 l=3e-08 nf=4
MPA1 (PCOND HIB AP DVDD) pch_ulvt_mac w=8e-06 l=3e-08 nf=4
MNA0 (PCOND ENB VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNA1 (PCOND HIB VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MPB0 (NOFF EN DVDD DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MPB1 (NOFF HIB DVDD DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNB0 (NOFF EN BN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MNB1 (BN HIB VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
MGPN (GP PCOND VREFN VSS) nch_mac w=8e-06 l=3e-08 nf=4
MGPP (GP PCOND VREFP VREFP) pch_mac w=1.2e-05 l=3e-08 nf=6
MGNN (GN NOFF VREFN VSS) nch_mac w=8e-06 l=3e-08 nf=4
MGNP (GN NOFF VREFP VREFP) pch_mac w=4e-06 l=3e-08 nf=2
MNOUT (BP GN VREFN VSS) nch_mac w=1.5e-05 l=3e-08 nf=10
MPOUT (BP GP VREFP VREFP) pch_mac w=3e-05 l=3e-08 nf=20
// @RNL {
//   {&HIB &EN &ENB &BP &VREFP &VREFN &VSS &DVDD} @REMOVE-FROM $PORT_FILL_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   &VREFN @ADD-TO $GROUND_NET_SET;
//   #MPA0 @PLACE(8, 32) => @ORIENT("R0");
//   #MPA0 @SET-SYMBOL $PMOS;
//   #MPA0 @TEXT("ULVT 8u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MPA0 @TEXT("MPA0", key="name", size=1.1, dx=1.5, dy=1);
//   #MPA1 @PLACE(8, 24) => @ORIENT("R0");
//   #MPA1 @SET-SYMBOL $PMOS;
//   #MPA1 @TEXT("ULVT 8u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MPA1 @TEXT("MPA1", key="name", size=1.1, dx=1.5, dy=1);
//   #MNA0 @PLACE(0, 8) => @ORIENT("R0");
