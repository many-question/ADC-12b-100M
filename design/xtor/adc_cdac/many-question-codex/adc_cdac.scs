//   %j5 = (43, -16);
//   %j6 = (38, -16);
//   &GN @WIRE {#MGNN:1 %j5 #MGNP:1};
//   &NOFF @WIRE {#MGNN:2 (38, -23) %j6 (38, -9) #MGNP:2};
//   &NOFF @WIRE {%j4 %j6};
//   &GN @WIRE {%j5 (65, -16) (65, -18) #MNOUT:2};
//   %j7 = (76, 0);
//   &BP @WIRE {#MPOUT:1 %j7 #MNOUT:1};
