//   &VSS @WIRE {#MSH:4 (5, 8) %g11:p};
//   #XDL @PLACE(-34, -26);
//   #XDL @ORIENT("R0");
//   #XDL:HI @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDL:EN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDL:ENB @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDL:BP @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v12 = $SUPPLY @ATTACH &VREFP => @PLACE(-34, -17.8);
//   &VREFP @WIRE {#XDL:VREFP (-34, -21) %v12:p};
//   %g13 = $GROUND @ATTACH &VREFN => @PLACE(-36, -34.2);
//   &VREFN @WIRE {#XDL:VREFN (-36, -31) %g13:p};
//   %g14 = $GROUND @ATTACH &VSS => @PLACE(-32, -34.2);
