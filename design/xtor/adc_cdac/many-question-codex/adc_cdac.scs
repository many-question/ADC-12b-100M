//   (11.7, -34) @TEXT("EN", size=1.05, halign="end", valign="middle");
//   &ENB @WIRE {#XDL:3 (12, -37)};
//   (11.7, -37) @TEXT("ENB", size=1.05, halign="end", valign="middle");
