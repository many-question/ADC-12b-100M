//   #MPOUT @TEXT("MPOUT", key="name", size=1.1, dx=1.5, dy=1);
//   #MNOUT @PLACE(76, -18) => @ORIENT("R0");
//   #MNOUT @SET-SYMBOL $NMOS;
//   #MNOUT @TEXT("SVT 0.875u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MNOUT @TEXT("MNOUT", key="name", size=1.1, dx=1.5, dy=1);
//   &AP @WIRE {#MPA0:1 #MPA1:3};
//   (10, 28) @TEXT("AP", size=1.05);
//   %j1 = (8, 16);
//   &PCOND @WIRE {#MNA0:1 (0, 16) %j1 (16, 16) #MNA1:1};
//   &PCOND @WIRE {#MPA1:1 %j1};
//   #MGPN @PLACE(43, 9) => @ORIENT("R0");
//   #MGPN @SET-SYMBOL $NMOS;
//   #MGPN @TEXT("SVT 0.465u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MGPN @TEXT("MGPN", key="name", size=1.1, dx=1.5, dy=1);
//   #MGPP @PLACE(43, 23) => @ORIENT("R0");
//   #MGPP @SET-SYMBOL $PMOS;
//   #MGPP @TEXT("SVT 0.7u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MGPP @TEXT("MGPP", key="name", size=1.1, dx=1.5, dy=1);
//   %j2 = (43, 16);
//   %j3 = (38, 16);
//   &GP @WIRE {#MGPN:1 %j2 #MGPP:1};
//   &PCOND @WIRE {#MGPN:2 (38, 9) %j3 (38, 23) #MGPP:2};
//   &PCOND @WIRE {%j1 %j3};
//   &GP @WIRE {%j2 (65, 16) (65, 18) #MPOUT:2};
//   %j4 = (8, -16);
//   &NOFF @WIRE {#MPB0:1 (0, -16) %j4 (16, -16) #MPB1:1};
