subckt mq_cdac_enable (IN EN ENB DVDD VREFN VSS)
M0N (ENB IN VREFN VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
M0P (ENB IN DVDD DVDD) pch_mac w=8e-06 l=3e-08 nf=4
M1N (EN ENB VREFN VSS) nch_ulvt_mac w=2.4e-05 l=3e-08 nf=12
M1P (EN ENB DVDD DVDD) pch_ulvt_mac w=4.8e-05 l=3e-08 nf=24
