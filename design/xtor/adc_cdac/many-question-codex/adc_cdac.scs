//   (11.7, 16) @TEXT("EN", size=1.05, halign="end", valign="middle");
//   &ENB @WIRE {#XDH:3 (12, 13)};
//   (11.7, 13) @TEXT("ENB", size=1.05, halign="end", valign="middle");
