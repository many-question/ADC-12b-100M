//   #M0P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %v3 = $SUPPLY @ATTACH &VREFP => @PLACE(0, 15.2);
//   &VREFP @WIRE {#M0P:3 (0, 12) %v3:p};
//   %v4 = $SUPPLY @ATTACH &VREFP => @PLACE(3, 13.2);
//   &VREFP @WIRE {#M0P:4 (3, 10) %v4:p};
//   #M1N @PLACE(24, 0);
//   #M1N @ORIENT("R0");
//   #M1N:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #M1N:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   %g5 = $GROUND @ATTACH &VREFN => @PLACE(24, -5.2);
//   &VREFN @WIRE {#M1N:3 (24, -2) %g5:p};
//   %g6 = $GROUND @ATTACH &VSS => @PLACE(27, -3.2);
//   &VSS @WIRE {#M1N:4 (27, 0) %g6:p};
//   #M1P @PLACE(24, 10);
//   #M1P @ORIENT("R0");
//   #M1P:1 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   #M1P:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
