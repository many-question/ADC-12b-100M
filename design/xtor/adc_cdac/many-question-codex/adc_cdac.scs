// Matched half-capacitor pair j=5
subckt mq_cdac_bit5 (VIN VG DH RL EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
// APGATE PMOS assist connects each bottom plate to VIN.
// Additional ENB NMOS sharing retains a common EQBUS.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv5
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=9
CPH (BH VSS) capacitor c=4.510305e-16
MSH (BH VG VIN VSS) nch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv5
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=9
CPL (BL VSS) capacitor c=4.510305e-16
MSL (BL VG VIN VSS) nch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
MEQ1 (BH APGATE VIN VREFP) pch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
MEQ2 (BL APGATE VIN VREFP) pch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
MSHAREH (BH ENB EQBUS VSS) nch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
MSHAREL (BL ENB EQBUS VSS) nch_ulvt_mac w=2.1e-07 l=3e-08 nf=1
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   &VSS @ADD-TO $GROUND_NET_SET; &VREFN @ADD-TO $GROUND_NET_SET;
//   &VREFP @ADD-TO $SUPPLY_NET_SET;
//   &DVDD @ADD-TO $SUPPLY_NET_SET;
//   {#CH #CL} @AS $MATCHED;
//   {#MSH #MSL} @AS $MATCHED;
//   {#MEQ1 #MEQ2} @AS $MATCHED;
//   {#MSHAREH #MSHAREL} @AS $MATCHED;
//   {#XDH #XDL} @AS $MATCHED;
//   #XHCTL @PLACE(-70, 24);
//   #XHCTL @ORIENT("R0");
//   #XHCTL:IN @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XHCTL:HIB @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %v1 = $SUPPLY @ATTACH &DVDD => @PLACE(-70, 31.2);
//   &DVDD @WIRE {#XHCTL:DVDD (-70, 28) %v1:p};
//   %g2 = $GROUND @ATTACH &VREFN => @PLACE(-72, 16.8);
//   &VREFN @WIRE {#XHCTL:VREFN (-72, 20) %g2:p};
//   %g3 = $GROUND @ATTACH &VSS => @PLACE(-68, 16.8);
//   &VSS @WIRE {#XHCTL:VSS (-68, 20) %g3:p};
