//   #MGNN @SET-SYMBOL $NMOS;
//   #MGNN @TEXT("SVT 8u", key="model", size=1.05, dx=1.5, dy=-1);
//   #MGNN @TEXT("MGNN", key="name", size=1.1, dx=1.5, dy=1);
