//   #MSL @ORIENT("R0");
//   #MSL:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   #MSL:2 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #MSL:3 @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", rotate=90, dx=0, dy=-0.4);
//   %g16 = $GROUND @ATTACH &VSS => @PLACE(5, -45.2);
//   &VSS @WIRE {#MSL:4 (5, -42) %g16:p};
//   &HHI @WIRE {#XHCTL:HI (-52, 24) (-52, 26) #XDH:HI};
//   %b_H = (-12, 24);
//   $JUNCTION @ATTACH %b_H;
//   &BH @WIRE {#XDH:BP %b_H};
