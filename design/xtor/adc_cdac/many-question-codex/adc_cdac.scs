// Tristate nonoverlap driver j=11
subckt mq_cdac_drv11 (HI EN ENB BP VREFP VREFN VSS)
// GP = NAND(EN, HI, NOT(GN)); GN = NOR(ENB, HI, NOT(GP)).
// Feedback senses the opposite output-device gate; each turn-on waits for the opposite turn-off.
MPA0 (GP EN VREFP VREFP) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNA0 (GP EN AN1 VSS) nch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MPA1 (GP HI VREFP VREFP) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNA1 (AN1 HI AN2 VSS) nch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MPA2 (GP NOFF VREFP VREFP) pch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MNA2 (AN2 NOFF VREFN VSS) nch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MPB0 (BP1 ENB VREFP VREFP) pch_ulvt_mac w=6.86e-06 l=3e-08 nf=4
MNB0 (GN ENB VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB1 (BP2 HI BP1 VREFP) pch_ulvt_mac w=6.86e-06 l=3e-08 nf=4
MNB1 (GN HI VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MPB2 (GN PON BP2 VREFP) pch_ulvt_mac w=6.86e-06 l=3e-08 nf=4
MNB2 (GN PON VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MFNN (NOFF GN VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MFNP (NOFF GN VREFP VREFP) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MFPN (PON GP VREFN VSS) nch_ulvt_mac w=2.29e-06 l=3e-08 nf=2
MFPP (PON GP VREFP VREFP) pch_ulvt_mac w=4.575e-06 l=3e-08 nf=3
MNOUT (BP GN VREFN VSS) nch_ulvt_mac w=1.143e-05 l=3e-08 nf=6
MPOUT (BP GP VREFP VREFP) pch_ulvt_mac w=2.286e-05 l=3e-08 nf=12
