// Matched half-capacitor pair j=2
subckt mq_cdac_bit2 (VIN VG DH RL EN ENB TOP VREFP VREFN VSS PHI_S DVDD PHI_SB EQBUS APGATE)
// CP*: user-specified 5% bottom-plate estimate for every physical MOM unit, not extraction.
// Series tails retain one unit parasitic at MID and one at B.
// APGATE PMOS assist connects each bottom plate to VIN.
// MID-to-VIN transmission gates provide physical initialization during PHI_S.
// Additional ENB NMOS sharing retains a common EQBUS.
XHCTL (DH HHIB DVDD VREFN VSS) mq_cdac_ctl_h
XLCTL (RL LHIB DVDD VREFN VSS) mq_cdac_ctl_l
XDH (HHIB EN ENB BH VREFP VREFN VSS DVDD) mq_cdac_drv2
CH (TOP BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPH (BH VSS) capacitor c=5.01145e-17
CHA (TOP MIDH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPHA (MIDH VSS) capacitor c=5.01145e-17
CHB (MIDH BH) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPHB (BH VSS) capacitor c=5.01145e-17
MSH (BH VG VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
XDL (LHIB EN ENB BL VREFP VREFN VSS DVDD) mq_cdac_drv2
CL (TOP BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPL (BL VSS) capacitor c=5.01145e-17
CLA (TOP MIDL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPLA (MIDL VSS) capacitor c=5.01145e-17
CLB (MIDL BL) cfmom_2t w=5e-08 s=2.4e-07 nr=6 lr=1.69e-06 stm=2 spm=4 multi=1
CPLB (BL VSS) capacitor c=5.01145e-17
MSL (BL VG VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MEQ1 (BH APGATE VIN VREFP) pch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MEQ2 (BL APGATE VIN VREFP) pch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MMIDNH (MIDH PHI_S VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MMIDPH (MIDH PHI_SB VIN VREFP) pch_mac w=1.2e-07 l=3e-08 nf=1
MMIDNL (MIDL PHI_S VIN VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MMIDPL (MIDL PHI_SB VIN VREFP) pch_mac w=1.2e-07 l=3e-08 nf=1
MSHAREH (BH ENB EQBUS VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
MSHAREL (BL ENB EQBUS VSS) nch_ulvt_mac w=1.2e-07 l=3e-08 nf=1
