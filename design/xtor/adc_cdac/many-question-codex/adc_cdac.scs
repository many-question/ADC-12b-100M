//   &PHI_S @WIRE {%p_phi_s:p #M0N:2};
//   %p_phi_sb = $IO_PORT @ATTACH &PHI_SB => @PLACE(150, -6) => @ORIENT("R90");
//   &PHI_SB @WIRE {%p_phi_sb:p #MNPASS:3};
//   %p_agate = $IO_PORT @ATTACH &AGATE => @PLACE(150, 6) => @ORIENT("R270");
//   &AGATE @WIRE {%p_agate:p #MNPASS:1};
//   (-10, 36) @TEXT("Physical sampling-entry assistance pulse") => @SET-STYLE $title_style
// }
ends mq_cdac_assist_pulse

// CDAC: split-supply drivers and physical sampling switches
subckt adc_cdac (VIN VG TOP VCM VREFP VREFN PHI_S PHI_SB CONV DH12 DH11 DH10 DH9 DH8 DH7 DH6 DH5 DH4 DH3 DH2 DH1 DH0 RL12 RL11 RL10 RL9 RL8 RL7 RL6 RL5 RL4 RL3 RL2 RL1 RL0 DVDD VSS)
// ENB controls NMOS sharing; APGATE controls PMOS VIN assistance.
// Non-sampled j9 and j6 remain reference-driven during sampling.
// The top-plate transmission gate is driven directly by PHI_S/PHI_SB.
// Experimental dummy NMOS: D/S tied to TOP, gate PHI_SB; added hold capacitance and clock load require verification.
XEN (CONV EN ENB DVDD VREFN VSS) mq_cdac_enable
XAPULSE (PHI_S PHI_SB APGATE DVDD VREFN VSS) mq_cdac_assist_pulse
MTN (TOP PHI_S VCM VSS) nch_ulvt_mac w=1.2e-05 l=3e-08 nf=6
MTP (TOP PHI_SB VCM DVDD) pch_ulvt_mac w=4e-06 l=3e-08 nf=2
MTD (TOP PHI_SB TOP VSS) nch_ulvt_mac w=4e-06 l=3e-08 nf=2
XB12 (VIN VG DH12 RL12 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit12
XB11 (VIN VG DH11 RL11 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit11
XB10 (VIN VG DH10 RL10 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit10
XB9 (DH9 RL9 DVDD VREFN TOP VREFP VREFN VSS DVDD) mq_cdac_bit9
XB8 (VIN VG DH8 RL8 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit8
XB7 (VIN VG DH7 RL7 EN ENB TOP VREFP VREFN VSS PHI_S DVDD PHI_SB EQBUS APGATE) mq_cdac_bit7
XB6 (DH6 RL6 DVDD VREFN TOP VREFP VREFN VSS DVDD) mq_cdac_bit6
XB5 (VIN VG DH5 RL5 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit5
XB4 (VIN VG DH4 RL4 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit4
XB3 (VIN VG DH3 RL3 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit3
XB2 (VIN VG DH2 RL2 EN ENB TOP VREFP VREFN VSS PHI_S DVDD PHI_SB EQBUS APGATE) mq_cdac_bit2
XB1 (VIN VG DH1 RL1 EN ENB TOP VREFP VREFN VSS DVDD EQBUS APGATE) mq_cdac_bit1
XB0 (VIN VG DH0 RL0 EN ENB TOP VREFP VREFN VSS PHI_S DVDD PHI_SB EQBUS APGATE) mq_cdac_bit0
