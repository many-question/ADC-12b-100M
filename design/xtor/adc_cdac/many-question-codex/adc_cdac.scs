//   &BH @WIRE {#XDH:4 (105, 20)};
//   (105, 22) @TEXT("BH", size=1.3);
//   (-8, 36) @TEXT("H reference / sampling switches", size=1.2);
//   #XLCTL @PLACE(0, -30) => @ORIENT("R0");
//   #XDL @PLACE(22, -32) => @ORIENT("R0");
//   &LHIB @WIRE {#XLCTL:2 #XDL:1};
