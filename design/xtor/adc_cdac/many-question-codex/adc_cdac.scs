//   &HI @WIRE {%p_hi:p #MPA1:2};
//   %p_en = $IO_PORT @ATTACH &EN => @PLACE(-7, 26) => @ORIENT("R0");
//   &EN @WIRE {%p_en:p #MPA0:2};
//   %p_enb = $IO_PORT @ATTACH &ENB => @PLACE(57, 26) => @ORIENT("R0");
//   &ENB @WIRE {%p_enb:p #MPB0:2};
