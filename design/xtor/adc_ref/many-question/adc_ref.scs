//   #CGATE @TEXT("CGATE", key="name", dx=-1.8, dy=0, size=0.7, halign="end");
//   #CREF0 @TEXT("CREF0", key="name", dx=1.5, dy=0, size=0.6, halign="start");
//   #CREF1 @TEXT("CREF1", key="name", dx=1.5, dy=0, size=0.6, halign="start");
//   (22, 21) @TEXT("Replica / 1x", size=0.9, bold=true);
//   (48, 21) @TEXT("Main / 28x", size=0.9, bold=true);
//   (14, 1) @TEXT("VREP", size=0.75);
