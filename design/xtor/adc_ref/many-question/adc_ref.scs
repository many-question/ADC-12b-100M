// adc_ref: native thick-oxide follower with a scaled replica servo
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../../rnl/adc28.rnl")
// }
simulator lang=spectre

// The replica includes the VCM divider load at one twenty-eighth of the main scale.
// All bias gates draw from VREF_IN; AVDD is reserved and unused in this view.
// The startup clamp inhibits drive while the reference is absent.
subckt adc_ref (VREF_IN VREFP VCM AVDD18 AVDD VSS)
XSERVO (VREF_IN VREP VG VREF_IN AVDD18 VSS) adc_ref_servo
XSTART (VREF_IN VG AVDD18 VSS) adc_ref_startup
MREP (AVDD18 VG VREP VSS) nch_na18_mac w=64u l=800n nf=32
MDRV (AVDD18 VG VREFP VSS) nch_na18_mac w=64u l=800n nf=32 multi=28
MSREP (VREP VREF_IN VSS VSS) nch_18_mac w=16u l=500n nf=8
MSINK (VREFP VREF_IN VSS VSS) nch_18_mac w=64u l=500n nf=32 multi=7
MCRH (CMR CMR VREP VREP) pch_lvt_mac w=4u l=120n nf=2
MCRL (VSS VSS CMR CMR) pch_lvt_mac w=4u l=120n nf=2
MCMH (VCM VCM VREFP VREFP) pch_lvt_mac w=8u l=120n nf=4 multi=14
MCML (VSS VSS VCM VCM) pch_lvt_mac w=8u l=120n nf=4 multi=14
CREF0 (VREFP VSS) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5
CREF1 (VREFP VSS) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5
CCM (VCM VSS) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5
CGATE (VG VSS) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5 multi=16
// @RNL {
//   {&AVDD18 &AVDD} @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MREP #MDRV} @AS $MATCHED;
//   {#MSREP #MSINK} @AS $MATCHED;
//   {#MCRH #MCRL} @AS $MATCHED;
//   {#MCMH #MCML} @AS $MATCHED;
//   {#MREP #MSREP #MCRH #MCRL} @GROUP;
//   {#MDRV #MSINK #MCMH #MCML #CREF0 #CREF1 #CCM} @GROUP;
//   {#MREP #MDRV #MSREP #MSINK} @SET-SYMBOL $NMOS;
//   {#MCRH #MCRL #MCMH #MCML} @SET-SYMBOL $PMOS_4TERM;
//   {#MREP #MDRV #MSREP #MSINK #MCRH #MCRL #MCMH #MCML #CREF0 #CREF1 #CCM #CGATE} @TEXT("", key="model");
//   #XSERVO @PLACE(0, 8) => @ORIENT("R0");
//   #XSTART @PLACE(-14, -20) => @ORIENT("R0");
//   #MREP @PLACE(22, 8) => @ORIENT("R0");
//   #MDRV @PLACE(48, 8) => @ORIENT("R0");
//   #MSREP @PLACE(22, -8) => @ORIENT("R0");
//   #MSINK @PLACE(48, -8) => @ORIENT("R0");
//   #MCRH @PLACE(34, -6) => @ORIENT("R0");
//   #MCRL @PLACE(34, -18) => @ORIENT("R0");
//   #MCMH @PLACE(72, -6) => @ORIENT("R0");
//   #MCML @PLACE(72, -18) => @ORIENT("R0");
//   #CREF0 @PLACE(58, -7) => @ORIENT("R0");
//   #CREF1 @PLACE(64, -7) => @ORIENT("R0");
//   #CCM @PLACE(84, -18) => @ORIENT("R0");
//   #CGATE @PLACE(40, 8) => @ORIENT("R0");
//   %pin = $IO_PORT @ATTACH &VREF_IN => @PLACE(-30, 9) => @ORIENT("R0");
//   %jin = (-24, 9); %jbias = (-12, 9); %jstart = (-24, -20); %jbr = (18, -34);
//   &VREF_IN @WIRE {%pin:p %jin %jbias #XSERVO:INP};
//   &VREF_IN @WIRE {%jbias (-12, 2) (-1, 2) #XSERVO:BIAS};
//   &VREF_IN @WIRE {%jin %jstart (-24, -34) %jbr (43, -34) (43, -8) #MSINK:g};
//   &VREF_IN @WIRE {%jstart #XSTART:REF};
//   &VREF_IN @WIRE {%jbr (18, -8) #MSREP:g};
//   %jg = (12, 8); %jgc = (40, 12);
//   &VG @WIRE {#XSERVO:OUT %jg #MREP:g};
//   &VG @WIRE {%jg (12, 12) %jgc (44, 12) (44, 8) #MDRV:g};
//   &VG @WIRE {%jg #XSTART:OUT};
//   &VG @WIRE {%jgc #CGATE:p};
//   %jr = (22, 0); %jrh = (34, -3);
//   &VREP @WIRE {#MREP:s %jr #MSREP:d};
//   &VREP @WIRE {%jr (34, 0) %jrh #MCRH:s};
//   &VREP @WIRE {%jrh (38, -3) (38, -6) #MCRH:b};
//   &VREP @WIRE {%jr (-8, 0) (-8, 7) #XSERVO:INN};
//   %jcmr = (34, -12); %jcmrb = (34, -15);
//   &CMR @WIRE {#MCRH:d %jcmr %jcmrb #MCRL:s};
//   &CMR @WIRE {%jcmr (29, -12) (29, -6) #MCRH:g};
//   &CMR @WIRE {%jcmrb (38, -15) (38, -18) #MCRL:b};
//   %jo = (48, 0); %jc0 = (58, 0); %jc1 = (64, 0); %jph = (72, 0); %jch = (72, -3);
//   %pout = $IO_PORT @ATTACH &VREFP => @PLACE(93, 0) => @ORIENT("MY");
//   &VREFP @WIRE {#MDRV:s %jo #MSINK:d};
//   &VREFP @WIRE {%jo %jc0 %jc1 %jph %pout:p};
//   &VREFP @WIRE {%jc0 #CREF0:p};
//   &VREFP @WIRE {%jc1 #CREF1:p};
//   &VREFP @WIRE {%jph %jch #MCMH:s};
//   &VREFP @WIRE {%jch (76, -3) (76, -6) #MCMH:b};
//   %jcm = (72, -12); %jcmb = (72, -15); %jccm = (84, -12);
//   %pcm = $IO_PORT @ATTACH &VCM => @PLACE(93, -12) => @ORIENT("MY");
//   &VCM @WIRE {#MCMH:d %jcm %jcmb #MCML:s};
//   &VCM @WIRE {%jcm (68, -12) (68, -6) #MCMH:g};
//   &VCM @WIRE {%jcmb (76, -15) (76, -18) #MCML:b};
//   &VCM @WIRE {%jcm %jccm %pcm:p};
//   &VCM @WIRE {%jccm #CCM:p};
//   %vh0 = $SUPPLY @ATTACH &AVDD18 => @PLACE(-1, 17) => @ORIENT("R0");
//   %vh1 = $SUPPLY @ATTACH &AVDD18 => @PLACE(22, 17) => @ORIENT("R0");
//   %vh2 = $SUPPLY @ATTACH &AVDD18 => @PLACE(48, 17) => @ORIENT("R0");
//   &AVDD18 @WIRE {%vh0:p #XSERVO:AVDD18};
//   &AVDD18 @WIRE {%vh1:p #MREP:d};
//   &AVDD18 @WIRE {%vh2:p #MDRV:d};
//   %gservo = $GROUND @ATTACH &VSS => @PLACE(5, 4) => @ORIENT("R0");
//   &VSS @WIRE {#XSERVO:VSS %gservo:p};
//   %gs0 = $GROUND @ATTACH &VSS => @PLACE(22, -13) => @ORIENT("R0");
//   %gs1 = $GROUND @ATTACH &VSS => @PLACE(48, -13) => @ORIENT("R0");
//   &VSS @WIRE {#MSREP:s %gs0:p};
//   &VSS @WIRE {#MSINK:s %gs1:p};
//   %gd0 = $GROUND @ATTACH &VSS => @PLACE(34, -25) => @ORIENT("R0");
//   %gd1 = $GROUND @ATTACH &VSS => @PLACE(72, -25) => @ORIENT("R0");
//   %jd0 = (34, -23); %jd1 = (72, -23);
//   &VSS @WIRE {#MCRL:d %jd0 %gd0:p};
//   &VSS @WIRE {#MCRL:g (29, -18) (29, -23) %jd0};
//   &VSS @WIRE {#MCML:d %jd1 %gd1:p};
//   &VSS @WIRE {#MCML:g (67, -18) (67, -23) %jd1};
//   %gc0 = $GROUND @ATTACH &VSS => @PLACE(58, -13) => @ORIENT("R0");
//   %gc1 = $GROUND @ATTACH &VSS => @PLACE(64, -13) => @ORIENT("R0");
//   %gcm = $GROUND @ATTACH &VSS => @PLACE(84, -25) => @ORIENT("R0");
//   &VSS @WIRE {#CREF0:n %gc0:p};
//   &VSS @WIRE {#CREF1:n %gc1:p};
//   &VSS @WIRE {#CCM:n %gcm:p};
//   %ggate = $GROUND @ATTACH &VSS => @PLACE(40, 4) => @ORIENT("R0");
//   &VSS @WIRE {#CGATE:n %ggate:p};
//   %vstart = $SUPPLY @ATTACH &AVDD18 => @PLACE(-14, -3) => @ORIENT("R0");
//   &AVDD18 @WIRE {%vstart:p #XSTART:AVDD18};
//   %gstart = $GROUND @ATTACH &VSS => @PLACE(-2, -36) => @ORIENT("R0");
//   &VSS @WIRE {#XSTART:VSS %gstart:p};
//   $JUNCTION @ATTACH {%jin %jbias %jstart %jbr %jg %jgc %jr %jrh %jcmr %jcmrb %jo %jc0 %jc1 %jph %jch %jcm %jcmb %jccm %jd0 %jd1};
//   #MREP @TEXT("64u/800n; nf32", key="size", dx=1, dy=-1.7, size=0.6, halign="start");
//   #MDRV @TEXT("64u/800n; nf32; x28", key="size", dx=1, dy=-1.7, size=0.6, halign="start");
//   #MSREP @TEXT("16u/500n; nf8", key="size", dx=1, dy=-1.7, size=0.6, halign="start");
//   #MSINK @TEXT("64u/500n; nf32; x7", key="size", dx=1, dy=-1.7, size=0.6, halign="start");
