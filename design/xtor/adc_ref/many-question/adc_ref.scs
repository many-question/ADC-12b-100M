//   (68, 19) @TEXT("AVDD: reserved, unused", halign="start", size=0.75);
//   (-22, -42) @TEXT("W/L in metres; W is total width per multiplier. Main divider: 8u/120n, nf4, x14; replica: 4u/120n, nf2.", halign="start", size=0.75);
//   (-22, -44) @TEXT("MOM: 80 fingers, 40u length, 50n width/space, layers 1..5. CGATE x16; other main-level capacitors x1.", halign="start", size=0.75)
// }
ends adc_ref

// Two-stage replica error amplifier. Positive input raises OUT.
subckt adc_ref_servo (INP INN OUT BIAS AVDD18 VSS)
MN1 (NB INP TAIL VSS) nch_18_mac w=8u l=1u nf=4
MN2 (NA INN TAIL VSS) nch_18_mac w=8u l=1u nf=4
MP1 (NB NA AVDD18 AVDD18) pch_18_mac w=8u l=1u nf=4 multi=4
MP2 (NA NA AVDD18 AVDD18) pch_18_mac w=8u l=1u nf=4 multi=4
MTAIL (TAIL BIAS VSS VSS) nch_18_mac w=8u l=1u nf=4
MPOUT (OUT NB AVDD18 AVDD18) pch_18_mac w=8u l=1u nf=4 multi=16
MNOUT (OUT BIAS VSS VSS) nch_18_mac w=8u l=1u nf=4
MZERO (NB VSS NZ AVDD18) pch_18_mac w=8u l=1u nf=4 multi=8
CC0 (NZ OUT) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5 multi=4
CC1 (NZ OUT) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5
CC2 (NZ OUT) cfmom_2t w=50n s=50n nr=80 lr=40u stm=1 spm=5
// @RNL {
//   &AVDD18 @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   %dp = #MN1(in_p) #MN2(in_n) {#MTAIL}(tail) @AS $DIFFERENTIAL_PAIR;
//   %mirror = {#MP2}(ref) {#MP1}(out) @AS $CURRENT_MIRROR;
//   {#MN1 #MN2} @AS $MATCHED;
//   {#MP1 #MP2} @AS $MATCHED;
//   {#MTAIL #MNOUT} @AS $MATCHED;
//   {#MN1 #MN2 #MP1 #MP2 #MTAIL} @GROUP;
//   {#MPOUT #MNOUT #MZERO #CC0 #CC1 #CC2} @GROUP;
//   {#MN1 #MN2 #MTAIL #MNOUT} @SET-SYMBOL $NMOS;
//   {#MP1 #MP2 #MPOUT #MZERO} @SET-SYMBOL $PMOS;
//   {#MN1 #MN2 #MTAIL #MNOUT #MP1 #MP2 #MPOUT #MZERO #CC0 #CC1 #CC2} @TEXT("", key="model");
//   #MN1 @PLACE(-10, 0) => @ORIENT("R0");
//   #MN2 @PLACE(10, 0) => @ORIENT("MY");
//   #MP1 @PLACE(-10, 12) => @ORIENT("MY");
//   #MP2 @PLACE(10, 12) => @ORIENT("R0");
//   #MTAIL @PLACE(0, -10) => @ORIENT("R0");
//   #MPOUT @PLACE(34, 12) => @ORIENT("R0");
//   #MNOUT @PLACE(34, -10) => @ORIENT("R0");
//   #CC0 @PLACE(20, 28) => @ORIENT("R90");
//   #CC1 @PLACE(20, 34) => @ORIENT("R90");
//   #CC2 @PLACE(20, 40) => @ORIENT("R90");
//   #MZERO @PLACE(0, 28) => @ORIENT("R270");
//   %pip = $IO_PORT @ATTACH &INP => @PLACE(-18, 0) => @ORIENT("R0");
//   %pin = $IO_PORT @ATTACH &INN => @PLACE(18, 0) => @ORIENT("MY");
//   %pout = $IO_PORT @ATTACH &OUT => @PLACE(44, 6) => @ORIENT("MY");
//   %pb = $IO_PORT @ATTACH &BIAS => @PLACE(-18, -10) => @ORIENT("R0");
//   &INP @WIRE {%pip:p #MN1:g};
//   &INN @WIRE {%pin:p #MN2:g};
//   %jnb = (-10, 6); %jna = (10, 6); %jmg = (0, 12); %jnb2 = (-16, 22);
//   &NB @WIRE {#MP1:d %jnb #MN1:d};
//   &NA @WIRE {#MP2:d %jna #MN2:d};
//   &NA @WIRE {#MP1:g %jmg #MP2:g};
//   &NA @WIRE {%jna (0, 6) %jmg};
//   &NB @WIRE {%jnb (-16, 6) %jnb2 (-16, 28) #MZERO:d};
//   &NB @WIRE {%jnb2 (26, 22) (26, 12) #MPOUT:g};
//   %jtail = (0, -5);
//   &TAIL @WIRE {#MN1:s (-10, -5) %jtail (10, -5) #MN2:s};
//   &TAIL @WIRE {%jtail #MTAIL:d};
//   %jbias = (-6, -10);
//   &BIAS @WIRE {%pb:p %jbias #MTAIL:g};
//   &BIAS @WIRE {%jbias (-6, -18) (28, -18) (28, -10) #MNOUT:g};
//   %jo = (34, 6); %joc = (40, 6);
//   &OUT @WIRE {#MPOUT:d %jo #MNOUT:d};
//   &OUT @WIRE {%jo %joc %pout:p};
//   %jcl = (14, 28); %jcr = (28, 28); %jcl1 = (14, 34); %jcr1 = (28, 34);
//   &NZ @WIRE {#MZERO:s %jcl #CC0:p};
//   &NZ @WIRE {%jcl %jcl1 (14, 40) #CC2:p};
//   &NZ @WIRE {%jcl1 #CC1:p};
//   &OUT @WIRE {%joc (40, 28) %jcr #CC0:n};
//   &OUT @WIRE {%jcr %jcr1 (28, 40) #CC2:n};
//   &OUT @WIRE {%jcr1 #CC1:n};
//   %gzero = $GROUND @ATTACH &VSS => @PLACE(-5, 33) => @ORIENT("R0");
//   &VSS @WIRE {#MZERO:g (0, 35) (-5, 35) %gzero:p};
//   %vh = $SUPPLY @ATTACH &AVDD18 => @PLACE(0, 18) => @ORIENT("R0");
//   %jvh = (0, 17); %jvhr = (10, 17);
//   &AVDD18 @WIRE {%vh:p %jvh};
//   &AVDD18 @WIRE {#MP1:s (-10, 17) %jvh %jvhr #MP2:s};
//   %vho = $SUPPLY @ATTACH &AVDD18 => @PLACE(34, 20) => @ORIENT("R0");
//   &AVDD18 @WIRE {%vho:p #MPOUT:s};
//   %gt = $GROUND @ATTACH &VSS => @PLACE(0, -14) => @ORIENT("R0");
//   %go = $GROUND @ATTACH &VSS => @PLACE(34, -14) => @ORIENT("R0");
//   &VSS @WIRE {#MTAIL:s %gt:p};
//   &VSS @WIRE {#MNOUT:s %go:p};
//   $JUNCTION @ATTACH {%jnb %jna %jmg %jnb2 %jtail %jbias %jo %joc %jcl %jcr %jcl1 %jcr1 %jvh};
//   #MP1 @TEXT("MP1 / x4", key="name", dx=-1.1, dy=1.1, halign="end");
//   #MP2 @TEXT("MP2 / x4", key="name");
//   #MPOUT @TEXT("MPOUT", key="name");
//   #MPOUT @TEXT("x16", key="size", dx=1, dy=-1.7, size=0.7, halign="start");
//   #MZERO @TEXT("MZERO / x8", key="name", dx=0, dy=-3, halign="middle", size=0.7);
//   #CC0 @TEXT("CC0 / x4", key="name", dx=0, dy=1.4, halign="middle", size=0.7);
//   #CC1 @TEXT("CC1 / x1", key="name", dx=0, dy=1.4, halign="middle", size=0.7);
//   #CC2 @TEXT("CC2 / x1", key="name", dx=0, dy=1.4, halign="middle", size=0.7);
//   (-11, 7) @TEXT("NB", halign="end", size=0.7);
//   (11, 7) @TEXT("NA", halign="start", size=0.7);
//   (1, -6) @TEXT("TAIL", halign="start", size=0.7);
//   (10, 32) @TEXT("NZ", size=0.7);
//   (-21, 49) @TEXT("adc_ref_servo | Differential input, current mirror and compensated gain stage", halign="start") => @SET-STYLE $title_style;
//   (-21, 46) @TEXT("INP rises -> NB falls -> OUT rises. Implicit bodies: NMOS -> VSS; all PMOS, including MZERO -> AVDD18.", halign="start") => @SET-STYLE $note_style;
//   (-21, -23) @TEXT("All MOS: W/L = 8u/1u, nf4. Mirror x4; output PMOS x16; damping PMOS x8; other MOS x1.", halign="start", size=0.75);
//   (-21, -25) @TEXT("MOM: 80 fingers, 40u length, 50n width/space, layers 1..5. CC0 x4; CC1 and CC2 x1.", halign="start", size=0.75);
//   %servo_symbol = @DEFINE-SYMBOL(box=[-4, -4, 3, 4]) {
//     $OPAMP;
//     (-1, -4) @PIN(terminal="BIAS", direction="down");
//     (-1, 4) @PIN(terminal="AVDD18", direction="up");
//     (1, -4) @PIN(terminal="VSS", direction="down");
//     @LINE {(-1, -4) (-1, -1.9)};
//     @LINE {(-1, 4) (-1, 1.9)};
//     @LINE {(1, -4) (1, -0.65)};
//     ? @TEXT("${name}", key="name", size=0.8, halign="end") => @PLACE(-3, 5);
//     (-2.5, -4) @TEXT("BIAS", size=0.65, halign="end")
//   };
//   # @SET-SYMBOL %servo_symbol
// }
ends adc_ref_servo

// Reference-presence clamp. MNBL sinks current from the control node.
subckt adc_ref_startup (REF OUT AVDD18 VSS)
MPUV (NST REF AVDD18 AVDD18) pch_18_mac w=8u l=1u nf=4 multi=2
MNUV (NST REF VSS VSS) nch_18_mac w=64u l=1u nf=32
MNBL (NST AVDD18 VSS VSS) nch_18_mac w=1u l=1u nf=1
MCLAMP (OUT NST VSS VSS) nch_18_mac w=64u l=500n nf=32
// @RNL {
//   &AVDD18 @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   {#MPUV #MNUV #MNBL} @GROUP;
//   #MPUV @SET-SYMBOL $PMOS;
//   {#MNUV #MNBL #MCLAMP} @SET-SYMBOL $NMOS;
//   {#MPUV #MNUV #MNBL #MCLAMP} @TEXT("", key="model");
//   #MPUV @PLACE(0, 6) => @ORIENT("R0");
//   #MNUV @PLACE(0, -6) => @ORIENT("R0");
//   #MNBL @PLACE(12, -6) => @ORIENT("MY");
//   #MCLAMP @PLACE(26, -6) => @ORIENT("R0");
//   %pref = $IO_PORT @ATTACH &REF => @PLACE(-10, 0) => @ORIENT("R0");
//   %jref = (-5, 0);
//   &REF @WIRE {%pref:p %jref (-5, 6) #MPUV:g};
//   &REF @WIRE {%jref (-5, -6) #MNUV:g};
//   %jst = (0, 0); %jbl = (12, 0);
//   &NST @WIRE {#MPUV:d %jst #MNUV:d};
//   &NST @WIRE {%jst %jbl (21, 0) (21, -6) #MCLAMP:g};
//   &NST @WIRE {%jbl #MNBL:d};
//   %pout = $IO_PORT @ATTACH &OUT => @PLACE(36, 6) => @ORIENT("MY");
//   &OUT @WIRE {#MCLAMP:d (26, 6) %pout:p};
//   %vp = $SUPPLY @ATTACH &AVDD18 => @PLACE(0, 16) => @ORIENT("R0");
//   %jvp = (0, 12);
//   &AVDD18 @WIRE {#MPUV:s %jvp %vp:p};
//   &AVDD18 @WIRE {%jvp (18, 12) (18, -6) #MNBL:g};
//   %gn = $GROUND @ATTACH &VSS => @PLACE(12, -14) => @ORIENT("R0");
//   %jg = (12, -10);
//   &VSS @WIRE {#MNUV:s (0, -10) %jg (26, -10) #MCLAMP:s};
//   &VSS @WIRE {#MNBL:s %jg %gn:p};
//   $JUNCTION @ATTACH {%jref %jst %jbl %jvp %jg};
