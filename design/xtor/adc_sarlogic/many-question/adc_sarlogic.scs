parameters wn=16u wp=2400n
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNA (Y A nx1 VSS) nch_ulvt_mac w=wn l=30n nf=8
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNB (nx1 B nx2 VSS) nch_ulvt_mac w=wn l=30n nf=8
MPC (Y C VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNC (nx2 C nx3 VSS) nch_ulvt_mac w=wn l=30n nf=8
MPD (Y D VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MND (nx3 D nx4 VSS) nch_ulvt_mac w=wn l=30n nf=8
MPE (Y E VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNE (nx4 E VSS VSS) nch_ulvt_mac w=wn l=30n nf=8
