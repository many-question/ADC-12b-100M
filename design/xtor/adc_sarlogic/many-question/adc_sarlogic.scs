// adc_sarlogic candidate: static CMOS monotonic completion chain.
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../../rnl/adc28.rnl");
// }
simulator lang=spectre

// Static CMOS inverter; total W, two fingers.
subckt adc_sarlogic_inv (A Y VDD VSS)
parameters wn=400n wp=600n drive=1
MN (Y A VSS VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MP (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-3.0,9,3.0]) {
//     @LINE {(-7,-2.0) (7,-2.0) (7,2.0) (-7,2.0) (-7,-2.0)};
//     (-9,0) @PIN(terminal="A", direction="left");
//     @LINE {(-9,0) (-7,0)};
//     (-6.5,0) @TEXT("A", size=0.7, halign="start");
//     (9,0) @PIN(terminal="Y", direction="right");
//     @LINE {(9,0) (7,0)};
//     (6.5,0) @TEXT("Y", size=0.7, halign="end");
//     (0,3.0) @PIN(terminal="VDD", direction="up");
//     (0,-3.0) @PIN(terminal="VSS", direction="down");
//     ? @TEXT("${name}", key="name", dx=-6, dy=5.0, size=1, halign="start");
//   };
//   # @SET-SYMBOL %symbol;
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   #MN @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=-4, size=0.7, halign="start");
//   #MN @PLACE(0,-8) => @ORIENT("R0");
//   %p_MN_d=(0,-3);
//   &Y @WIRE(mode="straight") {#MN:d %p_MN_d};
//   %p_MN_d @TEXT("Y", size=0.8, halign="start", dy=0.5);
//   %p_MN_g=(-6,-8);
//   &A @WIRE(mode="straight") {#MN:g %p_MN_g};
//   %p_MN_g @TEXT("A", size=0.8, halign="end", dy=0);
//   %p_MN_s=(0,-13);
//   &VSS @WIRE(mode="straight") {#MN:s %p_MN_s};
//   %p_MN_s @TEXT("VSS", size=0.8, halign="start", dy=0.5);
//   %p_MN_b=(4,-8);
//   &VSS @WIRE(mode="straight") {#MN:b %p_MN_b};
//   %p_MN_b @TEXT("VSS", size=0.8, halign="start", dy=0);
//   #MP @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=4, size=0.7, halign="start");
//   #MP @PLACE(0,6) => @ORIENT("R0");
//   %p_MP_d=(0,1);
//   &Y @WIRE(mode="straight") {#MP:d %p_MP_d};
//   %p_MP_d @TEXT("Y", size=0.8, halign="start", dy=0.5);
//   %p_MP_g=(-6,6);
//   &A @WIRE(mode="straight") {#MP:g %p_MP_g};
//   %p_MP_g @TEXT("A", size=0.8, halign="end", dy=0);
//   %p_MP_s=(0,11);
//   &VDD @WIRE(mode="straight") {#MP:s %p_MP_s};
//   %p_MP_s @TEXT("VDD", size=0.8, halign="start", dy=0.5);
//   %p_MP_b=(4,6);
//   &VDD @WIRE(mode="straight") {#MP:b %p_MP_b};
//   %p_MP_b @TEXT("VDD", size=0.8, halign="start", dy=0);
//   {#MN #MP} @GROUP;
//   {&A &Y &VDD &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   %port0=$IO_PORT @ATTACH &A => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &Y => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &VDD => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &VSS => @PLACE(-28,-9) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_inv", size=1.2, bold=true);
//   (-28,20) @TEXT("Static CMOS inverter; total W, two fingers.", size=0.7);
//   (-28,16) @TEXT("Defaults: wn=400n wp=600n drive=1", size=0.8);
// }
ends adc_sarlogic_inv

// Parallel pull-up, series pull-down; full static CMOS.
subckt adc_sarlogic_nand2 (A B Y VDD VSS)
parameters wn=800n wp=600n drive=1
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNA (Y A nx1 VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNB (nx1 B VSS VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-4.0,9,4.0]) {
//     @LINE {(-7,-3.0) (7,-3.0) (7,3.0) (-7,3.0) (-7,-3.0)};
//     (-9,1) @PIN(terminal="A", direction="left");
//     @LINE {(-9,1) (-7,1)};
//     (-6.5,1) @TEXT("A", size=0.7, halign="start");
//     (-9,-1) @PIN(terminal="B", direction="left");
//     @LINE {(-9,-1) (-7,-1)};
//     (-6.5,-1) @TEXT("B", size=0.7, halign="start");
//     (9,0) @PIN(terminal="Y", direction="right");
//     @LINE {(9,0) (7,0)};
//     (6.5,0) @TEXT("Y", size=0.7, halign="end");
//     (0,4.0) @PIN(terminal="VDD", direction="up");
//     (0,-4.0) @PIN(terminal="VSS", direction="down");
//     ? @TEXT("${name}", key="name", dx=-6, dy=6.0, size=1, halign="start");
//   };
//   # @SET-SYMBOL %symbol;
//   &VDD @ADD-TO $SUPPLY_NET_SET;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   #MPA @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=4, size=0.7, halign="start");
//   #MPA @PLACE(0,6) => @ORIENT("R0");
//   %p_MPA_d=(0,1);
//   &Y @WIRE(mode="straight") {#MPA:d %p_MPA_d};
//   %p_MPA_d @TEXT("Y", size=0.8, halign="start", dy=0.5);
//   %p_MPA_g=(-6,6);
//   &A @WIRE(mode="straight") {#MPA:g %p_MPA_g};
//   %p_MPA_g @TEXT("A", size=0.8, halign="end", dy=0);
//   %p_MPA_s=(0,11);
//   &VDD @WIRE(mode="straight") {#MPA:s %p_MPA_s};
//   %p_MPA_s @TEXT("VDD", size=0.8, halign="start", dy=0.5);
//   %p_MPA_b=(4,6);
//   &VDD @WIRE(mode="straight") {#MPA:b %p_MPA_b};
//   %p_MPA_b @TEXT("VDD", size=0.8, halign="start", dy=0);
//   #MNA @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=-4, size=0.7, halign="start");
//   #MNA @PLACE(0,-8) => @ORIENT("R0");
//   %p_MNA_d=(0,-3);
//   &Y @WIRE(mode="straight") {#MNA:d %p_MNA_d};
//   %p_MNA_d @TEXT("Y", size=0.8, halign="start", dy=0.5);
//   %p_MNA_g=(-6,-8);
//   &A @WIRE(mode="straight") {#MNA:g %p_MNA_g};
//   %p_MNA_g @TEXT("A", size=0.8, halign="end", dy=0);
//   %p_MNA_s=(0,-13);
//   &nx1 @WIRE(mode="straight") {#MNA:s %p_MNA_s};
//   %p_MNA_s @TEXT("nx1", size=0.8, halign="start", dy=0.5);
//   %p_MNA_b=(4,-8);
//   &VSS @WIRE(mode="straight") {#MNA:b %p_MNA_b};
//   %p_MNA_b @TEXT("VSS", size=0.8, halign="start", dy=0);
//   #MPB @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=4, size=0.7, halign="start");
//   #MPB @PLACE(18,6) => @ORIENT("R0");
//   %p_MPB_d=(18,1);
//   &Y @WIRE(mode="straight") {#MPB:d %p_MPB_d};
//   %p_MPB_d @TEXT("Y", size=0.8, halign="start", dy=0.5);
//   %p_MPB_g=(12,6);
//   &B @WIRE(mode="straight") {#MPB:g %p_MPB_g};
//   %p_MPB_g @TEXT("B", size=0.8, halign="end", dy=0);
//   %p_MPB_s=(18,11);
//   &VDD @WIRE(mode="straight") {#MPB:s %p_MPB_s};
//   %p_MPB_s @TEXT("VDD", size=0.8, halign="start", dy=0.5);
//   %p_MPB_b=(22,6);
//   &VDD @WIRE(mode="straight") {#MPB:b %p_MPB_b};
//   %p_MPB_b @TEXT("VDD", size=0.8, halign="start", dy=0);
//   #MNB @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=-4, size=0.7, halign="start");
//   #MNB @PLACE(18,-8) => @ORIENT("R0");
//   %p_MNB_d=(18,-3);
//   &nx1 @WIRE(mode="straight") {#MNB:d %p_MNB_d};
//   %p_MNB_d @TEXT("nx1", size=0.8, halign="start", dy=0.5);
//   %p_MNB_g=(12,-8);
//   &B @WIRE(mode="straight") {#MNB:g %p_MNB_g};
//   %p_MNB_g @TEXT("B", size=0.8, halign="end", dy=0);
//   %p_MNB_s=(18,-13);
//   &VSS @WIRE(mode="straight") {#MNB:s %p_MNB_s};
//   %p_MNB_s @TEXT("VSS", size=0.8, halign="start", dy=0.5);
//   %p_MNB_b=(22,-8);
//   &VSS @WIRE(mode="straight") {#MNB:b %p_MNB_b};
//   %p_MNB_b @TEXT("VSS", size=0.8, halign="start", dy=0);
//   {#MPA #MNA #MPB #MNB} @GROUP;
//   {#MNA #MNB} @AS $MATCHED;
//   {#MPA #MPB} @AS $MATCHED;
//   {&A &B &Y &VDD &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   %port0=$IO_PORT @ATTACH &A => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &B => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &Y => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &VDD => @PLACE(-28,-9) => @ORIENT("R0");
//   %port4=$IO_PORT @ATTACH &VSS => @PLACE(-28,-12) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_nand2", size=1.2, bold=true);
//   (-28,20) @TEXT("Parallel pull-up, series pull-down; full static CMOS.", size=0.7);
//   (-28,16) @TEXT("Defaults: wn=800n wp=600n drive=1", size=0.8);
// }
ends adc_sarlogic_nand2

