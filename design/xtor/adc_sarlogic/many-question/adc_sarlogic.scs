//   %port0=$IO_PORT @ATTACH &A => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &Y => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &VDD => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &VSS => @PLACE(-28,-9) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_delay", size=1.2, bold=true);
//   (-28,20) @TEXT("Non-inverting CMOS delay; MOS gate load controls the rising-edge wait.", size=0.7);
//   (-28,16) @TEXT("Defaults: cw=1u", size=0.8);
// }
ends adc_sarlogic_delay

// EHVT NMOS gate load. Drain, source and body at VSS; bias-dependent capacitance compensates timer PVT variation.
subckt adc_sarlogic_timerload (A VSS)
parameters cw=1u
MN (VSS A VSS VSS) nch_ehvt_mac w=200n l=90n nf=2 m=cw/200n
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-3.0,9,3.0]) {
//     @LINE {(-7,-2.0) (7,-2.0) (7,2.0) (-7,2.0) (-7,-2.0)};
//     (-9,0) @PIN(terminal="A", direction="left");
//     @LINE {(-9,0) (-7,0)};
//     (-6.5,0) @TEXT("A", size=0.7, halign="start");
//     (0,-3.0) @PIN(terminal="VSS", direction="down");
//     ? @TEXT("${name}", key="name", dx=-6, dy=5.0, size=1, halign="start");
//   };
//   # @SET-SYMBOL %symbol;
//   &VSS @ADD-TO $GROUND_NET_SET;
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   #MN @TEXT("W=${w}, L=${l}, nf=${nf}, m=${m}", key="wl", dx=5, dy=-4, size=0.7, halign="start");
//   #MN @PLACE(0,-8) => @ORIENT("R0");
//   %p_MN_d=(0,-3);
//   &VSS @WIRE(mode="straight") {#MN:d %p_MN_d};
//   %p_MN_d @TEXT("VSS", size=0.8, halign="start", dy=0.5);
//   %p_MN_g=(-6,-8);
//   &A @WIRE(mode="straight") {#MN:g %p_MN_g};
//   %p_MN_g @TEXT("A", size=0.8, halign="end", dy=0);
//   %p_MN_s=(0,-13);
//   &VSS @WIRE(mode="straight") {#MN:s %p_MN_s};
//   %p_MN_s @TEXT("VSS", size=0.8, halign="start", dy=0.5);
//   %p_MN_b=(4,-8);
//   &VSS @WIRE(mode="straight") {#MN:b %p_MN_b};
//   %p_MN_b @TEXT("VSS", size=0.8, halign="start", dy=0);
//   {#MN} @GROUP;
//   {&A &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   %port0=$IO_PORT @ATTACH &A => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &VSS => @PLACE(-28,-3) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_timerload", size=1.2, bold=true);
//   (-28,20) @TEXT("EHVT NMOS gate load. Drain, source and body at VSS; bias-dependent capacitance compensates timer PVT variation.", size=0.7);
//   (-28,16) @TEXT("Defaults: cw=1u", size=0.8);
