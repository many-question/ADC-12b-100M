// PDK MOS gate load, with each drain/source/body tied to its own rail.
subckt adc_sarlogic_gatecap (A VDD VSS)
parameters cw=1u
MN (VSS A VSS VSS) nch_ulvt_mac w=200n l=90n nf=2 m=cw/200n
MP (VDD A VDD VDD) pch_ulvt_mac w=300n l=90n nf=2 m=cw/200n
