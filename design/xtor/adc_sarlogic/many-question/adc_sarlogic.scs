// One RTZ decision stage. Local ACTIVE stores evaluation permission; dual rails retain the result; delayed completion prepares the next stage.
subckt adc_sarlogic_step (PREV CV CVB RESET P N FORCE CK REQ NEXT BIT UP DN DONE VDD VSS)
parameters cw=1u
IEN (PREV CV doneb activeb enb VDD VSS) adc_sarlogic_nand4
IE (enb REQ VDD VSS) adc_sarlogic_inv wn=800n wp=1200n
IASET (REQ CK aset VDD VSS) adc_sarlogic_and2
IARESET (DONE RESET areset VDD VSS) adc_sarlogic_or2
IACTIVE (aset areset active activeb VDD VSS) adc_sarlogic_sr drive=3
IGRANT (active CV grant VDD VSS) adc_sarlogic_and2
ISP (grant P spb VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
ISTO (grant FORCE stb VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
ISPI (spb stb sp VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
ISN (grant N snb VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
ISNI (snb sn VDD VSS) adc_sarlogic_inv wn=1200n wp=1800n
ILP (sp RESET BIT pb VDD VSS) adc_sarlogic_sr drive=2
ILN (sn RESET nb nbb VDD VSS) adc_sarlogic_sr drive=2
ID (pb nbb DONE VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
IDB (DONE doneb VDD VSS) adc_sarlogic_inv wn=800n wp=1200n
IUP (pb CVB UP VDD VSS) adc_sarlogic_nor2 wn=1600n wp=4800n
IDN (nbb CVB DN VDD VSS) adc_sarlogic_nor2 wn=1600n wp=4800n
IW (DONE NEXT VDD VSS) adc_sarlogic_delay cw=cw
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-9.0,9,9.0]) {
//     @LINE {(-7,-8.0) (7,-8.0) (7,8.0) (-7,8.0) (-7,-8.0)};
//     (-9,6) @PIN(terminal="PREV", direction="left");
//     @LINE {(-9,6) (-7,6)};
//     (-6.5,6) @TEXT("PREV", size=0.55, halign="start");
//     (-9,4) @PIN(terminal="CV", direction="left");
//     @LINE {(-9,4) (-7,4)};
//     (-6.5,4) @TEXT("CV", size=0.55, halign="start");
//     (-9,2) @PIN(terminal="CVB", direction="left");
//     @LINE {(-9,2) (-7,2)};
//     (-6.5,2) @TEXT("CVB", size=0.55, halign="start");
//     (-9,0) @PIN(terminal="RESET", direction="left");
//     @LINE {(-9,0) (-7,0)};
//     (-6.5,0) @TEXT("RESET", size=0.55, halign="start");
//     (-9,-2) @PIN(terminal="P", direction="left");
//     @LINE {(-9,-2) (-7,-2)};
//     (-6.5,-2) @TEXT("P", size=0.55, halign="start");
//     (-9,-4) @PIN(terminal="N", direction="left");
//     @LINE {(-9,-4) (-7,-4)};
//     (-6.5,-4) @TEXT("N", size=0.55, halign="start");
//     (-9,-6) @PIN(terminal="FORCE", direction="left");
//     @LINE {(-9,-6) (-7,-6)};
//     (-6.5,-6) @TEXT("FORCE", size=0.55, halign="start");
//     (9,6) @PIN(terminal="CK", direction="right");
//     @LINE {(9,6) (7,6)};
//     (6.5,6) @TEXT("CK", size=0.55, halign="end");
//     (9,4) @PIN(terminal="REQ", direction="right");
//     @LINE {(9,4) (7,4)};
//     (6.5,4) @TEXT("REQ", size=0.55, halign="end");
//     (9,2) @PIN(terminal="NEXT", direction="right");
//     @LINE {(9,2) (7,2)};
//     (6.5,2) @TEXT("NEXT", size=0.55, halign="end");
//     (9,0) @PIN(terminal="BIT", direction="right");
//     @LINE {(9,0) (7,0)};
//     (6.5,0) @TEXT("BIT", size=0.55, halign="end");
//     (9,-2) @PIN(terminal="UP", direction="right");
//     @LINE {(9,-2) (7,-2)};
//     (6.5,-2) @TEXT("UP", size=0.55, halign="end");
//     (9,-4) @PIN(terminal="DN", direction="right");
//     @LINE {(9,-4) (7,-4)};
//     (6.5,-4) @TEXT("DN", size=0.55, halign="end");
//     (9,-6) @PIN(terminal="DONE", direction="right");
