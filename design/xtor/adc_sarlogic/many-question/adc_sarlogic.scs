// Cross-coupled NOR storage; S and R are kept mutually exclusive by the enclosing logic.
subckt adc_sarlogic_sr (S R Q QB VDD VSS)
parameters drive=1
IQ (R QB Q VDD VSS) adc_sarlogic_nor2 wn=800n wp=2400n drive=drive
IQB (S Q QB VDD VSS) adc_sarlogic_nor2 wn=800n wp=2400n drive=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-4.0,9,4.0]) {
