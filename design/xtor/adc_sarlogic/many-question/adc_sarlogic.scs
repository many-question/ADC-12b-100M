//   {#IQ #IQB} @GROUP;
//   {#IQ #IQB} @AS $MATCHED;
//   {&S &R &Q &QB &VDD &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   %port0=$IO_PORT @ATTACH &S => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &R => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &Q => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &QB => @PLACE(-28,-9) => @ORIENT("R0");
//   %port4=$IO_PORT @ATTACH &VDD => @PLACE(-28,-12) => @ORIENT("R0");
//   %port5=$IO_PORT @ATTACH &VSS => @PLACE(-28,-15) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_sr", size=1.2, bold=true);
//   (-28,20) @TEXT("Cross-coupled NOR storage; S and R are kept mutually exclusive by the enclosing logic.", size=0.7);
// }
ends adc_sarlogic_sr

// Clock holding latch. Reset is asserted by CV low, comparator valid or timeout. Each stage withdraws its request once ACTIVE is set.
subckt adc_sarlogic_clock (SETB CV PB NB FB CK VDD VSS)
IQ (SETB ckbar q VDD VSS) adc_sarlogic_nand2 wn=2400n wp=4800n
IQB (CV PB NB FB q ckbar VDD VSS) adc_sarlogic_nand5
IDRV (ckbar CK VDD VSS) adc_sarlogic_inv wn=4u wp=6u drive=2
