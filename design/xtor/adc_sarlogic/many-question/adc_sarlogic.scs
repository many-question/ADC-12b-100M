// Parallel pull-up, series pull-down; full static CMOS.
subckt adc_sarlogic_nand4 (A B C D Y VDD VSS)
parameters wn=1600n wp=600n
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNA (Y A nx1 VSS) nch_ulvt_mac w=wn l=30n nf=2
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNB (nx1 B nx2 VSS) nch_ulvt_mac w=wn l=30n nf=2
MPC (Y C VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MNC (nx2 C nx3 VSS) nch_ulvt_mac w=wn l=30n nf=2
MPD (Y D VDD VDD) pch_ulvt_mac w=wp l=30n nf=2
MND (nx3 D VSS VSS) nch_ulvt_mac w=wn l=30n nf=2
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-6.0,9,6.0]) {
//     @LINE {(-7,-5.0) (7,-5.0) (7,5.0) (-7,5.0) (-7,-5.0)};
//     (-9,3) @PIN(terminal="A", direction="left");
//     @LINE {(-9,3) (-7,3)};
//     (-6.5,3) @TEXT("A", size=0.55, halign="start");
//     (-9,1) @PIN(terminal="B", direction="left");
//     @LINE {(-9,1) (-7,1)};
//     (-6.5,1) @TEXT("B", size=0.55, halign="start");
//     (-9,-1) @PIN(terminal="C", direction="left");
//     @LINE {(-9,-1) (-7,-1)};
//     (-6.5,-1) @TEXT("C", size=0.55, halign="start");
//     (-9,-3) @PIN(terminal="D", direction="left");
//     @LINE {(-9,-3) (-7,-3)};
//     (-6.5,-3) @TEXT("D", size=0.55, halign="start");
//     (9,0) @PIN(terminal="Y", direction="right");
//     @LINE {(9,0) (7,0)};
//     (6.5,0) @TEXT("Y", size=0.55, halign="end");
//     (0,6.0) @PIN(terminal="VDD", direction="up");
//     (0,-6.0) @PIN(terminal="VSS", direction="down");
//     ? @TEXT("${name}", key="name", dy=8.0, size=0.8);
//   };
//   # @SET-SYMBOL %symbol;
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
