// Parallel pull-up, series pull-down; full static CMOS.
subckt adc_sarlogic_nand4 (A B C D Y VDD VSS)
parameters wn=1600n wp=600n drive=1
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNA (Y A nx1 VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNB (nx1 B nx2 VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MPC (Y C VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNC (nx2 C nx3 VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MPD (Y D VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MND (nx3 D VSS VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-6.0,9,6.0]) {
//     @LINE {(-7,-5.0) (7,-5.0) (7,5.0) (-7,5.0) (-7,-5.0)};
//     (-9,3) @PIN(terminal="A", direction="left");
//     @LINE {(-9,3) (-7,3)};
//     (-6.5,3) @TEXT("A", size=0.7, halign="start");
//     (-9,1) @PIN(terminal="B", direction="left");
//     @LINE {(-9,1) (-7,1)};
//     (-6.5,1) @TEXT("B", size=0.7, halign="start");
//     (-9,-1) @PIN(terminal="C", direction="left");
