ends adc_sarlogic_step

// 14-decision asynchronous SAR, 13 split-CDAC updates, parallel output storage and persistent RDY.
subckt adc_sarlogic (CONV OUTP OUTN CLKC UP12 UP11 UP10 UP9 UP8 UP7 UP6 UP5 UP4 UP3 UP2 UP1 UP0 DN12 DN11 DN10 DN9 DN8 DN7 DN6 DN5 DN4 DN3 DN2 DN1 DN0 D13 D12 D11 D10 D9 D8 D7 D6 D5 D4 D3 D2 D1 D0 RDY DVDD VSS)
parameters wait_fast=200n wait_slow=11400n extra3=2150n extra456=6u extra9=7600n timer_load=5u reset_load=3u start_load=4200n ready_load=4650n
ICV (CONV cv DVDD VSS) adc_sarlogic_buf drive=4
ICB (cv cvb DVDD VSS) adc_sarlogic_inv wn=1600n wp=2400n drive=4
IP (OUTP pi pib DVDD VSS) adc_sarlogic_cmpbuf
IN (OUTN ni nib DVDD VSS) adc_sarlogic_cmpbuf
IAB0 (cv ab0 DVDD VSS) adc_sarlogic_delay cw=2u
IAB1 (ab0 ab1 DVDD VSS) adc_sarlogic_delay cw=2u
IAB2 (ab1 ab2 DVDD VSS) adc_sarlogic_delay cw=2u
IAB3 (ab2 cv_abort DVDD VSS) adc_sarlogic_delay cw=2u
IACB (cv acvb DVDD VSS) adc_sarlogic_inv
IAP (acvb cv_abort abort DVDD VSS) adc_sarlogic_and2
IRC0 (cv cr0 DVDD VSS) adc_sarlogic_delay cw=reset_load
IRC1 (cr0 cr1 DVDD VSS) adc_sarlogic_delay cw=reset_load
IRC2 (cr1 cr2 DVDD VSS) adc_sarlogic_delay cw=reset_load
IRC3 (cr2 cr3 DVDD VSS) adc_sarlogic_delay cw=reset_load
IRC4 (cr3 cr4 DVDD VSS) adc_sarlogic_delay cw=reset_load
IRC5 (cr4 cv_resetwait DVDD VSS) adc_sarlogic_delay cw=reset_load
IRB (cv cv_resetwait reset DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=3600n drive=6
IST0 (cv st0 DVDD VSS) adc_sarlogic_delay cw=start_load
IST1 (st0 start DVDD VSS) adc_sarlogic_delay cw=start_load
IS1 (start cv cvb reset pi ni force CLKC req1 next1 raw13 UP12 DN12 done1 DVDD VSS) adc_sarlogic_step cw=wait_fast
IS2 (next1 cv cvb reset pi ni force CLKC req2 next2 raw12 UP11 DN11 done2 DVDD VSS) adc_sarlogic_step cw=wait_fast
IS3 (next2 cv cvb reset pi ni force CLKC req3 next3 raw11 UP10 DN10 done3 DVDD VSS) adc_sarlogic_step cw=wait_fast+extra3
IS4 (next3 cv cvb reset pi ni force CLKC req4 next4 raw10 UP9 DN9 done4 DVDD VSS) adc_sarlogic_step cw=wait_fast+extra456
IS5 (next4 cv cvb reset pi ni force CLKC req5 next5 raw9 UP8 DN8 done5 DVDD VSS) adc_sarlogic_step cw=wait_fast+extra456
IS6 (next5 cv cvb reset pi ni force CLKC req6 next6 raw8 UP7 DN7 done6 DVDD VSS) adc_sarlogic_step cw=wait_fast+extra456
IS7 (next6 cv cvb reset pi ni force CLKC req7 next7 raw7 UP6 DN6 done7 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS8 (next7 cv cvb reset pi ni force CLKC req8 next8 raw6 UP5 DN5 done8 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS9 (next8 cv cvb reset pi ni force CLKC req9 next9 raw5 UP4 DN4 done9 DVDD VSS) adc_sarlogic_step cw=wait_slow+extra9
IS10 (next9 cv cvb reset pi ni force CLKC req10 next10 raw4 UP3 DN3 done10 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS11 (next10 cv cvb reset pi ni force CLKC req11 next11 raw3 UP2 DN2 done11 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS12 (next11 cv cvb reset pi ni force CLKC req12 next12 raw2 UP1 DN1 done12 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS13 (next12 cv cvb reset pi ni force CLKC req13 next13 raw1 UP0 DN0 done13 DVDD VSS) adc_sarlogic_step cw=wait_slow
IS14 (next13 cv cvb reset pi ni force CLKC req14 next14 raw0 lastup lastdn done14 DVDD VSS) adc_sarlogic_step cw=wait_slow
IR0 (req1 req2 rq0 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR1 (req3 req4 rq1 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR2 (req5 req6 rq2 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR3 (req7 req8 rq3 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR4 (req9 req10 rq4 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR5 (req11 req12 rq5 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IR6 (req13 req14 rq6 DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=1200n
IRA (rq0 rq1 rq2 rq3 ra DVDD VSS) adc_sarlogic_nand4 wn=2400n wp=2400n
IRZ (rq4 rq5 rq6 rz DVDD VSS) adc_sarlogic_nand3 wn=1800n wp=2400n
IROR (ra rz rqbar DVDD VSS) adc_sarlogic_nor2 wn=1200n wp=3600n drive=2
IFB (force forceb DVDD VSS) adc_sarlogic_inv wn=1200n wp=1800n
ICKH (rqbar cv pib nib forceb CLKC DVDD VSS) adc_sarlogic_clock
IT0 (CLKC CLKC to0 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT1 (to0 CLKC to1 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT2 (to1 CLKC to2 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT3 (to2 CLKC to3 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT4 (to3 CLKC to4 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT5 (to4 CLKC to5 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT6 (to5 CLKC to6 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT7 (to6 CLKC to7 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT8 (to7 CLKC to8 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT9 (to8 CLKC to9 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT10 (to9 CLKC to10 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
IT11 (to10 CLKC to11 DVDD VSS) adc_sarlogic_resetdelay cw=timer_load
ITO (to11 CLKC force DVDD VSS) adc_sarlogic_and2
IEOC (done14 cv eoc DVDD VSS) adc_sarlogic_and2
IENREG (eoc abort load DVDD VSS) adc_sarlogic_or2
ILBUF (load loadp DVDD VSS) adc_sarlogic_buf drive=6
ILBAR (loadp loadb DVDD VSS) adc_sarlogic_inv wn=4u wp=6u
ID13 (raw13 loadp loadb D13 DVDD VSS) adc_sarlogic_latch
ID12 (raw12 loadp loadb D12 DVDD VSS) adc_sarlogic_latch
ID11 (raw11 loadp loadb D11 DVDD VSS) adc_sarlogic_latch
ID10 (raw10 loadp loadb D10 DVDD VSS) adc_sarlogic_latch
ID9 (raw9 loadp loadb D9 DVDD VSS) adc_sarlogic_latch
ID8 (raw8 loadp loadb D8 DVDD VSS) adc_sarlogic_latch
ID7 (raw7 loadp loadb D7 DVDD VSS) adc_sarlogic_latch
ID6 (raw6 loadp loadb D6 DVDD VSS) adc_sarlogic_latch
ID5 (raw5 loadp loadb D5 DVDD VSS) adc_sarlogic_latch
ID4 (raw4 loadp loadb D4 DVDD VSS) adc_sarlogic_latch
ID3 (raw3 loadp loadb D3 DVDD VSS) adc_sarlogic_latch
ID2 (raw2 loadp loadb D2 DVDD VSS) adc_sarlogic_latch
ID1 (raw1 loadp loadb D1 DVDD VSS) adc_sarlogic_latch
ID0 (raw0 loadp loadb D0 DVDD VSS) adc_sarlogic_latch
IRWB (cv_resetwait cv_resetwaitb DVDD VSS) adc_sarlogic_inv
IRSTP (cv cv_resetwaitb beginpulse DVDD VSS) adc_sarlogic_and2
IDONE (eoc abort committed DVDD VSS) adc_sarlogic_or2
ICOMMIT (committed beginpulse complete completeb DVDD VSS) adc_sarlogic_sr
IRD0 (complete rdywait0 DVDD VSS) adc_sarlogic_delay cw=ready_load
IRD1 (rdywait0 rdywait1 DVDD VSS) adc_sarlogic_delay cw=ready_load
IRD2 (rdywait1 rdywait2 DVDD VSS) adc_sarlogic_delay cw=ready_load
IRD3 (rdywait2 rdywait3 DVDD VSS) adc_sarlogic_delay cw=ready_load
IRD4 (rdywait3 rdywait4 DVDD VSS) adc_sarlogic_delay cw=ready_load
IRDS (rdywait4 complete setready DVDD VSS) adc_sarlogic_and2
IRDY (setready beginpulse ready readyb DVDD VSS) adc_sarlogic_sr
IRDB (ready RDY DVDD VSS) adc_sarlogic_buf drive=4
