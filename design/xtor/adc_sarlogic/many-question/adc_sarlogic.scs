// Balanced comparator receiver. YB resets the comparator clock directly; Y drives the decision cells.
subckt adc_sarlogic_cmpbuf (A Y YB VDD VSS)
IPRE (A YB VDD VSS) adc_sarlogic_inv wn=2400n wp=3600n
MNOUT (Y YB VSS VSS) nch_ulvt_mac w=800n l=30n nf=2 m=10
MPOUT (Y YB VDD VDD) pch_ulvt_mac w=1200n l=30n nf=2 m=10
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-4.0,9,4.0]) {
//     @LINE {(-7,-3.0) (7,-3.0) (7,3.0) (-7,3.0) (-7,-3.0)};
//     (-9,0) @PIN(terminal="A", direction="left");
//     @LINE {(-9,0) (-7,0)};
//     (-6.5,0) @TEXT("A", size=0.55, halign="start");
//     (9,1) @PIN(terminal="Y", direction="right");
//     @LINE {(9,1) (7,1)};
//     (6.5,1) @TEXT("Y", size=0.55, halign="end");
//     (9,-1) @PIN(terminal="YB", direction="right");
//     @LINE {(9,-1) (7,-1)};
//     (6.5,-1) @TEXT("YB", size=0.55, halign="end");
//     (0,4.0) @PIN(terminal="VDD", direction="up");
