subckt adc_sarlogic_slice14 (CMPP CMPN GO_IN IDLE_B RST_B Q REQ_B DONE VDD VSS)
XTOK_SET (GO_IN IDLE_B tok_set_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XTOK_Q (tok_set_b tok_b en_k VDD VSS) adc_sarlogic_nand2 wn=1.2u wp=1.2u nn=2 np=2
XTOK_QB (en_k RST_B tok_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XSETP (CMPP en_k dn_b set_pb VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=800n nn=2 np=2
XSETN (CMPN en_k up_b set_nb VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=800n nn=2 np=2
XUP_Q (set_pb up_b Q VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=3.2u nn=2 np=4
XUP_QB (Q RST_B up_b VDD VSS) adc_sarlogic_nand2 wn=4.8u wp=1.2u nn=4 np=2
XDN_Q (set_nb dn_b dn_q VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=3.2u nn=2 np=4
XDN_QB (dn_q RST_B dn_b VDD VSS) adc_sarlogic_nand2 wn=4.8u wp=1.2u nn=4 np=2
XREQ (GO_IN up_b dn_b REQ_B VDD VSS) adc_sarlogic_nand3 wn=1.8u wp=1.8u nn=2 np=2
XDONE (up_b dn_b DONE VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=1.8u nn=2 np=2
