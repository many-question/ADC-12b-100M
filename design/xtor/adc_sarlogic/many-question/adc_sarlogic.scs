ends adc_sarlogic_timerload

// Timeout tap: every node is asynchronously cleared while EN is low.
subckt adc_sarlogic_resetdelay (A EN Y VDD VSS)
parameters cw=1u
I0 (A EN nb VDD VSS) adc_sarlogic_nand2
ILOAD (nb VSS) adc_sarlogic_timerload cw=cw
I1 (nb Y VDD VSS) adc_sarlogic_inv
