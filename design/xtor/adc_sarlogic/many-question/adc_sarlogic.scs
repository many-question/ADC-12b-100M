// Clock holding latch with window/timeout qualification separate from the direct comparator reset. Direct RTZ feedback avoids clipping small per-step extra DAC waits.
subckt adc_sarlogic_clock (SETB CV PB NB FB CK VDD VSS)
IWINN (CV FB winb VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
IWIN (winb win VDD VSS) adc_sarlogic_inv wn=1200n wp=1800n drive=2
IQ (SETB ckbar q VDD VSS) adc_sarlogic_nand2 wn=1200n wp=4800n drive=2
IQB (win PB NB q ckbar VDD VSS) adc_sarlogic_nand4 wn=3200n wp=600n drive=5
IDRV (ckbar CK VDD VSS) adc_sarlogic_inv wn=4u wp=6u drive=2
