//   {#IWINN #IWIN #IQ #IQB #IDRV} @GROUP;
//   {&SETB &CV &PB &NB &FB &CK &VDD &VSS} @REMOVE-FROM $PORT_FILL_SET;
//   %port0=$IO_PORT @ATTACH &SETB => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &CV => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &PB => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &NB => @PLACE(-28,-9) => @ORIENT("R0");
//   %port4=$IO_PORT @ATTACH &FB => @PLACE(-28,-12) => @ORIENT("R0");
//   %port5=$IO_PORT @ATTACH &CK => @PLACE(-28,-15) => @ORIENT("R0");
//   %port6=$IO_PORT @ATTACH &VDD => @PLACE(-28,-18) => @ORIENT("R0");
//   %port7=$IO_PORT @ATTACH &VSS => @PLACE(-28,-21) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_clock", size=1.2, bold=true);
//   (-28,20) @TEXT("Clock holding latch with window/timeout qualification separate from the direct comparator reset. Direct RTZ feedback avoids clipping small per-step extra DAC waits.", size=0.7);
// }
ends adc_sarlogic_clock

// Static transmission-gate latch. EN=1 tracks A; EN=0 closes the feedback path.
subckt adc_sarlogic_latch (A EN ENB Q VDD VSS)
MNI (x EN A VSS) nch_ulvt_mac w=600n l=30n nf=2
MPI (x ENB A VDD) pch_ulvt_mac w=900n l=30n nf=2
I0 (x qb VDD VSS) adc_sarlogic_inv
I1 (qb qhold VDD VSS) adc_sarlogic_inv
MNF (x ENB qhold VSS) nch_ulvt_mac w=400n l=30n nf=2
MPF (x EN qhold VDD) pch_ulvt_mac w=600n l=30n nf=2
IB (qhold Q VDD VSS) adc_sarlogic_buf drive=4
