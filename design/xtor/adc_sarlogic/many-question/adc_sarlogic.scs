// Two-stage output buffer; scale only the final device widths.
subckt adc_sarlogic_buf (A Y VDD VSS)
parameters drive=1
I0 (A nb VDD VSS) adc_sarlogic_inv wn=1200n wp=1800n
MNOUT (Y nb VSS VSS) nch_ulvt_mac w=800n l=30n nf=2 m=drive
MPOUT (Y nb VDD VDD) pch_ulvt_mac w=1200n l=30n nf=2 m=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-3.0,9,3.0]) {
//     @LINE {(-7,-2.0) (7,-2.0) (7,2.0) (-7,2.0) (-7,-2.0)};
//     (-9,0) @PIN(terminal="A", direction="left");
//     @LINE {(-9,0) (-7,0)};
//     (-6.5,0) @TEXT("A", size=0.55, halign="start");
//     (9,0) @PIN(terminal="Y", direction="right");
//     @LINE {(9,0) (7,0)};
//     (6.5,0) @TEXT("Y", size=0.55, halign="end");
//     (0,3.0) @PIN(terminal="VDD", direction="up");
//     (0,-3.0) @PIN(terminal="VSS", direction="down");
//     ? @TEXT("${name}", key="name", dy=5.0, size=0.8);
//   };
//   # @SET-SYMBOL %symbol;
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   $LABEL_TERMINAL_SET @TEXT("${net}", key="netname", size=0.6);
//   #I0 @TEXT("wn=1200n wp=1800n", key="sizing", dy=-8.0, size=0.55);
//   #I0 @PLACE(0,0) => @ORIENT("R0");
//   %p_I0_A=(-12,0);
//   &A @WIRE(mode="straight") {#I0:A %p_I0_A};
//   %p_I0_A @TEXT("A", size=0.55, halign="end", dy=0);
//   %p_I0_Y=(12,0);
//   &nb @WIRE(mode="straight") {#I0:Y %p_I0_Y};
//   %p_I0_Y @TEXT("nb", size=0.55, halign="start", dy=0);
//   %p_I0_VDD=(0,6.0);
//   &VDD @WIRE(mode="straight") {#I0:VDD %p_I0_VDD};
//   %p_I0_VDD @TEXT("VDD", size=0.55, halign="start", dy=0.5);
