subckt adc_sarlogic (CONV OUTP OUTN CLKC UP12 UP11 UP10 UP9 UP8 UP7 UP6 UP5 UP4 UP3 UP2 \
        UP1 UP0 DN12 DN11 DN10 DN9 DN8 DN7 DN6 DN5 DN4 DN3 DN2 DN1 DN0 D13 D12 D11 D10 D9 \
        D8 D7 D6 D5 D4 D3 D2 D1 D0 RDY DVDD VSS)
// Low-capacitance input buffers (LOG-14 <= 40 fF, LOG-15 <= 7 fF)
XIN_CV (CONV conv_b DVDD VSS) adc_sarlogic_inv wn=1.2u wp=1.8u nn=2 np=2
XIN_OP (OUTP op_b DVDD VSS) adc_sarlogic_inv wn=1.8u wp=3.2u nn=2 np=4
XIN_ON (OUTN on_b DVDD VSS) adc_sarlogic_inv wn=1.8u wp=3.2u nn=2 np=4

// Loop controller, timeout recovery, and output timing
XCTRL (conv_b op_b on_b req_b1 req_b2 req_b3 req_b4 req_b5 req_b6 req_b7 req_b8 req_b9 \
        req_b10 req_b11 req_b12 req_b13 req_b14 done14 CLKC RDY cmpp cmpn idle_b rst_b \
        go0 lat_en DVDD VSS) adc_sarlogic_ctrl

// 14 self-timed bit slices: k=1..6 fast wait (+extra wait on k=3,4,5,6), k=7..13 slow wait (+extra wait on k=9)
XS1 (cmpp cmpn go0 idle_b rst_b UP12 DN12 b13 go1 req_b1 DVDD VSS) adc_sarlogic_slice \
        wn_c=240n wp_c=360n ln_c=30n lp_c=30n nn_c=2 np_c=2
XS2 (cmpp cmpn go1 idle_b rst_b UP11 DN11 b12 go2 req_b2 DVDD VSS) adc_sarlogic_slice \
        wn_c=240n wp_c=360n ln_c=30n lp_c=30n nn_c=2 np_c=2
XS3 (cmpp cmpn go2 idle_b rst_b UP10 DN10 b11 go3 req_b3 DVDD VSS) adc_sarlogic_slice \
        wn_c=1.65u wp_c=2.475u ln_c=60n lp_c=60n nn_c=2 np_c=2
XS4 (cmpp cmpn go3 idle_b rst_b UP9 DN9 b10 go4 req_b4 DVDD VSS) adc_sarlogic_slice \
        wn_c=5.4u wp_c=8.1u ln_c=60n lp_c=60n nn_c=4 np_c=4
XS5 (cmpp cmpn go4 idle_b rst_b UP8 DN8 b9 go5 req_b5 DVDD VSS) adc_sarlogic_slice \
        wn_c=5.4u wp_c=8.1u ln_c=60n lp_c=60n nn_c=4 np_c=4
XS6 (cmpp cmpn go5 idle_b rst_b UP7 DN7 b8 go6 req_b6 DVDD VSS) adc_sarlogic_slice \
        wn_c=5.4u wp_c=8.1u ln_c=60n lp_c=60n nn_c=4 np_c=4
XS7 (cmpp cmpn go6 idle_b rst_b UP6 DN6 b7 go7 req_b7 DVDD VSS) adc_sarlogic_slice \
        wn_c=8.6u wp_c=12.9u ln_c=60n lp_c=60n nn_c=6 np_c=6
XS8 (cmpp cmpn go7 idle_b rst_b UP5 DN5 b6 go8 req_b8 DVDD VSS) adc_sarlogic_slice \
        wn_c=8.6u wp_c=12.9u ln_c=60n lp_c=60n nn_c=6 np_c=6
XS9 (cmpp cmpn go8 idle_b rst_b UP4 DN4 b5 go9 req_b9 DVDD VSS) adc_sarlogic_slice \
        wn_c=12.0u wp_c=18.0u ln_c=60n lp_c=60n nn_c=8 np_c=8
XS10 (cmpp cmpn go9 idle_b rst_b UP3 DN3 b4 go10 req_b10 DVDD VSS) adc_sarlogic_slice \
