//   #MPOUT @PLACE(18,6) => @ORIENT("R0");
//   %p_MPOUT_d=(18,1);
//   &Y @WIRE(mode="straight") {#MPOUT:d %p_MPOUT_d};
//   %p_MPOUT_d @TEXT("Y", size=0.55, halign="start", dy=0.5);
//   %p_MPOUT_g=(12,6);
//   &nb @WIRE(mode="straight") {#MPOUT:g %p_MPOUT_g};
//   %p_MPOUT_g @TEXT("nb", size=0.55, halign="end", dy=0);
//   %p_MPOUT_s=(18,11);
