//   %port0=$IO_PORT @ATTACH &A => @PLACE(-28,0) => @ORIENT("R0");
//   %port1=$IO_PORT @ATTACH &B => @PLACE(-28,-3) => @ORIENT("R0");
//   %port2=$IO_PORT @ATTACH &C => @PLACE(-28,-6) => @ORIENT("R0");
//   %port3=$IO_PORT @ATTACH &D => @PLACE(-28,-9) => @ORIENT("R0");
//   %port4=$IO_PORT @ATTACH &E => @PLACE(-28,-12) => @ORIENT("R0");
//   %port5=$IO_PORT @ATTACH &Y => @PLACE(-28,-15) => @ORIENT("R0");
//   %port6=$IO_PORT @ATTACH &VDD => @PLACE(-28,-18) => @ORIENT("R0");
//   %port7=$IO_PORT @ATTACH &VSS => @PLACE(-28,-21) => @ORIENT("R0");
//   (-28,24) @TEXT("adc_sarlogic_nand5", size=1.2, bold=true);
//   (-28,20) @TEXT("Parallel pull-up, series pull-down; full static CMOS.", size=0.7);
// }
ends adc_sarlogic_nand5

// Series pull-up, parallel pull-down; full static CMOS.
subckt adc_sarlogic_nor2 (A B Y VDD VSS)
parameters wn=400n wp=1200n drive=1
MPA (px A VDD VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MPB (Y B px VDD) pch_ulvt_mac w=wp l=30n nf=2 m=drive
MNA (Y A VSS VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
MNB (Y B VSS VSS) nch_ulvt_mac w=wn l=30n nf=2 m=drive
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-4.0,9,4.0]) {
