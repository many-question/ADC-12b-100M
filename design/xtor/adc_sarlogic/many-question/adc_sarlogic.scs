// One RTZ decision stage. Local ACTIVE stores evaluation permission; dual rails retain the result; delayed completion prepares the next stage.
subckt adc_sarlogic_step (PREV CV CVB RESET P N FORCE CK REQ NEXT BIT UP DN DONE VDD VSS)
parameters cw=1u
IEN (PREV CV doneb activeb enb VDD VSS) adc_sarlogic_nand4
IE (enb REQ VDD VSS) adc_sarlogic_inv wn=800n wp=1200n
IASET (REQ CK aset VDD VSS) adc_sarlogic_and2
IARESET (DONE RESET areset VDD VSS) adc_sarlogic_or2
IACTIVE (aset areset active activeb VDD VSS) adc_sarlogic_sr drive=3
IGRANT (active CV grant VDD VSS) adc_sarlogic_and2
ISP (grant P spb VDD VSS) adc_sarlogic_nand2 wn=2400n wp=1200n
ISTO (grant FORCE stb VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
ISPI (spb stb sp VDD VSS) adc_sarlogic_nand2 wn=1600n wp=2400n
ISN (grant N snb VDD VSS) adc_sarlogic_nand2 wn=2400n wp=1200n
ISNI (snb sn VDD VSS) adc_sarlogic_inv wn=1800n wp=2700n
ILP (sp RESET BIT pb VDD VSS) adc_sarlogic_sr drive=3
ILN (sn RESET nb nbb VDD VSS) adc_sarlogic_sr drive=3
ID (pb nbb DONE VDD VSS) adc_sarlogic_nand2 wn=1600n wp=1200n
IDB (DONE doneb VDD VSS) adc_sarlogic_inv wn=800n wp=1200n
IUP (pb CVB UP VDD VSS) adc_sarlogic_nor2 wn=800n wp=4800n drive=2
IDN (nbb CVB DN VDD VSS) adc_sarlogic_nor2 wn=800n wp=4800n drive=2
IW (DONE NEXT VDD VSS) adc_sarlogic_delay cw=cw
