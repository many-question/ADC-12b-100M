// Static transmission-gate latch. EN=1 tracks A; EN=0 closes the feedback path.
subckt adc_sarlogic_latch (A EN ENB Q VDD VSS)
MNI (x EN A VSS) nch_ulvt_mac w=600n l=30n nf=2
MPI (x ENB A VDD) pch_ulvt_mac w=900n l=30n nf=2
I0 (x qb VDD VSS) adc_sarlogic_inv
I1 (qb qhold VDD VSS) adc_sarlogic_inv
MNF (x ENB qhold VSS) nch_ulvt_mac w=400n l=30n nf=2
MPF (x EN qhold VDD) pch_ulvt_mac w=600n l=30n nf=2
IB (qhold Q VDD VSS) adc_sarlogic_buf drive=4
