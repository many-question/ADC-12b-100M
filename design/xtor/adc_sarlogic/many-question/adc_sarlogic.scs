//   #MNOUT @PLACE(0,-8) => @ORIENT("R0");
//   %p_MNOUT_d=(0,-3);
//   &Y @WIRE(mode="straight") {#MNOUT:d %p_MNOUT_d};
//   %p_MNOUT_d @TEXT("Y", size=0.55, halign="start", dy=0.5);
//   %p_MNOUT_g=(-6,-8);
//   &nb @WIRE(mode="straight") {#MNOUT:g %p_MNOUT_g};
//   %p_MNOUT_g @TEXT("nb", size=0.55, halign="end", dy=0);
//   %p_MNOUT_s=(0,-13);
//   &VSS @WIRE(mode="straight") {#MNOUT:s %p_MNOUT_s};
//   %p_MNOUT_s @TEXT("VSS", size=0.55, halign="start", dy=0.5);
