//   #XDN_Q:A @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDN_Q:B @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDN_Q:Y @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #XDN_QB @PLACE(0, -20);
//   #XDN_QB:A @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDN_QB:B @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDN_QB:Y @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #XREQ @PLACE(16, -20);
//   #XREQ:A @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XREQ:B @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XREQ:C @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XREQ:Y @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   #XDONE @PLACE(32, -20);
//   #XDONE:A @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDONE:B @TEXT("${net}", key="netname", size=0.6, halign="end", valign="middle", dx=-0.4, dy=0);
//   #XDONE:Y @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", dx=0.4, dy=0);
//   %p_cmpp = $IO_PORT @ATTACH &CMPP => @PLACE(-16, 0) => @ORIENT("R0");
//   &CMPP @WIRE {%p_cmpp:p (-13, 0)};
//   %p_cmpn = $IO_PORT @ATTACH &CMPN => @PLACE(-16, -3) => @ORIENT("R0");
//   &CMPN @WIRE {%p_cmpn:p (-13, -3)};
//   %p_go_in = $IO_PORT @ATTACH &GO_IN => @PLACE(-16, -6) => @ORIENT("R0");
//   &GO_IN @WIRE {%p_go_in:p (-13, -6)};
//   %p_idle_b = $IO_PORT @ATTACH &IDLE_B => @PLACE(-16, -9) => @ORIENT("R0");
//   &IDLE_B @WIRE {%p_idle_b:p (-13, -9)};
//   %p_rst_b = $IO_PORT @ATTACH &RST_B => @PLACE(-16, -12) => @ORIENT("R0");
//   &RST_B @WIRE {%p_rst_b:p (-13, -12)};
//   %p_q = $IO_PORT @ATTACH &Q => @PLACE(-16, -15) => @ORIENT("R0");
//   &Q @WIRE {%p_q:p (-13, -15)};
//   %p_req_b = $IO_PORT @ATTACH &REQ_B => @PLACE(-16, -18) => @ORIENT("R0");
//   &REQ_B @WIRE {%p_req_b:p (-13, -18)};
//   %p_done = $IO_PORT @ATTACH &DONE => @PLACE(-16, -21) => @ORIENT("R0");
//   &DONE @WIRE {%p_done:p (-13, -21)}
// }
ends adc_sarlogic_slice14

subckt adc_sarlogic_ctrl (CONV_B OP_B ON_B REQ_B1 REQ_B2 REQ_B3 REQ_B4 REQ_B5 REQ_B6 \
        REQ_B7 REQ_B8 REQ_B9 REQ_B10 REQ_B11 REQ_B12 REQ_B13 REQ_B14 DONE14 CLKC RDY \
        CMPP CMPN IDLE_B RST_B GO0 LAT_EN VDD VSS)
// Reset, conversion window delay, and first-clock start delay (t_start)
XCV1 (CONV_B conv_i VDD VSS) adc_sarlogic_inv wn=1.6u wp=2.4u nn=2 np=2
XCD1 (conv_i cd1_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCCD1 (cd1_b VDD VSS) adc_sarlogic_gatecap wn=4.3u wp=6.45u ln=90n lp=90n nn=4 np=4
XCD2 (cd1_b conv_d1 VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCCD2 (conv_d1 VDD VSS) adc_sarlogic_gatecap wn=4.3u wp=6.45u ln=90n lp=90n nn=4 np=4
XCD3 (conv_d1 cd3_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCCD3 (cd3_b VDD VSS) adc_sarlogic_gatecap wn=4.3u wp=6.45u ln=90n lp=90n nn=4 np=4
XCD4 (cd3_b conv_d2 VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XRST_NOR (conv_i conv_d2 rst_i VDD VSS) adc_sarlogic_nor2 wn=1.2u wp=2.4u nn=2 np=4
XRST_DRV (rst_i RST_B VDD VSS) adc_sarlogic_inv wn=3.2u wp=4.8u nn=4 np=6
XGO0_NAND (conv_d2 conv_i go0_b VDD VSS) adc_sarlogic_nand2 wn=1.2u wp=1.2u nn=2 np=2
XGO0_INV (go0_b GO0 VDD VSS) adc_sarlogic_inv wn=1.6u wp=2.4u nn=2 np=2

// Comparator and timeout front-end
XCMPP (OP_B to_b CMPP VDD VSS) adc_sarlogic_nand2 wn=2.4u wp=6.4u nn=4 np=8
XCMPN (ON_B VDD CMPN VDD VSS) adc_sarlogic_nand2 wn=2.4u wp=6.4u nn=4 np=8
XTO_CONV (to4 CONV_B to_conv_b VDD VSS) adc_sarlogic_nor2 wn=800n wp=2.4u nn=2 np=4
XBUSY (OP_B ON_B to_conv_b cmp_busy VDD VSS) adc_sarlogic_nand3 wn=3.6u wp=2.4u nn=4 np=4
XIDLE (cmp_busy IDLE_B VDD VSS) adc_sarlogic_inv wn=2.4u wp=4.8u nn=4 np=6
XIDLE_CLK (cmp_busy clkc_idle_b VDD VSS) adc_sarlogic_inv wn=3.2u wp=6.4u nn=4 np=8

// Balanced 14-input request combiner and fast 2-input CLKC gate
XG1 (REQ_B1 REQ_B2 REQ_B3 grp1 VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=1.2u nn=2 np=2
XG2 (REQ_B4 REQ_B5 REQ_B6 grp2 VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=1.2u nn=2 np=2
XG3 (REQ_B7 REQ_B8 REQ_B9 grp3 VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=1.2u nn=2 np=2
XG4 (REQ_B10 REQ_B11 REQ_B12 grp4 VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=1.2u nn=2 np=2
XG5 (REQ_B13 REQ_B14 VDD grp5 VDD VSS) adc_sarlogic_nand3 wn=2.4u wp=1.2u nn=2 np=2
XGA (grp1 grp2 grp3 grpa_b VDD VSS) adc_sarlogic_nor3 wn=1.2u wp=4.8u nn=2 np=6
XGB (grp4 grp5 VSS grpb_b VDD VSS) adc_sarlogic_nor3 wn=1.2u wp=4.8u nn=2 np=6
XGC (grpa_b grpb_b clkc_req VDD VSS) adc_sarlogic_nand2 wn=3.2u wp=2.4u nn=4 np=4
XCLKC_GATE (clkc_req clkc_idle_b clkc_b VDD VSS) adc_sarlogic_nand2 wn=4.8u wp=3.6u nn=6 np=4
XDRV_CLKC (clkc_b CLKC VDD VSS) adc_sarlogic_inv wn=4.8u wp=7.2u nn=6 np=8

// Self-resetting parallel-reset timeout timer (active when clkc_b = 0)
XTO_RST (CLKC to_rst VDD VSS) adc_sarlogic_inv wn=1.2u wp=1.8u nn=2 np=2
XTO1A (to_rst to_rst to1 VDD VSS) adc_sarlogic_nor2 wn=1.2u wp=3.6u nn=2 np=4
XCTO1 (to1 VDD VSS) adc_sarlogic_gatecap wn=400n wp=56.8u ln=90n lp=90n nn=2 np=24
XTO1B (to1 to1_b VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XCTO1B (to1_b VDD VSS) adc_sarlogic_gatecap wn=42.6u wp=400n ln=90n lp=90n nn=20 np=2
XTO2A (to1_b to_rst to2 VDD VSS) adc_sarlogic_nor2 wn=1.2u wp=3.6u nn=2 np=4
XCTO2 (to2 VDD VSS) adc_sarlogic_gatecap wn=400n wp=56.8u ln=90n lp=90n nn=2 np=24
XTO2B (to2 to2_b VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XCTO2B (to2_b VDD VSS) adc_sarlogic_gatecap wn=42.6u wp=400n ln=90n lp=90n nn=20 np=2
XTO3A (to2_b to_rst to3 VDD VSS) adc_sarlogic_nor2 wn=1.2u wp=3.6u nn=2 np=4
XCTO3 (to3 VDD VSS) adc_sarlogic_gatecap wn=400n wp=56.8u ln=90n lp=90n nn=2 np=24
XTO3B (to3 to3_b VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XCTO3B (to3_b VDD VSS) adc_sarlogic_gatecap wn=6.4u wp=400n ln=90n lp=90n nn=4 np=2
XTO4A (to3_b to4 VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XCTO4 (to4 VDD VSS) adc_sarlogic_gatecap wn=400n wp=9.6u ln=90n lp=90n nn=2 np=6
XTO4B (to4 to_b VDD VSS) adc_sarlogic_inv wn=1.6u wp=2.4u nn=2 np=2

// Output register latch enable and RDY setup delay chain (LOG-10 >= 100 ps all corners)
XD14_INV (DONE14 done14_b VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XLOAD_REQ (done14_b conv_i load_req VDD VSS) adc_sarlogic_nand2 wn=1.6u wp=1.6u nn=2 np=2
XLAT_NAND (load_req conv_d1 lat_b VDD VSS) adc_sarlogic_nand2 wn=2.0u wp=2.0u nn=2 np=2
XLAT_DRV (lat_b LAT_EN VDD VSS) adc_sarlogic_inv wn=4.8u wp=7.2u nn=6 np=8
XRDY1 (load_req rdy1_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCRDY1 (rdy1_b VDD VSS) adc_sarlogic_gatecap wn=10.2u wp=15.3u ln=90n lp=90n nn=8 np=8
XRDY2 (rdy1_b rdy2 VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCRDY2 (rdy2 VDD VSS) adc_sarlogic_gatecap wn=10.2u wp=15.3u ln=90n lp=90n nn=8 np=8
XRDY3 (rdy2 rdy3_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCRDY3 (rdy3_b VDD VSS) adc_sarlogic_gatecap wn=10.2u wp=15.3u ln=90n lp=90n nn=8 np=8
XRDY4 (rdy3_b rdy4 VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCRDY4 (rdy4 VDD VSS) adc_sarlogic_gatecap wn=10.2u wp=15.3u ln=90n lp=90n nn=8 np=8
XRDY5 (rdy4 rdy5_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XCRDY5 (rdy5_b VDD VSS) adc_sarlogic_gatecap wn=10.2u wp=15.3u ln=90n lp=90n nn=8 np=8
XRDY6 (rdy5_b rdy6 VDD VSS) adc_sarlogic_inv wn=800n wp=1.2u nn=2 np=2
XRDY_NAND (load_req rdy6 rdy_b VDD VSS) adc_sarlogic_nand2 wn=1.6u wp=1.6u nn=2 np=2
XDRV_RDY (rdy_b RDY VDD VSS) adc_sarlogic_inv wn=4.8u wp=7.2u nn=6 np=8
// @RNL {
//   /* pins connected by net name: the net-name label of rnl-std-fill on every unwired pin, placed below by its key netname */
