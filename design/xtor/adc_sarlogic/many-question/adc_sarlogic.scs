IN (A B nb VDD VSS) adc_sarlogic_nor2
IO (nb Y VDD VSS) adc_sarlogic_inv
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-4.0,9,4.0]) {
