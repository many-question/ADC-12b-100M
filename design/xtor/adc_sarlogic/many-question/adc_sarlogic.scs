// Non-inverting CMOS delay; MOS gate load controls the rising-edge wait.
subckt adc_sarlogic_delay (A Y VDD VSS)
parameters cw=1u
I0 (A nb VDD VSS) adc_sarlogic_inv
ILOAD (nb VDD VSS) adc_sarlogic_gatecap cw=cw
I1 (nb Y VDD VSS) adc_sarlogic_inv
// @RNL {
//   %symbol = @DEFINE-SYMBOL(box=[-9,-3.0,9,3.0]) {
//     @LINE {(-7,-2.0) (7,-2.0) (7,2.0) (-7,2.0) (-7,-2.0)};
