// adc_sarlogic transistor view: static CMOS self-timed 14-step SAR controller.
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../../rnl/adc28.rnl");
// }
simulator lang=spectre

subckt adc_sarlogic_inv (A Y VDD VSS)
parameters wn=800n wp=1.2u ln=30n lp=30n nn=2 np=2
MN (Y A VSS VSS) nch_ulvt_mac w=wn l=ln nf=nn
MP (Y A VDD VDD) pch_ulvt_mac w=wp l=lp nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $INVERTER;
//   #MP @SET-SYMBOL $PMOS; #MN @SET-SYMBOL $NMOS;
//   {#MN #MP} @GROUP; {#MN #MP} @TEXT("", key="model");
//   #MP @PLACE(0,5) => @ORIENT("R0");
//   #MN @PLACE(0,-5) => @ORIENT("R0");
//   %ga=(-6,0); %out=(0,0); %vp=(0,10); %vn=(0,-10);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-10,0) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(8,0) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,12) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-12) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %ga};
//   &A @WIRE(mode="straight") {#MP:g (-6,5) %ga (-6,-5) #MN:g};
//   &Y @WIRE(mode="straight") {#MP:d %out #MN:d};
//   &Y @WIRE(mode="straight") {%out %y:p};
//   &VDD @WIRE(mode="straight") {#MP:s %vp %v:p};
//   &VSS @WIRE(mode="straight") {#MN:s %vn %g:p};
//   (-10,18) @TEXT("adc_sarlogic_inv", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-10,16) @TEXT("Static CMOS Inverter: Y = NOT A (ULVT core MOS, L=ln/lp)", size=0.75, textcolor="#334155", halign="start");
//   (-10,-16) @TEXT("MP: pch_ulvt_mac (W=wp, L=lp, nf=np); MN: nch_ulvt_mac (W=wn, L=ln, nf=nn)", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %ga; $JUNCTION @ATTACH %out;
// }
ends adc_sarlogic_inv

subckt adc_sarlogic_nand2 (A B Y VDD VSS)
parameters wn=1.2u wp=1.2u nn=2 np=2
MNA (Y B nx VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (nx A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_2INPUT;
//   {#MPA #MPB} @SET-SYMBOL $PMOS; {#MNA #MNB} @SET-SYMBOL $NMOS;
//   {#MNA #MNB} @AS $MATCHED; {#MPA #MPB} @AS $MATCHED;
//   {#MNA #MNB #MPA #MPB} @GROUP; {#MNA #MNB #MPA #MPB} @TEXT("", key="model");
//   #MPA @PLACE(-4,6) => @ORIENT("R0");
//   #MPB @PLACE(6,6) => @ORIENT("R0");
//   #MNA @PLACE(0,-2) => @ORIENT("R0");
//   #MNB @PLACE(0,-10) => @ORIENT("R0");
//   %a1=(-10,6); %b1=(-12,-2); %yp=(-4,2); %y1=(0,2); %yb=(6,2);
//   %vp=(-4,13); %v0=(0,13); %vb=(6,13); %g1=(0,-16);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-17,6) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-17,-2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(16,2) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,16) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-18) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %a1 #MPA:g};
//   &A @WIRE(mode="straight") {%a1 (-10,-10) #MNB:g};
//   &B @WIRE(mode="straight") {%b:p %b1 #MNA:g};
//   &B @WIRE(mode="straight") {%b1 (-12,11) (3,11) #MPB:g};
//   &Y @WIRE(mode="straight") {#MPA:d %yp %y1 %yb %y:p};
//   &Y @WIRE(mode="straight") {#MPB:d %yb};
//   &Y @WIRE(mode="straight") {%y1 #MNA:d};
//   &nx @WIRE(mode="straight") {#MNA:s #MNB:d};
//   &VDD @WIRE(mode="straight") {#MPA:s %vp %v0 %vb #MPB:s};
//   &VDD @WIRE(mode="straight") {%v0 %v:p};
//   &VSS @WIRE(mode="straight") {#MNB:s %g1 %g:p};
//   (-17,22) @TEXT("adc_sarlogic_nand2", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-17,20) @TEXT("2-Input Static CMOS NAND: Y = NOT (A AND B)", size=0.75, textcolor="#334155", halign="start");
//   (-17,-22) @TEXT("Parallel PMOS (W=wp, nf=np); series NMOS (W=wn, nf=nn), L=30n", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %y1; $JUNCTION @ATTACH %yb; $JUNCTION @ATTACH %v0;
// }
ends adc_sarlogic_nand2

subckt adc_sarlogic_nand3 (A B C Y VDD VSS)
parameters wn=1.8u wp=1.2u nn=2 np=2
MNA (Y C nx1 VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (nx1 B nx2 VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNC (nx2 A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (Y A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (Y B VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPC (Y C VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_3INPUT;
//   {#MPA #MPB #MPC} @SET-SYMBOL $PMOS; {#MNA #MNB #MNC} @SET-SYMBOL $NMOS;
//   {#MNA #MNB #MNC} @AS $MATCHED; {#MPA #MPB #MPC} @AS $MATCHED;
//   {#MNA #MNB #MNC #MPA #MPB #MPC} @GROUP; {#MNA #MNB #MNC #MPA #MPB #MPC} @TEXT("", key="model");
//   #MPA @PLACE(-6,6) => @ORIENT("R0");
//   #MPB @PLACE(2,6) => @ORIENT("R0");
//   #MPC @PLACE(10,6) => @ORIENT("R0");
//   #MNA @PLACE(0,-2) => @ORIENT("R0");
//   #MNB @PLACE(0,-10) => @ORIENT("R0");
//   #MNC @PLACE(0,-18) => @ORIENT("R0");
//   %a1=(-12,6); %b1=(-14,-10); %c1=(-16,-2);
//   %ya=(-6,2); %y0=(0,2); %yb=(2,2); %yc=(10,2);
//   %va=(-6,13); %v0=(0,13); %vb=(2,13); %vc=(10,13); %g1=(0,-22);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-20,6) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-20,-10) => @ORIENT("R0");
//   %c=$IO_PORT @ATTACH &C => @PLACE(-20,-2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(18,2) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,16) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-24) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %a1 #MPA:g};
//   &A @WIRE(mode="straight") {%a1 (-12,-18) #MNC:g};
//   &B @WIRE(mode="straight") {%b:p %b1 #MNB:g};
//   &B @WIRE(mode="straight") {%b1 (-14,10) (-1,10) (-1,6) #MPB:g};
//   &C @WIRE(mode="straight") {%c:p %c1 #MNA:g};
//   &C @WIRE(mode="straight") {%c1 (-16,11) (7,11) (7,6) #MPC:g};
//   &Y @WIRE(mode="straight") {#MPA:d %ya %y0 %yb %yc %y:p};
//   &Y @WIRE(mode="straight") {#MPB:d %yb};
//   &Y @WIRE(mode="straight") {#MPC:d %yc};
//   &Y @WIRE(mode="straight") {%y0 #MNA:d};
//   &nx1 @WIRE(mode="straight") {#MNA:s #MNB:d};
//   &nx2 @WIRE(mode="straight") {#MNB:s #MNC:d};
//   &VDD @WIRE(mode="straight") {#MPA:s %va %v0 %vb %vc #MPC:s};
//   &VDD @WIRE(mode="straight") {#MPB:s %vb};
//   &VDD @WIRE(mode="straight") {%v0 %v:p};
//   &VSS @WIRE(mode="straight") {#MNC:s %g1 %g:p};
//   (-20,22) @TEXT("adc_sarlogic_nand3", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-20,20) @TEXT("3-Input Static CMOS NAND: Y = NOT (A AND B AND C)", size=0.75, textcolor="#334155", halign="start");
//   (-20,-28) @TEXT("Parallel PMOS (W=wp, nf=np); 3-stack NMOS (W=wn, nf=nn), L=30n", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %c1;
//   $JUNCTION @ATTACH %y0; $JUNCTION @ATTACH %yb; $JUNCTION @ATTACH %yc;
//   $JUNCTION @ATTACH %v0; $JUNCTION @ATTACH %vb;
// }
ends adc_sarlogic_nand3

subckt adc_sarlogic_nor2 (A B Y VDD VSS)
parameters wn=800n wp=2.4u nn=2 np=4
MNA (Y A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (Y B VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (px A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (Y B px VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NOR_2INPUT;
//   {#MPA #MPB} @SET-SYMBOL $PMOS; {#MNA #MNB} @SET-SYMBOL $NMOS;
//   {#MNA #MNB} @AS $MATCHED; {#MPA #MPB} @AS $MATCHED;
//   {#MNA #MNB #MPA #MPB} @GROUP; {#MNA #MNB #MPA #MPB} @TEXT("", key="model");
//   #MPA @PLACE(0,10) => @ORIENT("R0");
//   #MPB @PLACE(0,2) => @ORIENT("R0");
//   #MNA @PLACE(-5,-7) => @ORIENT("R0");
//   #MNB @PLACE(7,-7) => @ORIENT("R0");
//   %a1=(-12,10); %b1=(-6,2); %y1=(0,-2); %ya=(-5,-2); %yb=(7,-2);
//   %v1=(0,15); %ga=(-5,-13); %gb=(7,-13); %g0=(0,-13);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-17,10) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-17,2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(16,-2) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,17) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-16) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %a1 #MPA:g};
//   &A @WIRE(mode="straight") {%a1 (-12,-7) #MNA:g};
//   &B @WIRE(mode="straight") {%b:p %b1 #MPB:g};
//   &B @WIRE(mode="straight") {%b1 (-6,-1) (3,-1) (3,-7) #MNB:g};
//   &px @WIRE(mode="straight") {#MPA:d #MPB:s};
//   &Y @WIRE(mode="straight") {#MPB:d %y1 %yb %y:p};
//   &Y @WIRE(mode="straight") {#MNA:d %ya %y1};
//   &Y @WIRE(mode="straight") {%yb #MNB:d};
//   &VDD @WIRE(mode="straight") {#MPA:s %v1 %v:p};
//   &VSS @WIRE(mode="straight") {#MNA:s %ga %g0 %gb};
//   &VSS @WIRE(mode="straight") {#MNB:s %gb};
//   &VSS @WIRE(mode="straight") {%g0 %g:p};
//   (-17,22) @TEXT("adc_sarlogic_nor2", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-17,20) @TEXT("2-Input Static CMOS NOR: Y = NOT (A OR B)", size=0.75, textcolor="#334155", halign="start");
//   (-17,-20) @TEXT("Series PMOS (W=wp, nf=np); parallel NMOS (W=wn, nf=nn), L=30n", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %y1; $JUNCTION @ATTACH %yb; $JUNCTION @ATTACH %g0;
// }
ends adc_sarlogic_nor2

subckt adc_sarlogic_nor3 (A B C Y VDD VSS)
parameters wn=1.2u wp=3.6u nn=2 np=4
MNA (Y A VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNB (Y B VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MNC (Y C VSS VSS) nch_ulvt_mac w=wn l=30n nf=nn
MPA (px1 A VDD VDD) pch_ulvt_mac w=wp l=30n nf=np
MPB (px2 B px1 VDD) pch_ulvt_mac w=wp l=30n nf=np
MPC (Y C px2 VDD) pch_ulvt_mac w=wp l=30n nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NOR_3INPUT;
//   {#MPA #MPB #MPC} @SET-SYMBOL $PMOS; {#MNA #MNB #MNC} @SET-SYMBOL $NMOS;
//   {#MNA #MNB #MNC} @AS $MATCHED; {#MPA #MPB #MPC} @AS $MATCHED;
//   {#MNA #MNB #MNC #MPA #MPB #MPC} @GROUP; {#MNA #MNB #MNC #MPA #MPB #MPC} @TEXT("", key="model");
//   #MPA @PLACE(0,18) => @ORIENT("R0");
//   #MPB @PLACE(0,10) => @ORIENT("R0");
//   #MPC @PLACE(0,2) => @ORIENT("R0");
//   #MNA @PLACE(-6,-7) => @ORIENT("R0");
//   #MNB @PLACE(2,-7) => @ORIENT("R0");
//   #MNC @PLACE(10,-7) => @ORIENT("R0");
//   %a1=(-14,18); %b1=(-12,10); %c1=(-10,2);
//   %ya=(-6,-2); %y0=(0,-2); %yb=(2,-2); %yc=(10,-2);
//   %v1=(0,22); %ga=(-6,-13); %g0=(0,-13); %gb=(2,-13); %gc=(10,-13);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-20,18) => @ORIENT("R0");
//   %b=$IO_PORT @ATTACH &B => @PLACE(-20,10) => @ORIENT("R0");
//   %c=$IO_PORT @ATTACH &C => @PLACE(-20,2) => @ORIENT("R0");
//   %y=$IO_PORT @ATTACH &Y => @PLACE(18,-2) => @ORIENT("MY");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,24) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-16) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %a1 #MPA:g};
//   &A @WIRE(mode="straight") {%a1 (-14,-7) #MNA:g};
//   &B @WIRE(mode="straight") {%b:p %b1 #MPB:g};
//   &B @WIRE(mode="straight") {%b1 (-12,-4) (-1,-4) (-1,-7) #MNB:g};
//   &C @WIRE(mode="straight") {%c:p %c1 #MPC:g};
//   &C @WIRE(mode="straight") {%c1 (-10,-5) (7,-5) (7,-7) #MNC:g};
//   &px1 @WIRE(mode="straight") {#MPA:d #MPB:s};
//   &px2 @WIRE(mode="straight") {#MPB:d #MPC:s};
//   &Y @WIRE(mode="straight") {#MPC:d %y0 %yb %yc %y:p};
//   &Y @WIRE(mode="straight") {#MNA:d %ya %y0};
//   &Y @WIRE(mode="straight") {#MNB:d %yb};
//   &Y @WIRE(mode="straight") {#MNC:d %yc};
//   &VDD @WIRE(mode="straight") {#MPA:s %v1 %v:p};
//   &VSS @WIRE(mode="straight") {#MNA:s %ga %g0 %gb %gc #MNC:s};
//   &VSS @WIRE(mode="straight") {#MNB:s %gb};
//   &VSS @WIRE(mode="straight") {%g0 %g:p};
//   (-20,28) @TEXT("adc_sarlogic_nor3", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-20,26) @TEXT("3-Input Static CMOS NOR: Y = NOT (A OR B OR C)", size=0.75, textcolor="#334155", halign="start");
//   (-20,-20) @TEXT("3-stack PMOS (W=wp, nf=np); parallel NMOS (W=wn, nf=nn), L=30n", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %a1; $JUNCTION @ATTACH %b1; $JUNCTION @ATTACH %c1;
//   $JUNCTION @ATTACH %y0; $JUNCTION @ATTACH %yb; $JUNCTION @ATTACH %yc;
//   $JUNCTION @ATTACH %g0; $JUNCTION @ATTACH %gb;
// }
ends adc_sarlogic_nor3

subckt adc_sarlogic_gatecap (A VDD VSS)
parameters wn=1.2u wp=1.8u ln=60n lp=60n nn=2 np=2
MN (VSS A VSS VSS) nch_hvt_mac w=wn l=ln nf=nn
MP (VDD A VDD VDD) pch_hvt_mac w=wp l=lp nf=np
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   %load = @DEFINE-SYMBOL(box=[-2,-3,2,2]) {
//     (0,2) @PIN(terminal="A", direction="up");
//     @LINE {(0,2) (0,0.5)};
//     @LINE(linewidth=0.24) {(-1.5,0.5) (1.5,0.5)};
//     @LINE(linewidth=0.24) {(-1.5,-0.3) (1.5,-0.3)};
//     @LINE {(0,-0.3) (0,-1.5)};
//     @LINE {(-1.0,-1.5) (1.0,-1.5)};
//     @LINE {(-0.6,-1.9) (0.6,-1.9)};
//     ? @TEXT("${name}", key="name", size=0.65, halign="middle") => @PLACE(0,-2.8);
//   }; # @SET-SYMBOL %load;
//   #MP @SET-SYMBOL $PMOS; #MN @SET-SYMBOL $NMOS;
//   {#MN #MP} @GROUP; {#MN #MP} @TEXT("", key="model");
//   #MP @PLACE(0,5) => @ORIENT("R0");
//   #MN @PLACE(0,-5) => @ORIENT("R0");
//   %ga=(-6,0); %vp=(0,10); %vn=(0,-10); %pb=(4,5); %nb=(4,-5);
//   %a=$IO_PORT @ATTACH &A => @PLACE(-10,0) => @ORIENT("R0");
//   %v=$SUPPLY @ATTACH &VDD => @PLACE(0,12) => @ORIENT("R0");
//   %g=$GROUND @ATTACH &VSS => @PLACE(0,-12) => @ORIENT("R0");
//   &A @WIRE(mode="straight") {%a:p %ga};
//   &A @WIRE(mode="straight") {#MP:g (-6,5) %ga (-6,-5) #MN:g};
//   &VDD @WIRE(mode="straight") {#MP:s %vp %v:p};
//   &VDD @WIRE(mode="straight") {#MP:d (4,3) %pb (4,10) %vp};
//   &VSS @WIRE(mode="straight") {#MN:s %vn %g:p};
//   &VSS @WIRE(mode="straight") {#MN:d (4,-3) %nb (4,-10) %vn};
//   (-10,18) @TEXT("adc_sarlogic_gatecap", size=1.1, textcolor="#1a365d", bold=true, halign="start");
//   (-10,16) @TEXT("Complementary HVT MOS Gate/Varactor Delay Load (drain/source tied to rail)", size=0.75, textcolor="#334155", halign="start");
//   (-10,-16) @TEXT("MP: pch_hvt_mac (W=wp, L=lp, nf=np); MN: nch_hvt_mac (W=wn, L=ln, nf=nn)", size=0.65, textcolor="#4a5568", halign="start");
//   $JUNCTION @ATTACH %ga; $JUNCTION @ATTACH %vp; $JUNCTION @ATTACH %vn;
// }
ends adc_sarlogic_gatecap

subckt adc_sarlogic_dlat (D LAT_EN Q VDD VSS)
XINV (D d_b VDD VSS) adc_sarlogic_inv wn=600n wp=900n nn=2 np=2
XSET (D LAT_EN set_b VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=1.0u nn=2 np=2
XRST (d_b LAT_EN rst_b VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=1.0u nn=2 np=2
XSRQ (set_b q_b q_i VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=1.0u nn=2 np=2
XSRQB (q_i rst_b q_b VDD VSS) adc_sarlogic_nand2 wn=1.6u wp=1.6u nn=2 np=2
XDRV (q_b Q VDD VSS) adc_sarlogic_inv wn=3.6u wp=5.4u nn=4 np=6
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $D_FLIP_FLOP_Q_ONLY;
//   $gate_ink = @DEFINE-STYLE(linecolor="#243b53", textcolor="#243b53") {};
//   $clk_route = @DEFINE-STYLE(linecolor="#b7791f", textcolor="#975a16") {};
//   $data_route = @DEFINE-STYLE(linecolor="#2b6cb0", textcolor="#2c5282") {};
//   # @SELECT-INSTANCE => @SET-STYLE $gate_ink;
//   {#XSET #XRST} @GROUP; {#XSRQ #XSRQB} @GROUP;
//   #XINV @PLACE(-6, -3);
//   #XINV @TEXT("${name}", key="name", dx=0, dy=2.4, size=0.65, halign="middle");
//   #XINV @TEXT("${wn}/${wp}", key="sizes", dx=0, dy=-2.8, size=0.52, halign="middle");
//   #XSET @PLACE(4, 4);
//   #XSET @TEXT("${name}", key="name", dx=0, dy=2.4, size=0.65, halign="middle");
