ends adc_sarlogic_dlat

subckt adc_sarlogic_slice (CMPP CMPN GO_IN IDLE_B RST_B UP DN Q GO_OUT REQ_B VDD VSS)
parameters wn_c=400n wp_c=600n ln_c=30n lp_c=30n nn_c=2 np_c=2
XTOK_SET (GO_IN IDLE_B tok_set_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XTOK_Q (tok_set_b tok_b en_k VDD VSS) adc_sarlogic_nand2 wn=1.2u wp=1.2u nn=2 np=2
XTOK_QB (en_k RST_B tok_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XSETP (CMPP en_k dn_b set_pb VDD VSS) adc_sarlogic_nand3 wn=3.0u wp=800n nn=2 np=2
XSETN (CMPN en_k up_b set_nb VDD VSS) adc_sarlogic_nand3 wn=3.0u wp=800n nn=2 np=2
XUP_Q (set_pb up_b Q VDD VSS) adc_sarlogic_nand2 wn=800n wp=4.8u nn=2 np=6
XUP_QB (Q RST_B up_b VDD VSS) adc_sarlogic_nand2 wn=6.0u wp=1.0u nn=6 np=2
XDN_Q (set_nb dn_b dn_q VDD VSS) adc_sarlogic_nand2 wn=800n wp=4.8u nn=2 np=6
XDN_QB (dn_q RST_B dn_b VDD VSS) adc_sarlogic_nand2 wn=6.0u wp=1.0u nn=6 np=2
XDRV_UP (up_b UP VDD VSS) adc_sarlogic_inv wn=1.6u wp=8.8u nn=2 np=8
XDRV_DN (dn_b DN VDD VSS) adc_sarlogic_inv wn=1.6u wp=8.8u nn=2 np=8
XREQ (GO_IN up_b dn_b REQ_B VDD VSS) adc_sarlogic_nand3 wn=3.6u wp=1.8u nn=4 np=2
XDONE (up_b dn_b done VDD VSS) adc_sarlogic_nand2 wn=3.6u wp=2.4u nn=4 np=2
XC0 (done VDD VSS) adc_sarlogic_gatecap wn=wn_c wp=wp_c ln=ln_c lp=lp_c nn=nn_c np=np_c
XD1 (done d1 VDD VSS) adc_sarlogic_inv wn=1.0u wp=1.5u nn=2 np=2
XC1 (d1 VDD VSS) adc_sarlogic_gatecap wn=wn_c wp=wp_c ln=ln_c lp=lp_c nn=nn_c np=np_c
XD2 (d1 d2 VDD VSS) adc_sarlogic_inv wn=1.0u wp=1.5u nn=2 np=2
XC2 (d2 VDD VSS) adc_sarlogic_gatecap wn=wn_c wp=wp_c ln=ln_c lp=lp_c nn=nn_c np=np_c
XD3 (d2 d3 VDD VSS) adc_sarlogic_inv wn=1.0u wp=1.5u nn=2 np=2
XC3 (d3 VDD VSS) adc_sarlogic_gatecap wn=wn_c wp=wp_c ln=ln_c lp=lp_c nn=nn_c np=np_c
XD4 (d3 GO_OUT VDD VSS) adc_sarlogic_inv wn=3.6u wp=3.6u nn=4 np=4
// @RNL {
