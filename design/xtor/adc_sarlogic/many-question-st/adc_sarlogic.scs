subckt adc_sarlogic_slice14 (CMPP CMPN GO_IN IDLE_B RST_B Q REQ_B DONE VDD VSS)
XTOK_SET (GO_IN IDLE_B tok_set_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XTOK_Q (tok_set_b tok_b en_k VDD VSS) adc_sarlogic_nand2 wn=1.2u wp=1.2u nn=2 np=2
XTOK_QB (en_k RST_B tok_b VDD VSS) adc_sarlogic_nand2 wn=600n wp=600n nn=2 np=2
XSETP (CMPP en_k dn_b set_pb VDD VSS) adc_sarlogic_nand3 wn=3.0u wp=800n nn=2 np=2
XSETN (CMPN en_k up_b set_nb VDD VSS) adc_sarlogic_nand3 wn=3.0u wp=800n nn=2 np=2
XUP_Q (set_pb up_b Q VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=4.8u nn=2 np=6
XUP_QB (Q RST_B up_b VDD VSS) adc_sarlogic_nand2 wn=6.0u wp=1.2u nn=6 np=2
XDN_Q (set_nb dn_b dn_q VDD VSS) adc_sarlogic_nand2 wn=1.0u wp=4.8u nn=2 np=6
XDN_QB (dn_q RST_B dn_b VDD VSS) adc_sarlogic_nand2 wn=6.0u wp=1.2u nn=6 np=2
XREQ (GO_IN up_b dn_b REQ_B VDD VSS) adc_sarlogic_nand3 wn=3.6u wp=1.8u nn=4 np=2
XDONE (up_b dn_b DONE VDD VSS) adc_sarlogic_nand2 wn=1.4u wp=2.4u nn=2 np=2
// @RNL {
//   &VDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   %slice14_sym = @DEFINE-SYMBOL(box=[-8, -6, 8, 6]) {
//     @LINE(linewidth=0.24) {(-6, -5) (6, -5) (6, 5) (-6, 5) (-6, -5)};
//     (-8, 3) @PIN(terminal=1, direction="left"); @LINE {(-8, 3) (-6, 3)};
//     (-5.65, 3) @TEXT("CMPP", size=0.52, halign="start", valign="middle");
//     (-8, 1) @PIN(terminal=2, direction="left"); @LINE {(-8, 1) (-6, 1)};
//     (-5.65, 1) @TEXT("CMPN", size=0.52, halign="start", valign="middle");
//     (0, 6) @PIN(terminal=3, direction="up"); @LINE {(0, 6) (0, 5)};
//     (0, 4.55) @TEXT("GO_IN", size=0.5, halign="middle", valign="top");
//     (-8, -1) @PIN(terminal=4, direction="left"); @LINE {(-8, -1) (-6, -1)};
//     (-5.65, -1) @TEXT("IDLE_B", size=0.52, halign="start", valign="middle");
//     (-8, -3) @PIN(terminal=5, direction="left"); @LINE {(-8, -3) (-6, -3)};
//     (-5.65, -3) @TEXT("RST_B", size=0.52, halign="start", valign="middle");
//     (8, -3) @PIN(terminal=6, direction="right"); @LINE {(8, -3) (6, -3)};
//     (5.65, -3) @TEXT("Q", size=0.52, halign="end", valign="middle");
//     (8, 3) @PIN(terminal=7, direction="right"); @LINE {(8, 3) (6, 3)};
//     (5.65, 3) @TEXT("REQ_B", size=0.52, halign="end", valign="middle");
//     (0, -6) @PIN(terminal=8, direction="down"); @LINE {(0, -6) (0, -5)};
//     (0, -4.55) @TEXT("DONE", size=0.5, halign="middle", valign="bottom");
//     @LINE {(-1.8, -0.8) (1.8, -0.8) (1.8, 1.4) (-1.8, 1.4) (-1.8, -0.8)};
//     (0, 0.7) @TEXT("LSB 14", size=0.45, bold=true, halign="middle", valign="middle");
//     (0, -0.2) @TEXT("SR+EOC", size=0.42, halign="middle", valign="middle");
