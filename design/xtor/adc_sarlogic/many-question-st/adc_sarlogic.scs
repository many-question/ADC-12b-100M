//     @LINE {(-3.8, 3.2) (3.8, 3.2) (3.8, 6.2) (-3.8, 6.2) (-3.8, 3.2)};
//     (0, 4.7) @TEXT("RST & START", size=0.46, halign="middle", valign="middle");
//     @LINE {(-3.8, -3.5) (3.8, -3.5) (3.8, 2.2) (-3.8, 2.2) (-3.8, -3.5)};
