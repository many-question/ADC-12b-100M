//   &sb @WIRE(mode="straight") {%p3:p %j2 (11,-6) #p2:sb};
//   &sb @WIRE(mode="straight") {#p1:sb %j2};
//   (-10,4) @TEXT("rch2: two rpair in a row", size=0.8, textcolor="#334155", bold=true, halign="start");
// }
ends rch2

subckt rch4 (a s sb y vdd vss)
  p1 (a  s sb y1 vdd vss) rch2
  p2 (y1 s sb y  vdd vss) rch2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
