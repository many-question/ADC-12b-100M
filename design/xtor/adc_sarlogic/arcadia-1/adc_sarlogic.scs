// latch gate that is also the UP / DN output: strong pull-up into 15 fF
subckt nand2up (a b y vdd vss)
  mp1 (y a vdd vdd) pch_lvt_mac w=2.0u l=30n nf=10
  mp2 (y b vdd vdd) pch_lvt_mac w=2.0u l=30n nf=10
  mn1 (y a m1 vss) nch_lvt_mac w=1.6u l=30n nf=8
  mn2 (m1 b vss vss) nch_lvt_mac w=1.6u l=30n nf=8
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(8,8) => @ORIENT("R0");
//   #mn2 @PLACE(0,-6) => @ORIENT("R0");
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(12,13) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {(0,13) (2,13) (8,13) (10,13) %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:s (0,13)};
//   %j1=(2,13); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp1:b (2,8) (2,13)};
//   %j2=(8,13); $JUNCTION @ATTACH %j2;
//   &vdd @WIRE(mode="straight") {#mp2:s (8,13)};
//   %j3=(10,13); $JUNCTION @ATTACH %j3;
//   &vdd @WIRE(mode="straight") {#mp2:b (10,8) (10,13)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j4=(0,4); $JUNCTION @ATTACH %j4;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j5=(8,4); $JUNCTION @ATTACH %j5;
//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-10) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn2:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-10) %p3:p};
//   %j6=(3,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (3,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %j7=(-6,0); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mn1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,8) #mp1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,-6) => @ORIENT("R0");
//   %j8=(-8,-6); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mn2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,11) (3,11) (3,8) #mp2:g};
//   (-14,17) @TEXT("nand2up", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,10) @TEXT("mp1  pch_lvt  2.0u/30n  nf=10", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,8.6) @TEXT("mp2  pch_lvt  2.0u/30n  nf=10", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,7.2) @TEXT("mn1  nch_lvt  1.6u/30n  nf=8", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,5.8) @TEXT("mn2  nch_lvt  1.6u/30n  nf=8", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends nand2up

// NOR set/reset latch, active-high inputs, reset dominant
subckt srl (s r q qb vdd vss)
  g1 (r qb q vdd vss) nor2
  g2 (s q qb vdd vss) nor2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %srl = @DEFINE-SYMBOL(box=[-4, -2, 4, 2]) {
//     @LINE(linewidth=0.24) {(-3, -2) (3, -2) (3, 2) (-3, 2) (-3, -2)};
//     (-4, 1) @PIN(terminal=1, direction="left");
//     @LINE {(-4, 1) (-3, 1)};
//     (-2.7, 1) @TEXT("S", size=0.5, halign="start", valign="middle");
//     (-4, -1) @PIN(terminal=2, direction="left");
//     @LINE {(-4, -1) (-3, -1)};
//     (-2.7, -1) @TEXT("R", size=0.5, halign="start", valign="middle");
//     (4, 1) @PIN(terminal=3, direction="right");
//     @LINE {(4, 1) (3, 1)};
//     (2.7, 1) @TEXT("Q", size=0.5, halign="end", valign="middle");
//     (4, -1) @PIN(terminal=4, direction="right");
//     @LINE {(4, -1) (3, -1)};
//     (2.7, -1) @TEXT("QB", size=0.5, halign="end", valign="middle");
//     (0, 0) @TEXT("SR", size=0.8, bold=true, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %srl;
//   {#g1 #g2} @GROUP;
//   #g1 @PLACE(0,4) => @ORIENT("R0");
//   #g2 @PLACE(0,-4) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &r => @PLACE(-10,5) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &s => @PLACE(-10,-3) => @ORIENT("R0");
//   %p3=$IO_PORT @ATTACH &q => @PLACE(11,4) => @ORIENT("MY");
//   %p4=$IO_PORT @ATTACH &qb => @PLACE(11,-4) => @ORIENT("MY");
//   &r @WIRE(mode="straight") {%p1:p #g1:a};
//   &s @WIRE(mode="straight") {%p2:p #g2:a};
//   %j1=(7,4); $JUNCTION @ATTACH %j1;
//   %j2=(6,-4); $JUNCTION @ATTACH %j2;
//   &q @WIRE(mode="straight") {#g1:y %j1 %p3:p};
//   &q @WIRE(mode="straight") {%j1 (7,1) (-6,1) (-6,-5) #g2:b};
//   &qb @WIRE(mode="straight") {#g2:y %j2 %p4:p};
//   &qb @WIRE(mode="straight") {%j2 (6,-1) (-5,-1) (-5,3) #g1:b};
//   (-10,9) @TEXT("srl: NOR set/reset latch, reset dominant", size=0.8, textcolor="#334155", bold=true, halign="start");
// }
ends srl

// ------------------------------------------------------------ gate-delay chains
subckt dnand2 (a b y vdd vss)
  mp1 (y a vdd vdd) pch_ulvt_mac w=0.4u l=60n nf=1
  mp2 (y b vdd vdd) pch_ulvt_mac w=0.4u l=60n nf=1
  mn1 (y a m1 vss) nch_ulvt_mac w=0.4u l=60n nf=1
  mn2 (m1 b vss vss) nch_ulvt_mac w=0.4u l=60n nf=1
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(8,8) => @ORIENT("R0");
//   #mn2 @PLACE(0,-6) => @ORIENT("R0");
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(12,13) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {(0,13) (2,13) (8,13) (10,13) %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:s (0,13)};
//   %j1=(2,13); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp1:b (2,8) (2,13)};
//   %j2=(8,13); $JUNCTION @ATTACH %j2;
//   &vdd @WIRE(mode="straight") {#mp2:s (8,13)};
//   %j3=(10,13); $JUNCTION @ATTACH %j3;
//   &vdd @WIRE(mode="straight") {#mp2:b (10,8) (10,13)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j4=(0,4); $JUNCTION @ATTACH %j4;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j5=(8,4); $JUNCTION @ATTACH %j5;
//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-10) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn2:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-10) %p3:p};
//   %j6=(3,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (3,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %j7=(-6,0); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mn1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,8) #mp1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,-6) => @ORIENT("R0");
//   %j8=(-8,-6); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mn2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,11) (3,11) (3,8) #mp2:g};
//   (-14,17) @TEXT("dnand2", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,10) @TEXT("mp1  pch_ulvt  0.4u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,8.6) @TEXT("mp2  pch_ulvt  0.4u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,7.2) @TEXT("mn1  nch_ulvt  0.4u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,5.8) @TEXT("mn2  nch_ulvt  0.4u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends dnand2

subckt dnor2 (a b y vdd vss)
  mp1 (y a m1 vdd) pch_ulvt_mac w=0.8u l=60n nf=1
  mp2 (m1 b vdd vdd) pch_ulvt_mac w=0.8u l=60n nf=1
  mn1 (y a vss vss) nch_ulvt_mac w=0.2u l=60n nf=1
  mn2 (y b vss vss) nch_ulvt_mac w=0.2u l=60n nf=1
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NOR_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(0,14) => @ORIENT("R0");
//   #mn2 @PLACE(8,0) => @ORIENT("R0");
//   &m1 @WIRE(mode="straight") {#mp1:s #mp2:d};
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(0,19) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {#mp2:s %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:b (3,8) (3,14) (3,19) %p1:p};
//   %j1=(3,14); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp2:b (3,14)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j2=(0,4); $JUNCTION @ATTACH %j2;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j3=(8,4); $JUNCTION @ATTACH %j3;
//   &y @WIRE(mode="straight") {#mn2:d (8,4)};
//   %p3=$GROUND @ATTACH &vss => @PLACE(12,-6) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {(0,-6) (2,-6) (8,-6) (10,-6) %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:s (0,-6)};
//   %j4=(2,-6); $JUNCTION @ATTACH %j4;
//   &vss @WIRE(mode="straight") {#mn1:b (2,0) (2,-6)};
//   %j5=(8,-6); $JUNCTION @ATTACH %j5;
//   &vss @WIRE(mode="straight") {#mn2:s (8,-6)};
//   %j6=(10,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (10,0) (10,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,8) => @ORIENT("R0");
//   %j7=(-6,8); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mp1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,0) #mn1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,14) => @ORIENT("R0");
//   %j8=(-8,14); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mp2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,-3) (3,-3) (3,0) #mn2:g};
//   (-14,23) @TEXT("dnor2", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,19) @TEXT("mp1  pch_ulvt  0.8u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,17.6) @TEXT("mp2  pch_ulvt  0.8u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,16.2) @TEXT("mn1  nch_ulvt  0.2u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,14.8) @TEXT("mn2  nch_ulvt  0.2u/60n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends dnor2

// One resettable pair: while s is high y follows a, two gate delays later; when s
// falls, y goes low within one gate whatever a is doing.
subckt rpair (a s sb y vdd vss)
  g1 (a s m vdd vss) dnand2
  g2 (m sb y vdd vss) dnor2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %rpair = @DEFINE-SYMBOL(box=[-4, -3, 4, 2]) {
//     @LINE(linewidth=0.24) {(-3, -2) (3, -2) (3, 2) (-3, 2) (-3, -2)};
//     (-4, 0) @PIN(terminal=1, direction="left");
//     @LINE {(-4, 0) (-3, 0)};
//     (-2.7, 0) @TEXT("in", size=0.5, halign="start", valign="middle");
//     (-1, -3) @PIN(terminal=2, direction="down");
//     @LINE {(-1, -3) (-1, -2)};
//     (-1, -1.65) @TEXT("s", size=0.5, halign="middle", valign="bottom");
//     (1, -3) @PIN(terminal=3, direction="down");
//     @LINE {(1, -3) (1, -2)};
//     (1, -1.65) @TEXT("sb", size=0.5, halign="middle", valign="bottom");
//     (4, 0) @PIN(terminal=4, direction="right");
//     @LINE {(4, 0) (3, 0)};
//     (2.7, 0) @TEXT("out", size=0.5, halign="end", valign="middle");
//     (0, 0.35) @TEXT("rpair", size=0.8, bold=true, halign="middle", valign="middle");
//     (0, -0.75) @TEXT("ulvt L=60n, ~13 ps", size=0.45, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %rpair;
//   {#g1 #g2} @GROUP;
//   #g1 @PLACE(0,0) => @ORIENT("R0");
//   #g2 @PLACE(10,0) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-10,1) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &s => @PLACE(-10,-1) => @ORIENT("R0");
//   %p3=$IO_PORT @ATTACH &sb => @PLACE(-10,-4) => @ORIENT("R0");
//   %p4=$IO_PORT @ATTACH &y => @PLACE(17,0) => @ORIENT("MY");
//   &a @WIRE(mode="straight") {%p1:p #g1:a};
//   &s @WIRE(mode="straight") {%p2:p #g1:b};
//   &m @WIRE(mode="straight") {#g1:y (5,0) (5,1) #g2:a};
//   &sb @WIRE(mode="straight") {%p3:p (6,-4) (6,-1) #g2:b};
//   &y @WIRE(mode="straight") {#g2:y %p4:p};
//   (-10,5) @TEXT("rpair: resettable delay pair (ulvt L=60n, ~13 ps)", size=0.8, textcolor="#334155", bold=true, halign="start");
//   (-10,-7) @TEXT("s high: y follows a two gates later.  s low (sb high): y = 0 within one gate.", size=0.6, textcolor="#334155", bold=false, halign="start");
// }
ends rpair

subckt fnand2 (a b y vdd vss)
  mp1 (y a vdd vdd) pch_ulvt_mac w=0.4u l=30n nf=1
  mp2 (y b vdd vdd) pch_ulvt_mac w=0.4u l=30n nf=1
  mn1 (y a m1 vss) nch_ulvt_mac w=0.4u l=30n nf=1
  mn2 (m1 b vss vss) nch_ulvt_mac w=0.4u l=30n nf=1
