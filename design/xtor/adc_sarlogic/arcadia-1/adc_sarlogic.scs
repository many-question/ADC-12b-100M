//   (-10,4) @TEXT("rch4: two rch2 in a row", size=0.8, textcolor="#334155", bold=true, halign="start");
// }
ends rch4

// Negative pulse on a rising edge of a, one gate after the edge, about four pairs wide.
subckt pulsen (a pn vdd vss)
  ib (a ab vdd vss) inv
  ch (a a ab y vdd vss) rch4
  iy (y yb vdd vss) inv
  g  (a yb pn vdd vss) nand2         // pn = NOT(a . NOT y)
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %pulsen = @DEFINE-SYMBOL(box=[-4, -2, 4, 2]) {
//     @LINE(linewidth=0.24) {(-3, -2) (3, -2) (3, 2) (-3, 2) (-3, -2)};
//     (-4, 0) @PIN(terminal=1, direction="left");
//     @LINE {(-4, 0) (-3, 0)};
//     (-2.7, 0) @TEXT("a", size=0.5, halign="start", valign="middle");
//     (4, 0) @PIN(terminal=2, direction="right");
//     @LINE {(4, 0) (3, 0)};
//     (2.7, 0) @TEXT("pn", size=0.5, halign="end", valign="middle");
//     (0, 0.35) @TEXT("pulse", size=0.8, bold=true, halign="middle", valign="middle");
//     (0, -0.75) @TEXT("low, on a rising", size=0.45, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %pulsen;
//   #ch @PLACE(6,0) => @ORIENT("R0");
//   #ib @PLACE(-3,-9) => @ORIENT("R0");
//   #iy @PLACE(15,0) => @ORIENT("R0");
//   #g @PLACE(26,1) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &pn => @PLACE(33,1) => @ORIENT("MY");
//   %j1=(-8,0); $JUNCTION @ATTACH %j1;
//   %j2=(-8,-5); $JUNCTION @ATTACH %j2;
//   %j3=(7,-9); $JUNCTION @ATTACH %j3;
//   &a @WIRE(mode="straight") {%p1:p %j1 #ch:a};
//   &a @WIRE(mode="straight") {%j1 %j2 (5,-5) #ch:s};
//   &a @WIRE(mode="straight") {%j2 (-8,-9) #ib:a};
//   &a @WIRE(mode="straight") {%j1 (-8,5) (21,5) (21,2) #g:a};
//   &ab @WIRE(mode="straight") {#ib:y %j3 #ch:sb};
//   &y @WIRE(mode="straight") {#ch:y #iy:a};
//   &yb @WIRE(mode="straight") {#iy:y #g:b};
//   &pn @WIRE(mode="straight") {#g:y %p2:p};
//   (-14,9) @TEXT("pulsen: pn = NOT(a AND NOT(a delayed by four pairs)), one gate after the edge", size=0.8, textcolor="#334155", bold=true, halign="start");
// }
ends pulsen

// Positive pulse on a rising edge of a, four pairs wide.
subckt pulse (a p vdd vss)
  ib (a ab vdd vss) inv
  ch (a a ab y vdd vss) rch4
  g  (ab y p vdd vss) nor2           // p = a . NOT y
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %pulse = @DEFINE-SYMBOL(box=[-4, -2, 4, 2]) {
//     @LINE(linewidth=0.24) {(-3, -2) (3, -2) (3, 2) (-3, 2) (-3, -2)};
//     (-4, 0) @PIN(terminal=1, direction="left");
//     @LINE {(-4, 0) (-3, 0)};
//     (-2.7, 0) @TEXT("a", size=0.5, halign="start", valign="middle");
//     (4, 0) @PIN(terminal=2, direction="right");
//     @LINE {(4, 0) (3, 0)};
//     (2.7, 0) @TEXT("p", size=0.5, halign="end", valign="middle");
//     (0, 0.35) @TEXT("pulse", size=0.8, bold=true, halign="middle", valign="middle");
//     (0, -0.75) @TEXT("on a rising", size=0.45, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %pulse;
//   #ch @PLACE(6,0) => @ORIENT("R0");
//   #ib @PLACE(-3,-9) => @ORIENT("R0");
//   #g @PLACE(20,-4) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &p => @PLACE(27,-4) => @ORIENT("MY");
//   %j1=(-8,0); $JUNCTION @ATTACH %j1;
//   %j2=(-8,-5); $JUNCTION @ATTACH %j2;
//   %j3=(7,-9); $JUNCTION @ATTACH %j3;
//   &a @WIRE(mode="straight") {%p1:p %j1 #ch:a};
//   &a @WIRE(mode="straight") {%j1 %j2 (5,-5) #ch:s};
//   &a @WIRE(mode="straight") {%j2 (-8,-9) #ib:a};
//   &ab @WIRE(mode="straight") {#ib:y %j3 #ch:sb};
//   &ab @WIRE(mode="straight") {%j3 (13,-9) (13,-3) #g:a};
//   &y @WIRE(mode="straight") {#ch:y (15,0) (15,-5) #g:b};
//   &p @WIRE(mode="straight") {#g:y %p2:p};
//   (-14,5) @TEXT("pulse: p = a AND NOT(a delayed by four pairs)", size=0.8, textcolor="#334155", bold=true, halign="start");
// }
ends pulse

// ------------------------------------------------------------------ one SAR step
// Set only while enabled and not yet decided, so the set closes itself once the
// latch has flipped and a later decision cannot reach this step again.
subckt step (en gu gd clrb blc up dn upb dec eno vdd vss)
  gdc (upb qbd dec vdd vss) nand2      // dec = up + dn
  idc (dec decb vdd vss) inv
  gsu (en gu decb sun vdd vss) nand3s
  lu1 (sun upb up vdd vss) nand2up      // up is the latch node, driving 15 fF
  lu2 (clrb up upb vdd vss) nand2       // upb = NOT up, read by the output register
  gsd (en gd decb sdn vdd vss) nand3s
  ld1 (sdn qbd dn vdd vss) nand2up
  ld2 (clrb dn qbd vdd vss) nand2
  gse (dec blc sen vdd vss) nand2      // enable the next step once reset with CLKC low
  le1 (sen enb eno vdd vss) nand2
  le2 (clrb eno enb vdd vss) nand2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %step = @DEFINE-SYMBOL(box=[-5, -7, 5, 7]) {
//     @LINE(linewidth=0.24) {(-4, -6) (4, -6) (4, 6) (-4, 6) (-4, -6)};
//     (0, 7) @PIN(terminal=1, direction="up");
//     @LINE {(0, 7) (0, 6)};
//     (0, 5.65) @TEXT("en", size=0.5, halign="middle", valign="top");
//     (-5, 3) @PIN(terminal=2, direction="left");
//     @LINE {(-5, 3) (-4, 3)};
//     (-3.7, 3) @TEXT("gu", size=0.5, halign="start", valign="middle");
//     (-5, 1) @PIN(terminal=3, direction="left");
//     @LINE {(-5, 1) (-4, 1)};
//     (-3.7, 1) @TEXT("gd", size=0.5, halign="start", valign="middle");
//     (-5, -1) @PIN(terminal=4, direction="left");
//     @LINE {(-5, -1) (-4, -1)};
//     (-3.7, -1) @TEXT("clrb", size=0.5, halign="start", valign="middle");
//     (-5, -3) @PIN(terminal=5, direction="left");
//     @LINE {(-5, -3) (-4, -3)};
//     (-3.7, -3) @TEXT("blc", size=0.5, halign="start", valign="middle");
//     (5, 3) @PIN(terminal=6, direction="right");
//     @LINE {(5, 3) (4, 3)};
//     (3.7, 3) @TEXT("up", size=0.5, halign="end", valign="middle");
//     (5, 1) @PIN(terminal=7, direction="right");
//     @LINE {(5, 1) (4, 1)};
//     (3.7, 1) @TEXT("dn", size=0.5, halign="end", valign="middle");
//     (5, -1) @PIN(terminal=8, direction="right");
//     @LINE {(5, -1) (4, -1)};
//     (3.7, -1) @TEXT("upb", size=0.5, halign="end", valign="middle");
//     (5, -3) @PIN(terminal=9, direction="right");
//     @LINE {(5, -3) (4, -3)};
//     (3.7, -3) @TEXT("dec", size=0.5, halign="end", valign="middle");
//     (0, -7) @PIN(terminal=10, direction="down");
//     @LINE {(0, -7) (0, -6)};
//     (0, -5.65) @TEXT("eno", size=0.5, halign="middle", valign="bottom");
//     (0, 0) @TEXT("STEP", size=0.8, bold=true, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %step;
//   {#gsu #lu1 #lu2} @GROUP; {#gsd #ld1 #ld2} @GROUP; {#gdc #idc #gse #le1 #le2} @GROUP;
//   #gsu @PLACE(0,12) => @ORIENT("R0");
//   #lu1 @PLACE(12,12) => @ORIENT("R0");
//   #lu2 @PLACE(12,5) => @ORIENT("R0");
//   #gsd @PLACE(0,-4) => @ORIENT("R0");
//   #ld1 @PLACE(12,-4) => @ORIENT("R0");
//   #ld2 @PLACE(12,-11) => @ORIENT("R0");
//   #gdc @PLACE(28,0) => @ORIENT("R0");
//   #idc @PLACE(38,-8) => @ORIENT("R0");
//   #gse @PLACE(40,-20) => @ORIENT("R0");
//   #le1 @PLACE(52,-20) => @ORIENT("R0");
//   #le2 @PLACE(52,-27) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &en => @PLACE(-14,15) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &gu => @PLACE(-14,12) => @ORIENT("R0");
//   %p3=$IO_PORT @ATTACH &gd => @PLACE(-14,-4) => @ORIENT("R0");
//   %p4=$IO_PORT @ATTACH &clrb => @PLACE(-14,-24) => @ORIENT("R0");
//   %p5=$IO_PORT @ATTACH &blc => @PLACE(-14,-21) => @ORIENT("R0");
//   %p6=$IO_PORT @ATTACH &up => @PLACE(64,12) => @ORIENT("MY");
