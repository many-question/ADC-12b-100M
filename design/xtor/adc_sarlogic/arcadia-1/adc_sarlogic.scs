subckt fnor2 (a b y vdd vss)
  mp1 (y a m1 vdd) pch_ulvt_mac w=0.8u l=30n nf=1
  mp2 (m1 b vdd vdd) pch_ulvt_mac w=0.8u l=30n nf=1
  mn1 (y a vss vss) nch_ulvt_mac w=0.2u l=30n nf=1
  mn2 (y b vss vss) nch_ulvt_mac w=0.2u l=30n nf=1
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NOR_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(0,14) => @ORIENT("R0");
//   #mn2 @PLACE(8,0) => @ORIENT("R0");
//   &m1 @WIRE(mode="straight") {#mp1:s #mp2:d};
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(0,19) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {#mp2:s %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:b (3,8) (3,14) (3,19) %p1:p};
//   %j1=(3,14); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp2:b (3,14)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j2=(0,4); $JUNCTION @ATTACH %j2;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j3=(8,4); $JUNCTION @ATTACH %j3;
//   &y @WIRE(mode="straight") {#mn2:d (8,4)};
//   %p3=$GROUND @ATTACH &vss => @PLACE(12,-6) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {(0,-6) (2,-6) (8,-6) (10,-6) %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:s (0,-6)};
//   %j4=(2,-6); $JUNCTION @ATTACH %j4;
//   &vss @WIRE(mode="straight") {#mn1:b (2,0) (2,-6)};
//   %j5=(8,-6); $JUNCTION @ATTACH %j5;
//   &vss @WIRE(mode="straight") {#mn2:s (8,-6)};
//   %j6=(10,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (10,0) (10,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,8) => @ORIENT("R0");
//   %j7=(-6,8); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mp1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,0) #mn1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,14) => @ORIENT("R0");
//   %j8=(-8,14); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mp2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,-3) (3,-3) (3,0) #mn2:g};
//   (-14,23) @TEXT("fnor2", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,19) @TEXT("mp1  pch_ulvt  0.8u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,17.6) @TEXT("mp2  pch_ulvt  0.8u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,16.2) @TEXT("mn1  nch_ulvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,14.8) @TEXT("mn2  nch_ulvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends fnor2

// as rpair at L = 30 nm: about half the delay, for fine steps
subckt fpair (a s sb y vdd vss)
  g1 (a s m vdd vss) fnand2
  g2 (m sb y vdd vss) fnor2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %fpair = @DEFINE-SYMBOL(box=[-4, -3, 4, 2]) {
//     @LINE(linewidth=0.24) {(-3, -2) (3, -2) (3, 2) (-3, 2) (-3, -2)};
//     (-4, 0) @PIN(terminal=1, direction="left");
//     @LINE {(-4, 0) (-3, 0)};
//     (-2.7, 0) @TEXT("in", size=0.5, halign="start", valign="middle");
//     (-1, -3) @PIN(terminal=2, direction="down");
//     @LINE {(-1, -3) (-1, -2)};
//     (-1, -1.65) @TEXT("s", size=0.5, halign="middle", valign="bottom");
//     (1, -3) @PIN(terminal=3, direction="down");
//     @LINE {(1, -3) (1, -2)};
//     (1, -1.65) @TEXT("sb", size=0.5, halign="middle", valign="bottom");
//     (4, 0) @PIN(terminal=4, direction="right");
//     @LINE {(4, 0) (3, 0)};
//     (2.7, 0) @TEXT("out", size=0.5, halign="end", valign="middle");
//     (0, 0.35) @TEXT("fpair", size=0.8, bold=true, halign="middle", valign="middle");
//     (0, -0.75) @TEXT("ulvt L=30n, ~7 ps", size=0.45, halign="middle", valign="middle");
//   };
//   # @SET-SYMBOL %fpair;
//   {#g1 #g2} @GROUP;
//   #g1 @PLACE(0,0) => @ORIENT("R0");
//   #g2 @PLACE(10,0) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-10,1) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &s => @PLACE(-10,-1) => @ORIENT("R0");
//   %p3=$IO_PORT @ATTACH &sb => @PLACE(-10,-4) => @ORIENT("R0");
//   %p4=$IO_PORT @ATTACH &y => @PLACE(17,0) => @ORIENT("MY");
//   &a @WIRE(mode="straight") {%p1:p #g1:a};
//   &s @WIRE(mode="straight") {%p2:p #g1:b};
//   &m @WIRE(mode="straight") {#g1:y (5,0) (5,1) #g2:a};
//   &sb @WIRE(mode="straight") {%p3:p (6,-4) (6,-1) #g2:b};
//   &y @WIRE(mode="straight") {#g2:y %p4:p};
//   (-10,5) @TEXT("fpair: resettable delay pair (ulvt L=30n, ~7 ps)", size=0.8, textcolor="#334155", bold=true, halign="start");
//   (-10,-7) @TEXT("s high: y follows a two gates later.  s low (sb high): y = 0 within one gate.", size=0.6, textcolor="#334155", bold=false, halign="start");
// }
ends fpair

// between rpair and fpair: the NAND at L = 60 nm, the NOR at L = 30 nm
subckt mpair (a s sb y vdd vss)
  g1 (a s m vdd vss) dnand2
  g2 (m sb y vdd vss) fnor2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   %mpair = @DEFINE-SYMBOL(box=[-4, -3, 4, 2]) {
