// adc_sarlogic, candidate arcadia-1: asynchronous SAR controller, transistor view
//
// Contract: specs/blocks/adc_sarlogic.yaml (0.5.0) and the behavioural reference
// design/behav/veriloga/adc_sarlogic_va.va.
//
// Sequencing without a shift register. The UP/DN latches of a step are its token:
// a step may be set only while its enable is high and it is not yet decided, and
// the enable of the next step is a latch set by "decided" once the comparator has
// reset and CLKC is low. The enables therefore cannot move while CLKC is high, so a
// CLKC pulse can decide exactly one step.
//
// The DAC wait after decision k is chosen from the decided flags, which are stable
// from the decision on: fast after 1-2, fast + 10 ps after 3, fast + 30 ps after
// 4-6, slow after 7-8 and 10-13, slow + 25 ps after 9 (specs/arch.yaml t_dac_add).
//
// Delays are gate delays only, no capacitor devices. Every delay is a chain of
// resettable pairs (ulvt NAND2 then NOR2 at L = 60 nm, whose loads are the next gate,
// i.e. oxide capacitance, so the corner spread stays near 0.75 .. 1.40 of typical).
// A chain times one edge of its start signal and clears within one gate when the
// start signal drops, so a short CLKC phase never carries one wait into the next.

// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../../rnl/adc28.rnl");
// }
simulator lang=spectre

// ---------------------------------------------------------------- primitives (lvt)
subckt inv (a y vdd vss)
  mp (y a vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mn (y a vss vss) nch_lvt_mac w=0.2u l=30n nf=1
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $INVERTER;
//   {#mp #mn} @GROUP; {#mp #mn} @TEXT("", key="model");
//   #mp @PLACE(0,5) => @ORIENT("R0");
//   #mn @PLACE(0,-5) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-10,0) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &y => @PLACE(8,0) => @ORIENT("MY");
//   %p3=$SUPPLY @ATTACH &vdd => @PLACE(0,12) => @ORIENT("R0");
//   %p4=$GROUND @ATTACH &vss => @PLACE(0,-12) => @ORIENT("R0");
//   %j1=(-6,0); $JUNCTION @ATTACH %j1;
//   %j2=(0,0); $JUNCTION @ATTACH %j2;
//   %j3=(0,10); $JUNCTION @ATTACH %j3;
//   %j4=(0,-10); $JUNCTION @ATTACH %j4;
//   &a @WIRE(mode="straight") {%p1:p %j1};
//   &a @WIRE(mode="straight") {#mp:g (-6,5) %j1 (-6,-5) #mn:g};
//   &y @WIRE(mode="straight") {#mp:d %j2 #mn:d};
//   &y @WIRE(mode="straight") {%j2 %p2:p};
//   &vdd @WIRE(mode="straight") {#mp:s %j3 %p3:p};
//   &vdd @WIRE(mode="straight") {#mp:b (3,5) (3,10) %j3};
//   &vss @WIRE(mode="straight") {#mn:s %j4 %p4:p};
//   &vss @WIRE(mode="straight") {#mn:b (3,-5) (3,-10) %j4};
//   (-10,16) @TEXT("inv", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (5,6) @TEXT("mp  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (5,-4.5) @TEXT("mn  nch_lvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends inv

subckt invx4 (a y vdd vss)
  mp (y a vdd vdd) pch_lvt_mac w=1.6u l=30n nf=8
  mn (y a vss vss) nch_lvt_mac w=0.8u l=30n nf=4
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $INVERTER;
//   {#mp #mn} @GROUP; {#mp #mn} @TEXT("", key="model");
//   #mp @PLACE(0,5) => @ORIENT("R0");
//   #mn @PLACE(0,-5) => @ORIENT("R0");
//   %p1=$IO_PORT @ATTACH &a => @PLACE(-10,0) => @ORIENT("R0");
//   %p2=$IO_PORT @ATTACH &y => @PLACE(8,0) => @ORIENT("MY");
//   %p3=$SUPPLY @ATTACH &vdd => @PLACE(0,12) => @ORIENT("R0");
//   %p4=$GROUND @ATTACH &vss => @PLACE(0,-12) => @ORIENT("R0");
//   %j1=(-6,0); $JUNCTION @ATTACH %j1;
//   %j2=(0,0); $JUNCTION @ATTACH %j2;
//   %j3=(0,10); $JUNCTION @ATTACH %j3;
//   %j4=(0,-10); $JUNCTION @ATTACH %j4;
//   &a @WIRE(mode="straight") {%p1:p %j1};
//   &a @WIRE(mode="straight") {#mp:g (-6,5) %j1 (-6,-5) #mn:g};
//   &y @WIRE(mode="straight") {#mp:d %j2 #mn:d};
//   &y @WIRE(mode="straight") {%j2 %p2:p};
//   &vdd @WIRE(mode="straight") {#mp:s %j3 %p3:p};
//   &vdd @WIRE(mode="straight") {#mp:b (3,5) (3,10) %j3};
//   &vss @WIRE(mode="straight") {#mn:s %j4 %p4:p};
//   &vss @WIRE(mode="straight") {#mn:b (3,-5) (3,-10) %j4};
//   (-10,16) @TEXT("invx4", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (5,6) @TEXT("mp  pch_lvt  1.6u/30n  nf=8", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (5,-4.5) @TEXT("mn  nch_lvt  0.8u/30n  nf=4", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends invx4

subckt nand2 (a b y vdd vss)
  mp1 (y a vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mp2 (y b vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mn1 (y a m1 vss) nch_lvt_mac w=0.4u l=30n nf=2
  mn2 (m1 b vss vss) nch_lvt_mac w=0.4u l=30n nf=2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(8,8) => @ORIENT("R0");
//   #mn2 @PLACE(0,-6) => @ORIENT("R0");
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(12,13) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {(0,13) (2,13) (8,13) (10,13) %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:s (0,13)};
//   %j1=(2,13); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp1:b (2,8) (2,13)};
//   %j2=(8,13); $JUNCTION @ATTACH %j2;
//   &vdd @WIRE(mode="straight") {#mp2:s (8,13)};
//   %j3=(10,13); $JUNCTION @ATTACH %j3;
//   &vdd @WIRE(mode="straight") {#mp2:b (10,8) (10,13)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j4=(0,4); $JUNCTION @ATTACH %j4;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j5=(8,4); $JUNCTION @ATTACH %j5;
//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-10) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn2:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-10) %p3:p};
//   %j6=(3,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (3,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %j7=(-6,0); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mn1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,8) #mp1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,-6) => @ORIENT("R0");
//   %j8=(-8,-6); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mn2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,11) (3,11) (3,8) #mp2:g};
//   (-14,17) @TEXT("nand2", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,10) @TEXT("mp1  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,8.6) @TEXT("mp2  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,7.2) @TEXT("mn1  nch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,5.8) @TEXT("mn2  nch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends nand2

// half-width NAND2: a fine step of a few ps on one select path
subckt nand2h (a b y vdd vss)
  mp1 (y a vdd vdd) pch_lvt_mac w=0.2u l=30n nf=1
  mp2 (y b vdd vdd) pch_lvt_mac w=0.2u l=30n nf=1
  mn1 (y a m1 vss) nch_lvt_mac w=0.2u l=30n nf=1
  mn2 (m1 b vss vss) nch_lvt_mac w=0.2u l=30n nf=1
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_2INPUT;
//   {#mp1 #mp2} @GROUP;
//   {#mn1 #mn2} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(8,8) => @ORIENT("R0");
//   #mn2 @PLACE(0,-6) => @ORIENT("R0");
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(12,13) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {(0,13) (2,13) (8,13) (10,13) %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:s (0,13)};
//   %j1=(2,13); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp1:b (2,8) (2,13)};
//   %j2=(8,13); $JUNCTION @ATTACH %j2;
//   &vdd @WIRE(mode="straight") {#mp2:s (8,13)};
//   %j3=(10,13); $JUNCTION @ATTACH %j3;
//   &vdd @WIRE(mode="straight") {#mp2:b (10,8) (10,13)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(14,4) => @ORIENT("MY");
//   %j4=(0,4); $JUNCTION @ATTACH %j4;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) %p2:p};
//   %j5=(8,4); $JUNCTION @ATTACH %j5;
//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-10) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn2:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-10) %p3:p};
//   %j6=(3,-6); $JUNCTION @ATTACH %j6;
//   &vss @WIRE(mode="straight") {#mn2:b (3,-6)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %j7=(-6,0); $JUNCTION @ATTACH %j7;
//   &a @WIRE(mode="straight") {%p4:p %j7 #mn1:g};
//   &a @WIRE(mode="straight") {%j7 (-6,8) #mp1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,-6) => @ORIENT("R0");
//   %j8=(-8,-6); $JUNCTION @ATTACH %j8;
//   &b @WIRE(mode="straight") {%p5:p %j8 #mn2:g};
//   &b @WIRE(mode="straight") {%j8 (-8,11) (3,11) (3,8) #mp2:g};
//   (-14,17) @TEXT("nand2h", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (16,10) @TEXT("mp1  pch_lvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,8.6) @TEXT("mp2  pch_lvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,7.2) @TEXT("mn1  nch_lvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (16,5.8) @TEXT("mn2  nch_lvt  0.2u/30n  nf=1", size=0.75, textcolor="#334155", bold=false, halign="start");
// }
ends nand2h

subckt nand3 (a b c y vdd vss)
  mp1 (y a vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mp2 (y b vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mp3 (y c vdd vdd) pch_lvt_mac w=0.4u l=30n nf=2
  mn1 (y a m1 vss) nch_lvt_mac w=0.6u l=30n nf=2
  mn2 (m1 b m2 vss) nch_lvt_mac w=0.6u l=30n nf=2
  mn3 (m2 c vss vss) nch_lvt_mac w=0.6u l=30n nf=2
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET; &vss @ADD-TO $GROUND_NET_SET;
//   # @SET-SYMBOL $NAND_3INPUT;
//   {#mp1 #mp2 #mp3} @GROUP;
//   {#mn1 #mn2 #mn3} @GROUP;
//   {#mp1 #mn1 #mp2 #mn2 #mp3 #mn3} @TEXT("", key="model");
//   #mp1 @PLACE(0,8) => @ORIENT("R0");
//   #mn1 @PLACE(0,0) => @ORIENT("R0");
//   #mp2 @PLACE(8,8) => @ORIENT("R0");
//   #mn2 @PLACE(0,-6) => @ORIENT("R0");
//   #mp3 @PLACE(16,8) => @ORIENT("R0");
//   #mn3 @PLACE(0,-12) => @ORIENT("R0");
//   %p1=$SUPPLY @ATTACH &vdd => @PLACE(20,13) => @ORIENT("R0");
//   &vdd @WIRE(mode="straight") {(0,13) (2,13) (8,13) (10,13) (16,13) (18,13) %p1:p};
//   &vdd @WIRE(mode="straight") {#mp1:s (0,13)};
//   %j1=(2,13); $JUNCTION @ATTACH %j1;
//   &vdd @WIRE(mode="straight") {#mp1:b (2,8) (2,13)};
//   %j2=(8,13); $JUNCTION @ATTACH %j2;
//   &vdd @WIRE(mode="straight") {#mp2:s (8,13)};
//   %j3=(10,13); $JUNCTION @ATTACH %j3;
//   &vdd @WIRE(mode="straight") {#mp2:b (10,8) (10,13)};
//   %j4=(16,13); $JUNCTION @ATTACH %j4;
//   &vdd @WIRE(mode="straight") {#mp3:s (16,13)};
//   %j5=(18,13); $JUNCTION @ATTACH %j5;
//   &vdd @WIRE(mode="straight") {#mp3:b (18,8) (18,13)};
//   %p2=$IO_PORT @ATTACH &y => @PLACE(22,4) => @ORIENT("MY");
//   %j6=(0,4); $JUNCTION @ATTACH %j6;
//   &y @WIRE(mode="straight") {#mp1:d (0,4) #mn1:d};
//   &y @WIRE(mode="straight") {(0,4) (8,4) (16,4) %p2:p};
//   %j7=(8,4); $JUNCTION @ATTACH %j7;
//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   %j8=(16,4); $JUNCTION @ATTACH %j8;
//   &y @WIRE(mode="straight") {#mp3:d (16,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   &m2 @WIRE(mode="straight") {#mn2:s #mn3:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-16) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn3:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-12) (3,-16) %p3:p};
//   %j9=(3,-6); $JUNCTION @ATTACH %j9;
//   &vss @WIRE(mode="straight") {#mn2:b (3,-6)};
//   %j10=(3,-12); $JUNCTION @ATTACH %j10;
//   &vss @WIRE(mode="straight") {#mn3:b (3,-12)};
//   %p4=$IO_PORT @ATTACH &a => @PLACE(-14,0) => @ORIENT("R0");
//   %j11=(-6,0); $JUNCTION @ATTACH %j11;
//   &a @WIRE(mode="straight") {%p4:p %j11 #mn1:g};
//   &a @WIRE(mode="straight") {%j11 (-6,8) #mp1:g};
//   %p5=$IO_PORT @ATTACH &b => @PLACE(-14,-6) => @ORIENT("R0");
//   %j12=(-8,-6); $JUNCTION @ATTACH %j12;
//   &b @WIRE(mode="straight") {%p5:p %j12 #mn2:g};
//   &b @WIRE(mode="straight") {%j12 (-8,11) (3,11) (3,8) #mp2:g};
//   %p6=$IO_PORT @ATTACH &c => @PLACE(-14,-12) => @ORIENT("R0");
//   %j13=(-10,-12); $JUNCTION @ATTACH %j13;
//   &c @WIRE(mode="straight") {%p6:p %j13 #mn3:g};
//   &c @WIRE(mode="straight") {%j13 (-10,12) (11,12) (11,8) #mp3:g};
//   (-14,17) @TEXT("nand3", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (24,10) @TEXT("mp1  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (24,8.6) @TEXT("mp2  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (24,7.2) @TEXT("mp3  pch_lvt  0.4u/30n  nf=2", size=0.75, textcolor="#334155", bold=false, halign="start");
