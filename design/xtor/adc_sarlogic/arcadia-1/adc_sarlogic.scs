//   &b @WIRE(mode="straight") {%j12 (-8,11) (3,11) (3,8) #mp2:g};
//   %p6=$IO_PORT @ATTACH &c => @PLACE(-14,-12) => @ORIENT("R0");
//   %j13=(-10,-12); $JUNCTION @ATTACH %j13;
//   &c @WIRE(mode="straight") {%p6:p %j13 #mn3:g};
//   &c @WIRE(mode="straight") {%j13 (-10,12) (11,12) (11,8) #mp3:g};
//   (-14,17) @TEXT("nand3x4", size=1.0, textcolor="#334155", bold=true, halign="start");
//   (24,10) @TEXT("mp1  pch_lvt  2.4u/30n  nf=12", size=0.75, textcolor="#334155", bold=false, halign="start");
//   (24,8.6) @TEXT("mp2  pch_lvt  2.4u/30n  nf=12", size=0.75, textcolor="#334155", bold=false, halign="start");
