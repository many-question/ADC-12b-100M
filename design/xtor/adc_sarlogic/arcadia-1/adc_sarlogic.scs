// CLKC set gate: the nand3x stack made one device taller
subckt nand4x (a b c d y vdd vss)
  mp1 (y a vdd vdd) pch_lvt_mac w=0.8u l=30n nf=4
  mp2 (y b vdd vdd) pch_lvt_mac w=0.8u l=30n nf=4
  mp3 (y c vdd vdd) pch_lvt_mac w=0.8u l=30n nf=4
  mp4 (y d vdd vdd) pch_lvt_mac w=0.8u l=30n nf=4
  mn1 (y a m1 vss) nch_lvt_mac w=3.2u l=30n nf=16
  mn2 (m1 b m2 vss) nch_lvt_mac w=3.2u l=30n nf=16
  mn3 (m2 c m3 vss) nch_lvt_mac w=3.2u l=30n nf=16
  mn4 (m3 d vss vss) nch_lvt_mac w=3.2u l=30n nf=16
