//   &y @WIRE(mode="straight") {#mp2:d (8,4)};
//   %j8=(16,4); $JUNCTION @ATTACH %j8;
//   &y @WIRE(mode="straight") {#mp3:d (16,4)};
//   &m1 @WIRE(mode="straight") {#mn1:s #mn2:d};
//   &m2 @WIRE(mode="straight") {#mn2:s #mn3:d};
//   %p3=$GROUND @ATTACH &vss => @PLACE(0,-16) => @ORIENT("R0");
//   &vss @WIRE(mode="straight") {#mn3:s %p3:p};
//   &vss @WIRE(mode="straight") {#mn1:b (3,0) (3,-6) (3,-12) (3,-16) %p3:p};
//   %j9=(3,-6); $JUNCTION @ATTACH %j9;
