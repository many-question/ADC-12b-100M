// adc_comp: conventional single-stage StrongARM latch with RTZ output inverters
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../rnl/adc28.rnl")
// }
simulator lang=spectre

subckt adc_comp (INP INN CLKC OUTP OUTN AVDD VSS)
// CLKC=0: P,N,X,Y precharge high; OUTP=OUTN=0.
// CLKC=1: input-pair integration followed by cross-coupled regeneration.
// INP>INN discharges P then X first, so the inverter asserts OUTP.
// Each symbol represents parallel single-finger devices; unit W <= 1 um.
// Integer multiplicity sets total width; no estimated layout-effect parameters.
// Pre-layout exploratory sizing; device callbacks and mismatch remain to be validated.
MIP (P INP TAIL VSS) nch_ulvt_mac w=1u l=30n nf=1 m=8
MIN (N INN TAIL VSS) nch_ulvt_mac w=1u l=30n nf=1 m=8
MTAIL (TAIL CLKC VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=12
MLNP (X Y P VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3
MLNN (Y X N VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3
MLPP (X Y AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3
MLPN (Y X AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3
MRP (P CLKC AVDD AVDD) pch_ulvt_mac w=0.75u l=30n nf=1 m=2
MRN (N CLKC AVDD AVDD) pch_ulvt_mac w=0.75u l=30n nf=1 m=2
MRX (X CLKC AVDD AVDD) pch_ulvt_mac w=0.75u l=30n nf=1 m=2
MRY (Y CLKC AVDD AVDD) pch_ulvt_mac w=0.75u l=30n nf=1 m=2
MOPN (OUTP X VSS VSS) nch_ulvt_mac w=0.75u l=30n nf=1 m=2
MOPP (OUTP X AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3
MONN (OUTN Y VSS VSS) nch_ulvt_mac w=0.75u l=30n nf=1 m=2
MONP (OUTN Y AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3
