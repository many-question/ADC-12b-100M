// adc_comp: Miyahara self-timed two-stage comparator core (calibration omitted)
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../rnl/adc28.rnl")
// }
simulator lang=spectre

subckt adc_comp (INP INN CLKC OUTP OUTN AVDD VSS)
// Reset: CLKC=0; P=N=AVDD resets UP, UN and both outputs via NMOS.
// Evaluate: INP>INN lowers P first; PMOS M2P then raises UP and OUTP.
// Falling P/N self-time the second stage: PMOS input devices and NMOS resets share P/N.
// Logical MOS devices are parallel single-finger units (nf=1, integer m).
// Based on M1-M15 of Miyahara et al., A-SSCC 2008, Fig. 2(b), DOI 10.1109/ASSCC.2008.4708780.
MIP (P INP T1 VSS) nch_ulvt_mac w=1u l=30n nf=1 m=40 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MIN (N INN T1 VSS) nch_ulvt_mac w=1u l=30n nf=1 m=40 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MT1 (T1 CLKC VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MRP (P CLKC AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=6 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MRN (N CLKC AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=6 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
M2P (UP P AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
M2N (UN N AVDD AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MLPP (OUTP OUTN UP AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MLPN (OUTN OUTP UN AVDD) pch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.165806 nrs=0.165806 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MLNP (OUTP OUTN VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=2 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MLNN (OUTN OUTP VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=2 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MRUP (UP P VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MRUN (UN N VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MROP (OUTP P VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
MRON (OUTN N VSS VSS) nch_ulvt_mac w=1u l=30n nf=1 m=3 ad=7.5e-14 as=7.5e-14 pd=2.15e-06 ps=2.15e-06 nrd=0.289519 nrs=0.289519 sa=7.5e-08 sb=7.5e-08 sd=1e-07
CINTP (P VSS) cfmom_2t nr=24 lr=1u w=50n s=50n stm=1 spm=3 multi=2
CINTN (N VSS) cfmom_2t nr=24 lr=1u w=50n s=50n stm=1 spm=3 multi=2
