//   &DU @WIRE {%jdu (78, -2) #MDUP:s};
//   &DN @WIRE {#MDMID:s #MDLO:d};
//   &VIN @WIRE {%p_in:p (32, -62) #MTRK:s};
//   &PHI_B @WIRE {%p_clk:p %jclk #MCP:g};
//   &PHI_B @WIRE {%jclk (-92, -8) (-76, -8) #MNCL:d};
//   &PHI_BB @WIRE {%p_clkb:p %jbbin #MNFB:d};
//   &PHI_BB @WIRE {%jbbin (-84, -26) #MPFB:d};
//   &PHI_BBF @WIRE {#MNFB:s %jbbout %jbb2 #MPFB:s};
//   &PHI_BBF @WIRE {%jbb2 %jbbr (54, -42) (54, -28) #MDLO:g};
//   &PHI_BBF @WIRE {%jbbr (-10, -18) #MRST:g};
//   &AVDD @WIRE {%js5 %js4 %js6 %js1 %js2 %js0 %js3};
//   &AVDD @WIRE {%js0 %vdd:p}; &AVDD @WIRE {%js0 #MPRE:s};
//   &AVDD @WIRE {%js1 #MCP:s};
//   &AVDD @WIRE {%js2 (-40, 20) #MCP:b};
//   &AVDD @WIRE {%js2 (-40, 4) #MPCAS:b};
//   &AVDD @WIRE {%js4 (-88, -18) #MNCL:g};
//   &AVDD @WIRE {%js5 (-112, -32) #MNFB:g};
//   &AVDD @WIRE {%js6 (-78, -32) #MPFB:b};
