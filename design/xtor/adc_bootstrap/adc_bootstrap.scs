// adc_bootstrap: protected startup control and shaped reset edge.
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../rnl/adc28.rnl")
// }
simulator lang=spectre

subckt adc_bootstrap (VIN PHI_B PHI_BB VG AVDD VSS)
// Precharge the MOM capacitor bank, then reference it to the input during tracking.
MPRE (CBP VG AVDD CBP) pch_ulvt_mac w=8u l=30n nf=4
CB (CBP CBN) cfmom_2t w=50n s=50n nr=200 lr=40u stm=1 spm=6
MRST (CBN PHI_BBF VSS VSS) nch_ulvt_mac w=24u l=30n nf=12
MTRK (CBN VG VIN VSS) nch_ulvt_mac w=48u l=30n nf=24
MXFER (VG GCTL CBP CBP) pch_ulvt_mac w=4u l=30n nf=2
// The cascode isolates MCP from GCTL undershoot; MNCL drives the startup gate.
MCP (PCP PHI_B AVDD AVDD) pch_ulvt_mac w=2u l=30n nf=1
MCSTART (GCTL PHI_N CBN VSS) nch_ulvt_mac w=500n l=30n nf=1
MCF (GCTL VG CBN VSS) nch_ulvt_mac w=8u l=30n nf=4
MDHI (VG AVDD DU VSS) nch_ulvt_mac w=24u l=30n nf=12
MDUP (VG VG DU VSS) nch_ulvt_mac w=24u l=30n nf=12
MDMID (DU AVDD DN VSS) nch_ulvt_mac w=24u l=30n nf=12
MDLO (DN PHI_BBF VSS VSS) nch_ulvt_mac w=24u l=30n nf=12

// Shape the reset edge while retaining the external PHI_BB phase relationship.
MNFB (PHI_BB AVDD PHI_BBF VSS) nch_ulvt_mac w=2u l=100n nf=1
MPFB (PHI_BB VSS PHI_BBF AVDD) pch_ulvt_mac w=4u l=100n nf=2
MPCAS (GCTL VSS PCP AVDD) pch_ulvt_mac w=2u l=30n nf=1
MNCL (PHI_B AVDD PHI_N VSS) nch_ulvt_mac w=8u l=30n nf=4
CB2 (CBP CBN) cfmom_2t w=50n s=50n nr=200 lr=40u stm=1 spm=6
// @RNL {
//   &AVDD @ADD-TO $SUPPLY_NET_SET; &VSS @ADD-TO $GROUND_NET_SET;
//   {#MPRE #CB #CB2 #MRST} @GROUP;
//   {#MCP #MPCAS #MCSTART} @AS $BRANCH;
//   {#MCP #MPCAS #MCSTART #MCF #MNCL} @GROUP;
//   {#MNFB #MPFB} @GROUP; {#MXFER #MTRK} @GROUP;
//   {#MDHI #MDMID #MDLO} @AS $BRANCH;
//   {#MDHI #MDUP #MDMID #MDLO} @GROUP;
//   #MPRE @PLACE(0, 20) => @ORIENT("R0");
//   #CB @PLACE(0, 4) => @ORIENT("R0");
//   #CB2 @PLACE(12, 4) => @ORIENT("R0");
//   #MRST @PLACE(0, -18) => @ORIENT("R0");
//   #MXFER @PLACE(32, 20) => @ORIENT("R0");
//   #MTRK @PLACE(32, -4) => @ORIENT("R0");
//   #MCP @PLACE(-48, 20) => @ORIENT("R0");
//   #MPCAS @PLACE(-48, 4) => @ORIENT("R0");
//   #MCSTART @PLACE(-48, -18) => @ORIENT("R0");
//   #MCF @PLACE(-30, -18) => @ORIENT("R0");
//   #MNCL @PLACE(-76, -18) => @ORIENT("R0");
//   #MNFB @PLACE(-100, -32) => @ORIENT("R0");
//   #MPFB @PLACE(-84, -32) => @ORIENT("MX");
//   #MDHI @PLACE(60, 4) => @ORIENT("R0");
//   #MDUP @PLACE(78, 4) => @ORIENT("R0");
//   #MDMID @PLACE(60, -12) => @ORIENT("R0");
//   #MDLO @PLACE(60, -28) => @ORIENT("R0");
//   %p_in = $IO_PORT @ATTACH &VIN => @PLACE(-120, -62) => @ORIENT("R0");
//   %p_clk = $IO_PORT @ATTACH &PHI_B => @PLACE(-120, 20) => @ORIENT("R0");
//   %p_clkb = $IO_PORT @ATTACH &PHI_BB => @PLACE(-120, -26) => @ORIENT("R0");
//   %p_out = $IO_PORT @ATTACH &VG => @PLACE(100, 18) => @ORIENT("MY");
//   %vdd = $SUPPLY @ATTACH &AVDD => @PLACE(0, 54) => @ORIENT("R0");
//   %gnd = $GROUND @ATTACH &VSS => @PLACE(36, -56) => @ORIENT("R0");
//   %jcp = (0, 12); %jcp2 = (12, 12); %jcph = (32, 26);
//   %jcn = (0, -2); %jcn2 = (12, -2); %jcnl = (-30, -26);
//   %jctl = (-48, -8); %jvg = (44, 18); %jvgf = (-18, 20);
//   %jdu = (60, -2); %javcas = (50, 4); %jclk = (-92, 20);
//   %jbbin = (-100, -26); %jbbout = (-100, -42); %jbb2 = (-84, -42); %jbbr = (-10, -42);
//   %js0 = (0, 48); %js1 = (-48, 48); %js2 = (-40, 48); %js3 = (50, 48);
//   %js4 = (-88, 48); %js5 = (-112, 48); %js6 = (-78, 48);
//   %jg0 = (0, -50); %jg1 = (4, -50); %jg2 = (-44, -50); %jg3 = (-26, -50);
//   %jg4 = (36, -50); %jg5 = (60, -50); %jg6 = (64, -50); %jg7 = (70, -50);
//   %jg8 = (86, -50); %jg9 = (66, -50); %jg10 = (-60, -50);
//   %jg11 = (-72, -50); %jg12 = (-96, -50); %jg13 = (-90, -50);
//   {$JUNCTION} @ATTACH {%jcp %jcp2 %jcph %jcn %jcn2 %jcnl %jctl %jvg %jvgf %jdu %javcas %jclk %jbbin %jbbout %jbb2 %jbbr %js0 %js1 %js2 %js3 %js4 %js5 %js6 %jg0 %jg1 %jg2 %jg3 %jg4 %jg5 %jg6 %jg7 %jg8 %jg9 %jg10 %jg11 %jg12 %jg13};
//   &CBP @WIRE {#MPRE:d %jcp #CB:p};
//   &CBP @WIRE {#MPRE:b (4, 20) (4, 12) %jcp};
//   &CBP @WIRE {%jcp %jcp2 #CB2:p};
//   &CBP @WIRE {%jcp2 (18, 12) (18, 26) %jcph #MXFER:s};
//   &CBP @WIRE {%jcph (36, 26) (36, 20) #MXFER:b};
//   &CBN @WIRE {#CB:n %jcn #MRST:d};
//   &CBN @WIRE {%jcn %jcn2 #CB2:n};
//   &CBN @WIRE {%jcn2 (32, -2) #MTRK:d};
//   &CBN @WIRE {%jcn (-8, -2) (-8, -26) %jcnl (-48, -26) #MCSTART:s};
//   &CBN @WIRE {%jcnl #MCF:s};
//   &PCP @WIRE {#MCP:d #MPCAS:s};
//   &GCTL @WIRE {#MPCAS:d %jctl #MCSTART:d};
//   &GCTL @WIRE {%jctl (-30, -8) #MCF:d};
//   &GCTL @WIRE {%jctl (-56, -8) (-56, 32) (24, 32) (24, 20) #MXFER:g};
//   &PHI_N @WIRE {#MNCL:s (-76, -26) (-66, -26) (-66, -18) #MCSTART:g};
//   &VG @WIRE {#MXFER:d %jvg (60, 18) %p_out:p};
//   &VG @WIRE {%jvg (44, 38) (-18, 38) %jvgf #MPRE:g};
//   &VG @WIRE {%jvgf (-18, -4) (-38, -4) (-38, -18) #MCF:g};
//   &VG @WIRE {%jvg (44, 10) (22, 10) (22, -4) #MTRK:g};
//   &VG @WIRE {%jvg (60, 18) #MDHI:d};
//   &VG @WIRE {#MDUP:d (78, 18) %jvg};
//   &VG @WIRE {#MDUP:g (72, 4) (72, 16) (78, 16) #MDUP:d};
