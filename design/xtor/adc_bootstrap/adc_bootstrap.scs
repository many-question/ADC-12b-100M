//   &VSS @WIRE {#MDMID:b (66, -12) %jg9};
//   (-120, 64) @TEXT("adc_bootstrap: control protection and reset edge shaping", halign="start") => @SET-STYLE $title_style;
//   (-120, 61) @TEXT("MPCAS isolates the pull-up control; MNCL limits the startup gate; PHI_BBF shapes reset and discharge", halign="start") => @SET-STYLE $note_style;
//   (-120, 57) @TEXT("CB: w=50n s=50n nr=200 lr=40u stm=1 spm=6", halign="start") => @SET-STYLE $param_style;
//   (-120, 55) @TEXT("CB2: w=50n s=50n nr=200 lr=40u stm=1 spm=6", halign="start") => @SET-STYLE $param_style;
//   (-56, 36) @TEXT("Protected control", halign="start") => @SET-STYLE $note_style;
//   (-112, -10) @TEXT("Reset edge shaping", halign="start") => @SET-STYLE $note_style;
//   (48, 30) @TEXT("Gate output / turn-off", halign="start") => @SET-STYLE $note_style;
