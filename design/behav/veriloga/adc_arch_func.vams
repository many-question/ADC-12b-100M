// generated by `python -m adcflow gen` from specs/ -- do not edit
// `include inside a module body (after `include "adc_arch.vams").
analog function real capw;   // weight of cap j (LSB)
  input j; integer j;
  begin
    case (j)
      12: capw = `ADC_W12;
      11: capw = `ADC_W11;
      10: capw = `ADC_W10;
      9: capw = `ADC_W9;
      8: capw = `ADC_W8;
      7: capw = `ADC_W7;
      6: capw = `ADC_W6;
      5: capw = `ADC_W5;
      4: capw = `ADC_W4;
      3: capw = `ADC_W3;
      2: capw = `ADC_W2;
      1: capw = `ADC_W1;
      0: capw = `ADC_W0;
      default: capw = 0;
    endcase
  end
endfunction

analog function real tdacx;  // extra DAC wait (s, TT) after the DAC step of decision k + 1
  input k; integer k;
  begin
    case (k)
      0: tdacx = `ADC_TDX0;
      1: tdacx = `ADC_TDX1;
      2: tdacx = `ADC_TDX2;
      3: tdacx = `ADC_TDX3;
      4: tdacx = `ADC_TDX4;
      5: tdacx = `ADC_TDX5;
      6: tdacx = `ADC_TDX6;
      7: tdacx = `ADC_TDX7;
      8: tdacx = `ADC_TDX8;
      9: tdacx = `ADC_TDX9;
      10: tdacx = `ADC_TDX10;
      11: tdacx = `ADC_TDX11;
      12: tdacx = `ADC_TDX12;
      default: tdacx = 0;
    endcase
  end
endfunction

analog function integer caps;  // 1 = cap j samples the input
  input j; integer j;
  begin
    case (j)
      12: caps = `ADC_S12;
      11: caps = `ADC_S11;
      10: caps = `ADC_S10;
      9: caps = `ADC_S9;
      8: caps = `ADC_S8;
      7: caps = `ADC_S7;
      6: caps = `ADC_S6;
      5: caps = `ADC_S5;
      4: caps = `ADC_S4;
      3: caps = `ADC_S3;
      2: caps = `ADC_S2;
      1: caps = `ADC_S1;
      0: caps = `ADC_S0;
      default: caps = 0;
    endcase
  end
endfunction

analog function real outw;   // output weight of D<i>
  input i; integer i;
  begin
    case (i)
      13: outw = 1960;
      12: outw = 1120;
      11: outw = 636;
      10: outw = 360;
      9: outw = 204;
      8: outw = 114;
      7: outw = 64;
      6: outw = 36;
      5: outw = 20;
      4: outw = 12;
      3: outw = 6;
      2: outw = 4;
      1: outw = 2;
      0: outw = 1;
      default: outw = 0;
    endcase
  end
endfunction
