// tb_comp_noise: input-referred noise and offset from P(OUTP) vs vd
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters cload=10f nfmax=50G
parameters tstop=8.705e-07
XDUT (INP INN CLKC OUTP OUTN AVDD 0) adc_comp
VDP (INP 0) vsource type=pwl wave=[0.0000e+00 0.4896 5.1190e-08 0.4896 5.1200e-08 0.48965 1.0239e-07 0.48965 1.0240e-07 0.4897 1.5359e-07 0.4897 1.5360e-07 0.48975 2.0479e-07 0.48975 2.0480e-07 0.4898 2.5599e-07 0.4898 2.5600e-07 0.48985 3.0719e-07 0.48985 3.0720e-07 0.4899 3.5839e-07 0.4899 3.5840e-07 0.48995 4.0959e-07 0.48995 4.0960e-07 0.49 4.6079e-07 0.49 4.6080e-07 0.49005 5.1199e-07 0.49005 5.1200e-07 0.4901 5.6319e-07 0.4901 5.6320e-07 0.49015 6.1439e-07 0.49015 6.1440e-07 0.4902 6.6559e-07 0.4902 6.6560e-07 0.49025 7.1679e-07 0.49025 7.1680e-07 0.4903 7.6799e-07 0.4903 7.6800e-07 0.49035 8.1919e-07 0.49035 8.1920e-07 0.4904]
VDN (INN 0) vsource type=pwl wave=[0.0000e+00 0.4904 5.1190e-08 0.4904 5.1200e-08 0.49035 1.0239e-07 0.49035 1.0240e-07 0.4903 1.5359e-07 0.4903 1.5360e-07 0.49025 2.0479e-07 0.49025 2.0480e-07 0.4902 2.5599e-07 0.4902 2.5600e-07 0.49015 3.0719e-07 0.49015 3.0720e-07 0.4901 3.5839e-07 0.4901 3.5840e-07 0.49005 4.0959e-07 0.49005 4.0960e-07 0.49 4.6079e-07 0.49 4.6080e-07 0.48995 5.1199e-07 0.48995 5.1200e-07 0.4899 5.6319e-07 0.4899 5.6320e-07 0.48985 6.1439e-07 0.48985 6.1440e-07 0.4898 6.6559e-07 0.4898 6.6560e-07 0.48975 7.1679e-07 0.48975 7.1680e-07 0.4897 7.6799e-07 0.4897 7.6800e-07 0.48965 8.1919e-07 0.48965 8.1920e-07 0.4896]
VCK (CLKC 0) vsource type=pulse val0=0 val1=vdd period=4e-10 delay=100p width=1.9e-10 rise=10p fall=10p
COP (OUTP 0) capacitor c=cload
CON (OUTN 0) capacitor c=cload
// decision of every cycle, sampled when CLKC falls
ISMP (OUTP OUTN CLKC 0) tb_sampler_va vth=vdd/2 dir=-1 delay=0 fname="decisions.txt"
VAVDD (AVDD 0) vsource dc=vdd
tran1 tran stop=tstop noisefmax=nfmax*noise_en*devnoise noiseseed=1 outputstart=tstop
tbopts options save=none
