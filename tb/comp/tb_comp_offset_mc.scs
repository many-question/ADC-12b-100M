//   %g4 = $GROUND @ATTACH &0 => @PLACE(0, -18.5);
//   &0 @WIRE {#COP:2 %g4:p};
//   #CON:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   %g5 = $GROUND @ATTACH &0 => @PLACE(8, -18.5);
//   &0 @WIRE {#CON:2 %g5:p};
//   #VAVDD:1 @TEXT("${net}", key="netname", size=0.6, halign="start", valign="middle", rotate=90, dx=0, dy=0.4);
//   %g6 = $GROUND @ATTACH &0 => @PLACE(0, 13.5);
//   &0 @WIRE {#VAVDD:2 %g6:p};
//   (-30, 31) @TEXT("tb_comp_offset_mc: input offset under device mismatch (Monte Carlo)", halign="start") => @SET-STYLE $title_style;
//   (-30, 29.4) @TEXT("one montecarlo analysis: mc_runs samples (50, seed 6303, mismatch only, no nominal run), transient noise off", halign="start") => @SET-STYLE $note_style;
//   (-30, 27.8) @TEXT("each sample: vd = +/-25 mV must give OUTP / OUTN, 13 halvings (6.1 uV), then offset +/- 50 uV re-checked", halign="start") => @SET-STYLE $note_style;
//   (-30, 26.2) @TEXT("XVOS: stand-in offset of the behavioral comparator (0 V with a transistor-level view)", halign="start") => @SET-STYLE $note_style
// }
