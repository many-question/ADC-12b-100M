// tb_ref_startup: VREFP / VCM over the supported power-up sequence
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters ccdac=1.2p ctot=2.50p
parameters tstop=2.0000e-05
XDUT (VREF_IN VREFP VCM AVDD18 AVDD 0) adc_ref
// VREF_IN held at 0 V while the supplies rise, then a 10 us ramp
VREF (VREF_IN 0) vsource type=pwl wave=[0 0 2.0000e-06 0 1.2000e-05 vref_in]
// AVDD18 and AVDD ramp together (AVDD not later than AVDD18) in 1 us
VH (AVDD18 0) vsource type=pwl wave=[0 0 1.0000e-07 0 1.1000e-06 vdd18]
VA (AVDD 0) vsource type=pwl wave=[0 0 1.0000e-07 0 1.1000e-06 vdd]
// CDAC bottom plates seen from VREFP (both sides)
CDB (VREFP 0) capacitor c=ccdac
// the two top plates on VCM (C_tot each)
CVP (VCM 0) capacitor c=ctot
CVN (VCM 0) capacitor c=ctot
tran1 tran stop=tstop maxstep=1n
save VREFP VCM VREF_IN AVDD AVDD18
