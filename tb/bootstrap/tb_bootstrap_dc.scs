// tb_bootstrap_dc: boosted gate over the input range, edges, current
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="adc28", version="0.1", path="../../design/rnl/adc28.rnl")
// }
// generated by `python -m adcflow gen` from specs/ -- do not edit (tools/adcflow/gen_tb.py)
// Globals vdd, vdd18, tempc, noise_en, devnoise, beh_speed, vref_in come from the run deck.
simulator lang=spectre
parameters tper=10n rsrc=50 wsw=96u nfsw=48 cs=2.0570p
parameters tstop=29*tper
XDUT (VIN PHI_BX PHI_BBX VG AVDD 0) adc_bootstrap
VSRC (SRC 0) vsource type=pwl wave=[0.0000e+00 0 4.0300e-08 0 4.0500e-08 0.15 8.0300e-08 0.15 8.0500e-08 0.3 1.2030e-07 0.3 1.2050e-07 0.45 1.6030e-07 0.45 1.6050e-07 0.6 2.0030e-07 0.6 2.0050e-07 0.75 2.4030e-07 0.75 2.4050e-07 0.9]
// charge into the DUT input net PHI_BX (input capacitance)
QMPB (PHI_B PHI_BX QPB 0) tb_qmeter_va
// charge into the DUT input net PHI_BBX (input capacitance)
QMPBB (PHI_BB PHI_BBX QPBB 0) tb_qmeter_va
RS (SRC VIN) resistor r=rsrc
// VG - VIN at the sampling instants
ISMP (VG VIN PHI_S 0) tb_sampler_va dir=-1 delay=0 fname="vgs.txt"
// reference input switch of one CDAC side
MSWP (BP VG VIN 0) nch_ulvt_mac w=wsw l=30n nf=nfsw
CSP (BP TOPR) capacitor c=cs
STOPP (TOPR VCM PHI_S 0) relay vt1=0.35 vt2=0.55 ropen=1e12 rclosed=20
CVGP (VG 0) capacitor c=10f
VCLK (CLK 0) vsource type=pulse val0=0 val1=vdd period=tper width=tper/2-20p rise=20p fall=20p
// ideal sampling phases
ICG (CLK PHI_S PHI_SB PHI_B PHI_BB CONV VDDA 0) adc_clkgen_va
VDDA (VDDA 0) vsource dc=vdd
VVCM (VCM 0) vsource dc=vref_in/2
VAVDD (AVDD_S 0) vsource dc=vdd
IMAVDD (AVDD_S AVDD) tb_imeter_va tstart=tper tstop=tstop label="AVDD" fname="power.txt"
tran1 tran stop=tstop
save VG VIN PHI_B PHI_BB BP QPB QPBB
